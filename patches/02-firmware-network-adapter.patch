-    uint8_t *data = (uint8_t *)malloc(len);
-    data[0] = 0x04;
-    memcpy(&data[1], hci_ev, len - 1);
-    ble_hci_trans_buf_free(hci_ev);
-    vhci_host_cb.notify_host_recv(data, len);
-    free(data);
-    return 0;
-}
