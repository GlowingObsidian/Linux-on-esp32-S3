-    data[0] = 0x02;
-    os_mbuf_copydata(om, 0, len - 1, &data[1]);
-    vhci_host_cb.notify_host_recv(data, len);
-    free(data);
-    os_mbuf_free_chain(om);
-    return 0;
-}
