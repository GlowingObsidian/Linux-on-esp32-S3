+++ b/esp_hosted_ng/esp/esp_driver/network_adapter/main/CMakeLists.txt
@@ -1,21 +1,24 @@
-set(COMPONENT_SRCS "app_main.c" "slave_bt.c" "cmd.c" "stats.c" "linux_boot.c" "linux_ipc.c" "linux_flash.c")
+set(COMPONENT_SRCS "app_main.c" "cmd.c" "linux_boot.c" "ble_prov.c")
 set(COMPONENT_ADD_INCLUDEDIRS "./include")
 
 if(CONFIG_IDF_TARGET_ESP32S3)
     list(APPEND COMPONENT_SRCS linux_ll_esp32s3.c)
 endif()
 
-if(CONFIG_JFFS2_READER)
-    list(APPEND COMPONENT_SRCS tiny_jffs2_reader.c)
-endif()
-
-if(CONFIG_ESP_SDIO_HOST_INTERFACE)
-    list(APPEND COMPONENT_SRCS sdio_slave_api.c)
-elseif(CONFIG_ESP_SPI_HOST_INTERFACE)
-    list(APPEND COMPONENT_SRCS spi_slave_api.c)
-elseif(CONFIG_ESP_SHMEM_HOST_INTERFACE)
-    list(APPEND COMPONENT_SRCS shmem_slave_api.c)
-endif()
+# No transport, and no jffs2 reader.
+#
+# Every one of these is an esp-hosted data path: sdio_slave_api.c,
+# spi_slave_api.c and shmem_slave_api.c each carry packets between this
+# chip and a separate host processor, and tiny_jffs2_reader.c reads
+# /etc/cmdline out of the etc partition for the kernel command line.
+#
+# This port has no separate host -- Linux is on this chip -- so there is
+# nothing on the other end of any of them. They also depend on
+# linux_ipc.c, which is gone with the rest of the IPC.
+#
+# The kernel command line now comes from the device tree's bootargs, and
+# /etc is part of the read-only rootfs, so the jffs2 reader has nothing
+# to read either.
 
 
 register_component()

