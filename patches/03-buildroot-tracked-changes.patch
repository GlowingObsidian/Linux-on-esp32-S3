diff --git a/board/espressif/esp32s3/rootfs_overlay/home/README.txt b/board/espressif/esp32s3/rootfs_overlay/home/README.txt
new file mode 100644
index 0000000000..2701fe7385
--- /dev/null
+++ b/board/espressif/esp32s3/rootfs_overlay/home/README.txt
@@ -0,0 +1,10 @@
+/home is on the read-only rootfs. There is no separate home partition and
+nothing is mounted over this directory, so files written here do not survive
+a reboot -- and on a cramfs they cannot be written at all.
+
+That is deliberate. A writable /home needs a flash-write path, and this port
+gives the whole flash to Linux read-only so that core 0 can be handed to the
+kernel instead of staying behind to serve writes.
+
+Put anything that must persist in the rootfs image, or in /tmp for the
+length of a boot.
diff --git a/board/espressif/esp32s3/rootfs_overlay/root/README.txt b/board/espressif/esp32s3/rootfs_overlay/root/README.txt
new file mode 100644
index 0000000000..c1ec921a14
--- /dev/null
+++ b/board/espressif/esp32s3/rootfs_overlay/root/README.txt
@@ -0,0 +1,20 @@
+This directory is READ-ONLY and not usable.
+
+/ is a cramfs image in flash, mounted read-only, so nothing can be written
+here -- not even by root. Files placed here would not survive anyway: they
+are baked into the firmware image at build time.
+
+The valid writable home directory is:
+
+    /home/root
+
+/home is a separate jffs2 partition and persists across reboots.
+
+Other writable paths:
+
+    /home   jffs2   persists across reboots
+    /etc    jffs2   persists across reboots (configuration only)
+    /tmp    tmpfs   RAM, cleared on every boot
+    /run    tmpfs   RAM, cleared on every boot
+
+Everything else (/, /root, /usr, /bin, /var/lib) is read-only.
diff --git a/board/espressif/esp32s3/setup-home.sh b/board/espressif/esp32s3/setup-home.sh
new file mode 100755
index 0000000000..9a01b69374
--- /dev/null
+++ b/board/espressif/esp32s3/setup-home.sh
@@ -0,0 +1,22 @@
+#! /bin/sh
+#
+# Point root at /home/root instead of /root. Done here rather than in the
+# overlay because buildroot regenerates /etc/passwd after the overlay is
+# applied (it stamps the root password hash in), so an overlay copy would be
+# overwritten.
+#
+
+set -e
+
+# S05home used to be chmod'd here. It is gone: /home is part of the
+# read-only rootfs now, so there is no separate filesystem to mount and
+# nothing for that script to check.
+chmod 0755 "$1/usr/bin/wifi"
+
+sed -i 's|^root:\([^:]*\):0:0:\([^:]*\):/root:|root:\1:0:0:\2:/home/root:|' \
+	"$1/etc/passwd"
+
+grep -q '^root:[^:]*:0:0:[^:]*:/home/root:' "$1/etc/passwd" || {
+	echo "setup-home.sh: failed to repoint root's home in /etc/passwd" >&2
+	exit 1
+}
diff --git a/linux/linux.mk b/linux/linux.mk
index 16d9f194..abbef47b 100644
--- a/linux/linux.mk
+++ b/linux/linux.mk
@@ -86,6 +86,21 @@ LINUX_DEPENDENCIES += \
 	$(if $(BR2_PACKAGE_FIRMWARE_IMX),firmware-imx) \
 	$(if $(BR2_PACKAGE_WIRELESS_REGDB),wireless-regdb)
 
+# ...and the kernel looks for them in $(LINUX_DIR)/$(CONFIG_EXTRA_FIRMWARE_DIR),
+# which nothing populates: wireless-regdb installs into the target directory.
+# The dependency above guarantees it has run, so copy the two files across
+# before the kernel build reads them. This board sets CONFIG_EXTRA_FIRMWARE
+# to regulatory.db because cfg80211 asks for it long before / is mounted.
+ifeq ($(BR2_PACKAGE_WIRELESS_REGDB),y)
+define LINUX_INSTALL_REGULATORY_DB
+	$(INSTALL) -m 644 -D -T $(TARGET_DIR)/lib/firmware/regulatory.db \
+		$(LINUX_DIR)/firmware/regulatory.db
+	$(INSTALL) -m 644 -D -T $(TARGET_DIR)/lib/firmware/regulatory.db.p7s \
+		$(LINUX_DIR)/firmware/regulatory.db.p7s
+endef
+LINUX_PRE_BUILD_HOOKS += LINUX_INSTALL_REGULATORY_DB
+endif
+
 # Starting with 4.16, the generated kconfig paser code is no longer
 # shipped with the kernel sources, so we need flex and bison, but
 # only if the host does not have them.
diff --git a/package/libcurl/libcurl.mk b/package/libcurl/libcurl.mk
index 3661cbf5bd..014f5143d8 100644
--- a/package/libcurl/libcurl.mk
+++ b/package/libcurl/libcurl.mk
@@ -84,7 +84,12 @@ LIBCURL_CONF_OPTS += --without-gnutls
 endif
 
 ifeq ($(BR2_PACKAGE_LIBCURL_MBEDTLS),y)
-LIBCURL_CONF_OPTS += --with-mbedtls=$(STAGING_DIR)/usr
+# The CA bundle lives on the read-only cramfs, NOT under /etc: on this board
+# /etc is a jffs2 partition mounted over the cramfs, so anything baked into
+# /etc/ssl is hidden at runtime. board/.../ca-bundle.sh builds this file from
+# the ca-certificates package.
+LIBCURL_CONF_OPTS += --with-mbedtls=$(STAGING_DIR)/usr \
+	--with-ca-bundle=/usr/share/ca-certificates/ca-bundle.crt
 LIBCURL_DEPENDENCIES += mbedtls
 else
 LIBCURL_CONF_OPTS += --without-mbedtls
diff --git a/board/espressif/esp32s3/post-build.sh b/board/espressif/esp32s3/post-build.sh
--- a/board/espressif/esp32s3/post-build.sh
+++ b/board/espressif/esp32s3/post-build.sh
@@ -1,3 +1,21 @@
 #! /bin/sh
 
-mv "$1/rootfs.jffs2" "$1/etc.jffs2"
+# The jffs2 image is no longer renamed to etc.jffs2.
+#
+# It used to become the /etc partition: a small writable filesystem holding
+# accounts, network configuration and the dropbear host keys, separate from
+# the read-only cramfs root. This port has no use for it. Wi-Fi is parked,
+# so wpa_supplicant.conf is moot; nothing on the board changes accounts; and
+# a writable /etc is the one thing that forces core 0 to stay alive serving
+# flash writes over the IPC, which is incompatible with giving core 0 to
+# Linux.
+#
+# /etc and /home are both in the cramfs already -- buildroot's target rootfs
+# contains them, and mkfs-etc.sh used to carve /etc back out into its own
+# image. With the jffs2 image left alone it is simply an unused artifact, and
+# etc.jffs2 is never produced.
+#
+# Leaving the rename out rather than deleting the file: buildroot invokes
+# every script in BR2_ROOTFS_POST_BUILD_SCRIPT, and a missing one is an
+# error.
+:
diff --git a/board/espressif/esp32s3/mkfs-etc.sh b/board/espressif/esp32s3/mkfs-etc.sh
--- a/board/espressif/esp32s3/mkfs-etc.sh
+++ b/board/espressif/esp32s3/mkfs-etc.sh
@@ -1,7 +1,15 @@
 #! /bin/sh
 
-echo "$1" | grep -q 'jffs2/target$' || exit 0
-echo 'Trimming jffs2 image to the contents of /etc'
-find "$1" -mindepth 1 -maxdepth 1 -not -name 'etc' -print0 | xargs -0 rm -rf
-mv "$1/etc/"* "$1"
-rm -rf "$1/etc"
+# This used to strip the jffs2 target down to just /etc, so the resulting
+# image could be written to the etc partition. There is no etc partition any
+# more -- /etc comes from the read-only cramfs -- so the trim is gone.
+#
+# It is left as a no-op rather than deleted because buildroot runs every
+# script named in BR2_ROOTFS_POST_BUILD_SCRIPT and fails on a missing one.
+# The jffs2 rootfs is still built (BR2_TARGET_ROOTFS_JFFS2 is still set) and
+# is simply not used by anything.
+#
+# If the jffs2 image is ever wanted again, note that the original also
+# depended on $1 ending in jffs2/target, which is how it avoided running
+# against the cramfs target.
+:
