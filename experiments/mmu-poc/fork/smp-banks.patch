+#if defined(CONFIG_XTENSA_NOMMU_FORK) && defined(CONFIG_SMP)
+/* Read the task field, not task->mm: affinity callers do not hold an mm ref. */
+const struct cpumask *xtensa_nommu_task_cpus(struct task_struct *task)
+{
+	unsigned int bank_cpu = READ_ONCE(task->thread.nommu_bank_cpu);
+
+	return bank_cpu ? cpumask_of(bank_cpu - 1) : cpu_possible_mask;
+}
+
+void xtensa_nommu_exec(void)
+{
+	/* exec installed an independent mm. Release the old family's constraint
+	 * and recover the user's affinity through the scheduler's compatibility API.
+	 */
+	if (current->thread.nommu_bank_cpu) {
+		WRITE_ONCE(current->thread.nommu_bank_cpu, 0);
+		relax_compatible_cpus_allowed_ptr(current);
+	}
+}
