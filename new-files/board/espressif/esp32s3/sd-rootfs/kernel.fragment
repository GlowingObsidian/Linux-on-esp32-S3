CONFIG_BUILTIN_DTB_NAME="arduino-nano-esp32-sd"
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=y
CONFIG_EXT2_FS=y
# CONFIG_EXT2_FS_XATTR is not set
# CONFIG_EXT2_FS_POSIX_ACL is not set
# CONFIG_EXT2_FS_SECURITY is not set
# CONFIG_ESP32_GDMA is not set
# CONFIG_ESP32_REGS is not set
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_FB is not set
# CONFIG_FB_TFT is not set
# CONFIG_FONTS is not set
# CONFIG_LOGO is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_VT_CONSOLE is not set
# CONFIG_LOGO_LINUX_CLUT224 is not set
# CONFIG_FB_DEVICE is not set
# CONFIG_FB_TFT_ST7789V is not set
# CONFIG_PWRSEQ_EMMC is not set
# CONFIG_PWRSEQ_SIMPLE is not set

# Reclaim clean duplicate text cache on the 8 MiB full-SD NOMMU profile.
CONFIG_NOMMU_EXEC_DROP_FILE_CACHE=y
