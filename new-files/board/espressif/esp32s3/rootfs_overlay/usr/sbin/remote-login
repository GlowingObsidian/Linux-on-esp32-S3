#!/bin/sh
set -e

if [ "$(id -u)" != 0 ]; then
	echo "remote-login: must be run as root" >&2
	exit 1
fi

ETC=${REMOTE_LOGIN_ETC:-/etc}
CONF=$ETC/inetd.conf
CHOICE=$ETC/remote-login
SETTINGS=$ETC/remote-login.conf
DROPBEAR=${REMOTE_LOGIN_DROPBEAR:-/usr/sbin/dropbear}
KEYS=${REMOTE_LOGIN_HOME:-/home/root}/.ssh/authorized_keys

SSH_PORT=22
SSH_AUTH=both

usage() {
	echo "usage: remote-login ssh|off" >&2
	echo "       remote-login port ssh N|default" >&2
	echo "       remote-login auth password|both|key" >&2
	echo "       remote-login apply|status" >&2
	exit 1
}

restart_inetd() {
	killall -HUP inetd 2>/dev/null || /etc/init.d/S45inetd start
}

valid_port() {
	case $1 in
	''|*[!0-9]*|0*) return 1 ;;
	esac
	[ "$1" -le 65535 ]
}

setting() {
	sed -n "s/^$1=//p" "$SETTINGS" 2>/dev/null | tail -n 1
}

load() {
	[ -r "$SETTINGS" ] || return 0
	value=$(setting SSH_PORT)
	if valid_port "$value"; then SSH_PORT=$value; fi
	value=$(setting SSH_AUTH)
	case $value in
	password|both|key) SSH_AUTH=$value ;;
	esac
}

store() {
	printf 'SSH_PORT=%s\nSSH_AUTH=%s\n' \
		"$SSH_PORT" "$SSH_AUTH" > "$SETTINGS.new"
	mv "$SETTINGS.new" "$SETTINGS"
}

enabled() {
	[ -r "$CHOICE" ] || return 1
	for word in $(cat "$CHOICE"); do
		[ "$word" = "$1" ] && return 0
	done
	return 1
}

ssh_flags() {
	case $SSH_AUTH in
	password) echo ' -n' ;;
	key) echo ' -s' ;;
	esac
}

auth_text() {
	case $SSH_AUTH in
	password) echo 'password only' ;;
	key) echo 'keys only' ;;
	*) echo 'password or key' ;;
	esac
}

apply() {
	ssh_on='#'
	enabled ssh && ssh_on=
	tmp=$CONF.new
	# The filter drops three names, not one. /usr/sbin/httpd because this image
	# builds no web server, and /usr/sbin/telnetd because it no longer builds
	# one either: /etc lives in jffs2 and survives a flash, so a board updated
	# from an older image still has the line that image wrote, and inetd would
	# fork a name that no longer exists. Dropping them here means the first
	# `remote-login` after an update clears them; nothing else needs to know
	# they were ever there.
	awk '{ l = $0; sub(/^#/, "", l); split(l, f, /[ \t]+/)
	       if (f[6] != "/usr/sbin/dropbear" && f[6] != "/usr/sbin/telnetd" &&
	           f[6] != "/usr/sbin/httpd") print }' \
		"$CONF" > "$tmp" 2>/dev/null || : > "$tmp"
	printf '%s%s\tstream\ttcp\tnowait\troot\t/usr/sbin/dropbear\tdropbear -i -R -I 600%s\n' \
		"$ssh_on" "$SSH_PORT" "$(ssh_flags)" >> "$tmp"
	mv "$tmp" "$CONF"
	restart_inetd
}

choose() {
	echo "$1" > "$CHOICE"
	apply
}

load

case "$1" in
ssh)
	if [ ! -x "$DROPBEAR" ]; then
		echo "remote-login: this image has no SSH server" >&2
		exit 1
	fi
	choose ssh
	echo "SSH on port $SSH_PORT ($(auth_text))."
	;;
off|none)
	choose off
	echo "SSH off. Log in on the console."
	;;
port)
	[ $# -eq 3 ] || usage
	value=$3
	if [ "$value" = default ]; then
		value=22
	fi
	if ! valid_port "$value"; then
		echo "remote-login: '$3' is not a port (1-65535)" >&2
		exit 1
	fi
	case $2 in
	ssh) SSH_PORT=$value ;;
	*) usage ;;
	esac
	store
	apply
	echo "SSH port is $SSH_PORT."
	;;
auth)
	[ $# -eq 2 ] || usage
	case $2 in
	password|both|key) SSH_AUTH=$2 ;;
	*) usage ;;
	esac
	store
	apply
	echo "SSH logins: $(auth_text)."
	if [ "$SSH_AUTH" = key ] && [ ! -s "$KEYS" ]; then
		echo "No $KEYS yet: SSH turns everyone away until a key is there. The console still works." >&2
	fi
	;;
apply)
	apply
	echo "Applied $SETTINGS."
	;;
status|"")
	on=
	enabled ssh && on="$on ssh"
	echo "Listening:${on:- nothing}"
	echo "SSH: port $SSH_PORT, $(auth_text)$(enabled ssh || echo ', off')"
	;;
*)
	usage
	;;
esac
