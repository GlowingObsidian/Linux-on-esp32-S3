#!/bin/sh

IFACE=wlan0
CONF=/etc/wpa_supplicant.conf
WPALOG=/run/wpa_supplicant.log
CONNECT_WAIT=${CONNECT_WAIT:-20}
STATE=${WIFI_STATE:-/etc/default/wifi}
BOOT=${WIFI_BOOT:-/usr/sbin/wifi-boot}
TAB=$(printf '\t')
NL=$(printf '\nx'); NL=${NL%x}

save_power() {
	local tmp
	grep -qx "WIFI_RADIO_ENABLE=$1" "$STATE" 2>/dev/null && return 0
	tmp=$(mktemp "$STATE.new.XXXXXX") || return 1
	if [ -f "$STATE" ]; then
		cp -p "$STATE" "$tmp" || { rm -f "$tmp"; return 1; }
		awk '!/^[[:space:]]*WIFI_RADIO_ENABLE=/' "$STATE" > "$tmp" || {
			rm -f "$tmp"; return 1;
		}
	fi
	printf 'WIFI_RADIO_ENABLE=%s\n' "$1" >> "$tmp" || { rm -f "$tmp"; return 1; }
	mv "$tmp" "$STATE" || { rm -f "$tmp"; return 1; }
	sync
}

enable_radio() {
	save_power 1 || return 1
	[ ! -d "/sys/class/net/$IFACE" ] || return 0
	"$BOOT"
}

saved_network() {
	[ -r "$CONF" ] && grep -Eq '^[[:space:]]*network[[:space:]]*=[[:space:]]*\{' "$CONF"
}

resume_or_select() {
	enable_radio || return 1
	if iw dev "$IFACE" link 2>/dev/null | grep -q 'Connected to'; then
		status
	elif saved_network; then
		apply_conf 'saved network'
	else
		interactive
	fi
}

disable_radio() {
	# Persist before bringing down the SSH transport carrying this command.
	save_power 0 || return 1
	link_down
	ip link set "$IFACE" down 2>/dev/null || true
	echo 'Wi-Fi off; stays off across boots until wifi on or wifi.'
}

wrong_key() {
	grep -q 'reason=WRONG_KEY' "$WPALOG" 2>/dev/null
}

raw_scan() {
	if wrong_key && ! iw dev "$IFACE" link 2>/dev/null | grep -q "Connected to"; then
		link_down
	fi
	ip link set "$IFACE" up 2>/dev/null

	# No wpa_cli branch here: the image is built without it, and without a
	# control socket for it to talk to, so trying it first only costs two
	# failed exec attempts per scan on a board where that is expensive.
	# not a variable: a full scan overflows ash's stack, no guard page on nommu
	out=$(mktemp /run/wifi-raw.XXXXXX) || return 1
	tries=0
	until iw dev "$IFACE" scan > "$out" 2>/dev/null; do
		tries=$((tries + 1))
		[ "$tries" -ge 3 ] && break
		sleep 2
	done
	awk '
		function flush() {
			if (ssid != "") print sig "\t" sec "\t" ssid
			ssid = ""; sec = "OPEN"; sig = "-100"
		}
		/^BSS / { flush() }
		/signal:/ { sig = $2 + 0 }
		/^\tSSID: / { s = $0; sub(/^\tSSID: /, "", s); ssid = s }
		/RSN:|WPA:/ { sec = "SEC" }
		END { flush() }' "$out"
	rm -f "$out"
}

scan_list() {
	raw_scan | sort -t"$TAB" -k1,1 -rn | awk -F"$TAB" '!seen[$3]++'
}

# A quote, a backslash or a newline in one of these values would end the
# quoted string and let the rest be read as wpa_supplicant directives. The
# values arrive from whoever is at the console or an SSH session, and an SSID
# is chosen by whoever runs the network rather than by this board, so neither
# is trusted to be well formed: this check is the boundary between them and
# the file.
reject_unsafe() {
	case $1 in
	*\"*|*\\*)
		echo "wifi: $2 cannot contain a quote or a backslash." >&2
		return 1 ;;
	esac
	case $1 in
	*"$NL"*)
		echo "wifi: $2 cannot contain a newline." >&2
		return 1 ;;
	esac
	[ -n "$1" ] || { echo "wifi: $2 cannot be empty." >&2; return 1; }
	return 0
}

# umask 077 across the redirect so the file is never world readable. Not a
# ( subshell ): busybox ash cannot finish a heredoc that ends inside
# parentheses. umask is a builtin, so it is put back by hand.
write_conf() {
	local old
	old=$(umask)
	umask 077
	cat > "$CONF"
	umask "$old"
}

write_conf_open() {
	reject_unsafe "$1" "the SSID" || return 1
	write_conf <<EOF
network={
	ssid="$1"
	key_mgmt=NONE
}
EOF
}

write_conf_psk() {
	reject_unsafe "$1" "the SSID" || return 1
	reject_unsafe "$2" "the password" || return 1
	write_conf <<EOF
network={
	ssid="$1"
	psk="$2"
	key_mgmt=WPA-PSK
	proto=WPA2
	pairwise=CCMP
	group=CCMP
}
EOF
}

# ifdown first or udhcpc breeds like rabbits
link_down() {
	ifdown "$IFACE" 2>/dev/null
	killall -q wpa_supplicant 2>/dev/null
	killall -q udhcpc 2>/dev/null
}

current_ip() {
	ip -4 addr show "$IFACE" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p'
}

apply_conf() {
	echo "Connecting to '$1'..."
	link_down
	ifup "$IFACE" >/dev/null 2>&1
	n=0
	while [ "$n" -lt "$CONNECT_WAIT" ]; do
		if wrong_key; then
			link_down
			echo "Wrong password for '$1'. Run wifi to try again." >&2
			return 2
		fi
		addr=$(current_ip)
		if [ -n "$addr" ]; then
			echo "Connected, IP address $addr"
			return 0
		fi
		sleep 1
		n=$((n + 1))
	done
	echo "Not connected yet, still trying in the background. Check with: wifi status"
	return 3
}

connect() {
	SSID="$1"
	if [ -z "$SSID" ]; then
		echo "usage: wifi connect \"SSID\" [password]" >&2
		return 1
	fi
	if [ -n "$2" ]; then
		write_conf_psk "$SSID" "$2" || return 1
	else
		write_conf_open "$SSID" || return 1
	fi
	enable_radio || return 1
	apply_conf "$SSID"
}

interactive() {
	echo "Scanning for WiFi networks on $IFACE ..."
	TMP=$(mktemp /run/wifi-scan.XXXXXX) || {
		echo "wifi: cannot create a scratch file in /run" >&2
		return 1
	}
	scan_list > "$TMP"

	if [ ! -s "$TMP" ]; then
		echo "No networks found. Is the STA interface working? Try: ip link set $IFACE up"
		rm -f "$TMP"
		return 1
	fi

	echo
	echo "  #   SIGNAL  SECURITY  SSID"
	echo "  --  ------  --------  ----------------------------"
	i=0
	while IFS="$TAB" read -r sig sec ssid; do
		i=$((i + 1))
		if [ "$sec" = "OPEN" ]; then lock="open"; else lock="locked"; fi
		printf "  %2d  %5s   %-8s  %s\n" "$i" "$sig" "$lock" "$ssid"
	done < "$TMP"
	echo

	printf "Pick a network number (or Enter to cancel): "
	read -r choice
	if [ -z "$choice" ]; then
		echo "Cancelled."
		rm -f "$TMP"
		return 0
	fi

	case $choice in
	''|*[!0-9]*)
		echo "Invalid choice." >&2
		rm -f "$TMP"
		return 1 ;;
	esac
	line=$(sed -n "${choice}p" "$TMP" 2>/dev/null)
	rm -f "$TMP"
	if [ -z "$line" ]; then
		echo "Invalid choice." >&2
		return 1
	fi
	sec=$(printf '%s' "$line" | cut -f2)
	ssid=$(printf '%s' "$line" | cut -f3-)

	if [ "$sec" = "OPEN" ]; then
		echo "'$ssid' is an open network -- connecting directly."
		connect "$ssid"
	else
		printf "Password for '%s': " "$ssid"
		stty -echo 2>/dev/null
		read -r pass
		stty echo 2>/dev/null
		printf "\n"
		if [ -z "$pass" ]; then
			echo "No password entered -- aborting." >&2
			return 1
		fi
		connect "$ssid" "$pass"
	fi
}

status() {
	if iw dev "$IFACE" link 2>/dev/null | grep -q "Connected to"; then
		iw dev "$IFACE" link 2>/dev/null | grep -E "Connected to|SSID|signal"
	else
		echo "Not associated."
		wrong_key && echo "The last attempt failed: wrong password. Run wifi to try again."
	fi
	ip addr show "$IFACE" 2>/dev/null | grep -E "inet " || echo "No IP address."
}

usage() {
	cat <<'EOF'
usage: wifi [command]

  wifi                    scan and pick a network interactively
  wifi scan               list the networks in range
  wifi scan --tsv         the same list, tab separated, for scripts
  wifi connect "SSID"     join an open network
  wifi connect "SSID" PW  join a WPA2 network
  wifi status             show the association and the IP address
  wifi on                 enable Wi-Fi; join saved network or show the list
  wifi off                disconnect and remember off across boots
  wifi disconnect         same as wifi off

The chosen network is stored in /etc/wpa_supplicant.conf (mode 600) and is
joined automatically when Wi-Fi is enabled. With no saved network, wifi
shows the picker. Wi-Fi on/off state is remembered across boots.
Progress is logged to /var/log/network.log.
EOF
}

# Sourced with __define_only__ by build/test-wifi-script.py: functions, no dispatch.
[ "${1:-}" = __define_only__ ] && return 0 2>/dev/null

case "${1:-}" in
""|on)          resume_or_select ;;
scan|list)
	enable_radio || exit 1
	# --tsv is the machine-readable form: signal, OPEN or SEC, then the SSID,
	# separated by tabs. It exists so a caller that wants the list as data
	# does not have to re-parse the padded column layout below, where an SSID
	# with two spaces in it loses one.
	if [ "${2:-}" = --tsv ]; then
		scan_list
	else
		scan_list | awk -F"$TAB" '{printf "  %5s  %-6s  %s\n", $1, ($2=="OPEN"?"open":"lock"), $3}'
	fi
	;;
connect)        shift; connect "$@" ;;
status)         status ;;
disconnect|off) disable_radio ;;
-h|--help|help) usage ;;
*)              echo "usage: wifi [scan|connect \"SSID\" [pass]|status|disconnect]" >&2; exit 1 ;;
esac
