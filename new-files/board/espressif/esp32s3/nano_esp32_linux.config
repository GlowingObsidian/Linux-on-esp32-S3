CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# One core, 8 KiB kernel stacks, and a fork backend that copies up to
# 512 KiB in switch_mm: nothing here has a use for kernel preemption.
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_NONE=y
# VIRT_CPU_ACCOUNTING_GEN would select CONTEXT_TRACKING_USER_FORCE,
# which adds work to every syscall and exception return to exercise
# NO_HZ_FULL. This board is NO_HZ_IDLE, so it pays for nothing.
CONFIG_TICK_CPU_ACCOUNTING=y
# CONFIG_INITRAMFS_PRESERVE_MTIME is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
# CONFIG_FHANDLE is not set
# CONFIG_BASE_FULL is not set
# CONFIG_EPOLL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_MEMBARRIER is not set
# Resolve retained crash logs against the matching host-side vmlinux/System.map.
# Keep symbol names out of the flash image; measure the final image before
# changing partition boundaries.
# CONFIG_KALLSYMS is not set
# CONFIG_PERF_EVENTS is not set
CONFIG_XTENSA_VARIANT_CUSTOM=y
CONFIG_XTENSA_VARIANT_CUSTOM_NAME="esp32s3"
# CONFIG_XTENSA_VARIANT_MMU is not set
CONFIG_XTENSA_UNALIGNED_USER=y
CONFIG_USER_ABI_CALL0_ONLY=y
CONFIG_XTENSA_PLATFORM_ESP32=y
# SMP. XTENSA_SMP_ESP32 is this platform's own symbol: it selects HAVE_SMP
# without dragging in XTENSA_MX, which the S3 has no hardware for. The two
# cores have no MX interrupt distributor and no MX RunStall port, so
# irq-xtensa-mx.c would write registers that are not there and
# arch/xtensa/kernel/smp.c would read a core count out of a SYSCFGID that
# does not exist. See the comments in arch/xtensa/Kconfig.
#
# CONFIG_SMP is what turns the second core on. With it off the kernel is
# exactly as it was: one CPU, core 1 held by the firmware.
CONFIG_XTENSA_SMP_ESP32=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
# CPU1 starts through mask ROM and ets_set_appcpu_boot_addr(), not a Linux
# handler at the ROM reset vector. Keep exception handlers beside IRAM vectors.
# CONFIG_SECONDARY_RESET_VECTOR is not set
CONFIG_USE_OF=y
CONFIG_BUILTIN_DTB_NAME="arduino-nano-esp32"
CONFIG_MEMMAP_CACHEATTR=0xffff222f
CONFIG_KERNEL_LOAD_ADDRESS=0x42140000
CONFIG_XTENSA_VECTORS_SEPARATE=y
# Where core 0 leaves room for our vectors. The firmware's own linker picks
# the address, so it moves whenever the firmware's RAM use does -- most
# recently when the IPC, the transports and the flash server were removed and
# the firmware got smaller, which moved it down by 8 KiB. Read the current
# value off the firmware:
#
#   xtensa-esp32s3-elf-nm network_adapter.elf | grep space_for_vectors
#
# make-images.sh realigns the tree it is running in when they disagree, and
# package-final.py checks them again and refuses to package a mismatch. That
# realign does NOT persist: it rewrites the build's own snapshot and
# buildroot's .config, and the next run re-snapshots from this file. So when
# the firmware's layout changes, this line has to be updated by hand or every
# run repeats the realign and the fork kernel fails check-kernel-config
# against a seed that is one firmware revision behind.
CONFIG_VECTORS_ADDR=0x40379000
CONFIG_XIP_DATA_ADDR=0x3d800000
CONFIG_DEFAULT_MEM_START=0x3d800000
# CONFIG_SECCOMP is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_COREDUMP is not set
CONFIG_MMAP_ALLOW_UNINITIALIZED=y
# CONFIG_VM_EVENT_COUNTERS is not set
CONFIG_NET=y
CONFIG_PACKET=y
# CONFIG_PACKET_DIAG is not set
CONFIG_UNIX=y
# CONFIG_UNIX_DIAG is not set
CONFIG_INET=y
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_MULTIPLE_TABLES is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_DNS_RESOLVER is not set
CONFIG_CFG80211=y
# CONFIG_CFG80211_DEFAULT_PS is not set
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# CONFIG_RFKILL is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_STANDALONE is not set
# CONFIG_PREVENT_FIRMWARE_BUILD is not set
# cfg80211 asks for regulatory.db before the rootfs is mounted, so it is
# built in (XIP: flash, not RAM). The path is relative to the kernel build
# directory, which build-kernel.sh populates.
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
# Nothing here loads firmware from userspace.
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_ALLOW_DEV_COREDUMP is not set
CONFIG_MTD=y
# CONFIG_MTD_BLOCK is not set
CONFIG_MTD_ESP32=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_NETDEVICES=y
# CONFIG_NET_CORE is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_CISCO is not set
CONFIG_ESP32_WIFI=y
# CONFIG_ESP32_WIFI_BLOB is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# Input is on for the USB host port, not for the panel: a keyboard or a mouse
# plugged into the port is what this feeds. EVDEV is what creates /dev/input/
# eventN, so without it the device binds and there is no node to read.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# SERIO is the PC serial-IO bus -- i8042, PS/2, serial mice -- and it is not
# something this board has. It cannot be turned off here: it is `default y` and
# it depends on INPUT, so it was unreachable while INPUT was off and became
# reachable the moment INPUT went on for the USB host port, and olddefconfig
# re-applies that default over a "is not set" line in this seed. It is written
# down as enabled because that is what the build produces, and the config check
# compares the two: claiming it off fails the build. It costs a few KB of
# xipImage and does nothing at runtime, because nothing is on that bus.
CONFIG_SERIO=y
# --- display: an ST7789 panel, as a canvas and as a console ---
# /dev/fb0 stays a canvas any program can open and draw to. On top of that the
# panel now carries a console, so `echo`, `cat` and anything else that writes to
# a terminal also lands on the screen.
#
# VT is the virtual-terminal layer; FRAMEBUFFER_CONSOLE is fbcon, the driver
# that renders a VT onto a framebuffer. fbcon needs VT, and VT_CONSOLE is what
# lets a VT be the system console -- patch 0067 adds `console=tty1` to the
# cmdline so the kernel's own messages go there too. The serial console is not
# replaced: both `console=` arguments stay, and output goes to both.
#
# VT_HW_CONSOLE_BINDING is not written here because fbcon's Kconfig selects it
# (drivers/video/console/Kconfig:62) and nothing in this seed overrides that.
# The same goes for DUMMY_CONSOLE, FONT_SUPPORT and CRC32, which fbcon selects.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_CONSOLE_TRANSLATIONS is not set
# The console font. FONTS gates the whole font menu and nothing selects it, so
# without it the font named below is dropped silently and the build falls back
# to the 8x16 default. 6x11 gives 40x21 characters on a 240x240 panel.
#
# The font was 4x6, then 6x8 while the panel was still 128x160, and is now
# 6x11. 4x6 is the smallest pixel font in the tree and its glyphs are hard to
# read on the glass; 6x8 was picked for the 128-pixel panel, where 40 columns
# did not fit and the trade was rows for legibility. The 240x240 panel removes
# that constraint -- 6x11 keeps the full 40 columns 6x8 had and spends the
# spare height on taller glyphs, which is the whole reason for the change.
# The trade was measured, not guessed: every font in lib/fonts was rendered at
# the panel's real geometry first.
#
# 6x11 is the only font linked, so fbcon's own scoring is not what selects it:
# get_default_font() (lib/fonts/fonts.c:342) gives a +1000 bonus only to fonts
# at most 8 rows tall when yres < 400, which 240 is, so 6x8 would win on score
# alone. With 6x8 gone there is nothing to win against, and the cmdline names
# 6x11 explicitly anyway (patch 0067) in case a second font is ever linked.
#
# FONT_8x16 is turned off explicitly: it is `default y`, and while the font
# below disables FONT_AUTOSELECT (lib/fonts/Kconfig:149) that does not clear
# 8x16's own default, so both fonts would be linked in and only one used.
CONFIG_FONTS=y
CONFIG_FONT_6x11=y
# CONFIG_FONT_6x8 is not set
# CONFIG_FONT_8x16 is not set
# The boot logo: the Arduino mark, drawn by the kernel before fbcon takes the
# panel over. LOGO is the menu; LOGO_LINUX_CLUT224 is the one entry in it that
# this board uses, and the picture is not chosen here -- logo.c hardcodes
# `logo = &logo_linux_clut224` (drivers/video/logo/logo.c:63), so the file that
# name points at is what gets drawn. Patch 0068 replaces that file's contents
# with the mark, which is why no second symbol appears here.
#
# Nothing sets fb_logo_count, so it keeps its -1 and the logo is drawn once per
# online CPU (drivers/video/fbdev/core/fb_logo.c:501). This board reports one
# CPU, so one mark. The logo is not permanent: fbcon binds the panel about a
# second later and paints over it, which is the same behaviour Raspbian has.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# fbtft's own Kconfig selects FB_BACKLIGHT and FB_SYSMEM_HELPERS_DEFERRED, so
# they are not listed here -- writing them down would only add a seed line to
# keep true.
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# fbtft lives under drivers/staging, which is off by default.
CONFIG_STAGING=y
CONFIG_FB_TFT=y
# The 240x240 ST7789, not the 128x160 ST7735R the first panel was. The driver
# is the same shape -- fb_st7789v.c, also already in the pinned kernel -- and
# it registers "sitronix,st7789v" with .width = 240, .height = 320.
#
# 320 is the controller's own column count, not this panel's: the module is a
# 240x240 window onto it. fbtft takes width and height from the driver and
# only lets the devicetree override them, so the panel node carries
# width = <240> and height = <240> and this default is never used. The
# property names are bare -- fbtft_properties_read() reads them with
# device_property_read_u32(dev, "width", ...), with no vendor prefix. See
# patch 0063.
CONFIG_FB_TFT_ST7789V=y
# The old panel's driver, off. Nothing in the fbtft Kconfig makes the two
# exclusive, so leaving it on would link a second driver into xipImage and
# register a second `compatible` string that could bind the wrong panel.
# Written as an explicit "is not set" so the config check compares it rather
# than never looking: the checker only verifies symbols the seed names.
# CONFIG_FB_TFT_ST7735R is not set
CONFIG_SERIAL_ESP32=y
CONFIG_SERIAL_ESP32_ACM=y
CONFIG_HW_RANDOM_ESP32=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
CONFIG_SPI=y
CONFIG_SPI_ESP32=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
# CONFIG_GPIO_CDEV_V1 is not set
CONFIG_GPIO_ESP32=y
CONFIG_GPIO_GENERIC_PLATFORM=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_HWMON=y
CONFIG_SENSORS_ESP32S3_TSENS=y
# --- USB: the port is a host ---
# The controller is a Synopsys DWC2 core and the device tree says so twice --
# "esp,esp32s3-usb" then "snps,dwc2" -- so drivers/usb/dwc2 drives it. What
# the SoC adds is the PHY, and it has exactly one: the OTG controller shares
# it with the USB-Serial/JTAG block the ROM flashes the chip over, and the
# port comes up belonging to Serial/JTAG. Handing it over is what costs this
# image the ttyGS3 console; the device tree does the switching and the acm
# node is off to match.
#
# The mode choice is a single Kconfig choice, and host is the branch that
# applies when USB_GADGET is off. It is written down because the port being a
# host is a decision, not a default that happens to land right.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_ESP32S3_USB=y
# Input is on above; these are what turn a USB device into an input device.
# Without them the port enumerates and nothing binds to what it found, which
# looks like a dead port rather than a missing driver.
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set
CONFIG_COMMON_CLK_ESP32S3=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SIMPLE=y
# CONFIG_NVMEM is not set
# CONFIG_DNOTIFY is not set
# CONFIG_INOTIFY_USER is not set
# CONFIG_MMC is not set
# CONFIG_PWRSEQ_EMMC is not set
# CONFIG_PWRSEQ_SIMPLE is not set
# CONFIG_MMC_SPI is not set
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_COMPRESSION_OPTIONS=y
CONFIG_JFFS2_CMODE_NONE=y
CONFIG_CRAMFS=y
CONFIG_CRAMFS_MTD=y
# CONFIG_CRAMFS_BLOCKDEV is not set
# CONFIG_NFS_FS is not set

# --- USB storage: a FAT32 drive on the port that became a host ---
# The port is host mode above; this is what turns a mass-storage device on it
# into a mountable filesystem. The chain is strictly ordered and each link
# depends on the one before it, so a symbol that silently fails to take takes
# everything under it with it:
#
#   BLOCK -> SCSI -> USB_STORAGE -> (device) -> sd -> /dev/sda
#                        \-> BLK_DEV_SD
#   VFAT_FS -> FAT_FS -> NLS (codepage tables for the filenames)
#
# Every symbol here is named, including the ones that stay off, because
# check-kernel-config.py only verifies what this file mentions: a symbol left
# out is never checked, and a dependency that drops one of these would not be
# caught until the board failed to see the drive.
#
# What is deliberately not here: exFAT and NTFS (a stick formatted either way
# will not mount), MMC and mmc_spi (an SPI SD card would contend for the panel's
# bus and chip select, and the port already does this job), and auto-mounting --
# the board mounts what it is told to, by hand.
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# Defaults that would otherwise come along and are not wanted here: /dev/bsg is
# SG v4 and nothing on this board speaks it, /proc/scsi is the legacy interface
# sysfs replaced, and a second IO scheduler is a second scheduler for a single
# USB stick. MQ_IOSCHED_DEADLINE stays at its default -- it is the one that runs.
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_SCSI_PROC_FS is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_EFI_PARTITION is not set
CONFIG_INIT_STACK_NONE=y
CONFIG_PRINTK_TIME=y
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_MISC is not set
# esp32-regs is the narrow /dev/mem the DEVMEM line above refuses: one misc
# device, two windows (the peripheral block 0x60000000-0x6009FFFF and the
# system block 0x600C0000-0x600C0FFF), 32-bit access only. It exists so
# bringing up a peripheral that has no driver yet -- GDMA, in this case -- is
# a shell command rather than a kernel patch and a rebuild. It is a
# development tool: a wrong write hangs the board. Enabled by decision on
# 2026-11-01 while the GDMA bring-up is in progress; turn it back off before
# this image is treated as a release.
CONFIG_ESP32_REGS=y
# esp32-gdma drives the S3's general DMA engine memory-to-memory from the
# kernel, because the engine's descriptor list must live in internal SRAM and
# a userspace mmap of that window does not reach it on NOMMU (remap_pfn_range
# installs nothing without a page table). It also releases the engine from
# reset and enables its clock at probe. Enabled by decision on 2026-11-01 for
# the SPI DMA bring-up; it is the first half of that work and the SPI path
# will build on it rather than replace it.
CONFIG_ESP32_GDMA=y
CONFIG_FRAME_WARN=1024
CONFIG_MAGIC_SYSRQ=y
# CONFIG_DEBUG_FS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
CONFIG_STACKTRACE=y
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_LD_NO_RELAX is not set
# CONFIG_S32C1I_SELFTEST is not set
CONFIG_PRINT_USER_CODE_ON_UNHANDLED_EXCEPTION=y
# CONFIG_RUNTIME_TESTING_MENU is not set

# --- memory, on a board whose MemTotal reads 7852K ---
# Source port randomisation sized for a host with thousands of outbound
# connections: the boot log shows "Table-perturb hash table entries: 65536
# (order: 6, 262144 bytes, linear)". Order 8 floors at one page.
CONFIG_INET_TABLE_PERTURB_ORDER=8
# The allocator variant meant for systems under 16 MiB.
CONFIG_SLUB_TINY=y
# 128 KiB of printk ring for a board that logs to a 115200 console. The
# diagnostic profile puts this back to 17.
CONFIG_LOG_BUF_SHIFT=14
# Two 256-entry tty_driver tables for a machine whose only pty user is
# dropbear, which goes through /dev/ptmx.
# CONFIG_LEGACY_PTYS is not set

# --- hardening ---
# TIOCSTI is the terminal injection primitive; /dev/mem on NOMMU has no
# STRICT_DEVMEM to limit it and would also reach core 0's PSRAM. Nothing in
# the tree opens /dev/mem.
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_DEVMEM is not set
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_SUSPEND is not set
# CONFIG_INET_DIAG is not set
# CONFIG_ETHTOOL_NETLINK is not set
