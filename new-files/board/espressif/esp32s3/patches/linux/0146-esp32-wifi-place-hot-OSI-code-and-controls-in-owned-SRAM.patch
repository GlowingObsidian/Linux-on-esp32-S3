 struct osi_internal_header { size_t requested; size_t allocated; };
 #define OSI_INTERNAL_HEADER_SIZE 32
 
+/* Control objects use the unused tail of the same owned IRAM resource,
+ * through its data-bus alias. Keep their pool separate from radio DMA buffers.
+ * IDF's FreeRTOS heap uses INTERNAL|8BIT for queues and synchronization objects.
+ */
+static struct gen_pool *osi_control_pool;
+
+static bool osi_is_control(const void *p)
+{
+	return p && osi_control_pool &&
+		gen_pool_has_addr(osi_control_pool, (unsigned long)p, 1);
+}
+
+static void *osi_control_zalloc(size_t size)
+{
+	struct osi_internal_header *h;
+	size_t total;
+	unsigned long addr;
+
+	/* Non-IRAM profiles retain the original allocator. IRAM probe must
+	 * establish the owned pool before any vendor task can start. */
+	if (!osi_control_pool)
+		return kzalloc(size, GFP_KERNEL);
+	if (check_add_overflow(size ? size : 1,
+			       (size_t)OSI_INTERNAL_HEADER_SIZE, &total))
+		return NULL;
+	addr = gen_pool_alloc(osi_control_pool, total);
+	if (!addr)
+		return NULL;
+	h = (void *)addr;
+	h->requested = size;
+	h->allocated = total;
+	memset((void *)(addr + OSI_INTERNAL_HEADER_SIZE), 0, size);
+	return (void *)(addr + OSI_INTERNAL_HEADER_SIZE);
+}
+
+static void *osi_control_calloc(size_t n, size_t size)
+{
+	size_t bytes;
+
+	if (check_mul_overflow(n, size, &bytes))
+		return NULL;
+	return osi_control_zalloc(bytes);
+}
+
+static void osi_control_free(void *p)
+{
+	struct osi_internal_header *h;
+
+	if (!p)
+		return;
+	if (!osi_is_control(p)) {
+		kfree(p);
+		return;
+	}
+	h = p - OSI_INTERNAL_HEADER_SIZE;
+	gen_pool_free(osi_control_pool, (unsigned long)h, h->allocated);
+}
+
