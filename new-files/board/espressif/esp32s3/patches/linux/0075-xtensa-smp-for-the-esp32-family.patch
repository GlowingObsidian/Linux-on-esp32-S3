+
+/*
+ * The ESP32 family starts its second core through registers rather than
+ * through an MX RunStall port. This is the same sequence NuttX uses in
+ * up_cpu_start() and IDF uses in esp_cpu_unstall(): the core is held by two
+ * RTC stall bits and by RUNSTALL in SYSTEM_CORE_1_CONTROL_0, and it is
+ * released by clearing all three and pulsing the reset.
+ *
+ * Order matters. The RTC stall bits are cleared first so the core is not
+ * held by two mechanisms at once, then the clock gate is opened, then
+ * RUNSTALL is released, and only then is the reset pulsed -- a reset while
+ * RUNSTALL is still set leaves the core stalled at its reset vector.
+ *
+ * The two RTC stall fields are cleared without changing watchdog protection.
+ */
+
+static void esp32_cpu_unstall(void *p)
+{
+	unsigned cpu = (unsigned)p;
+	u32 v;
+
+	/*
+	 * The RTC stall bits come first, and they are written without
+	 * touching RTC_CNTL_WDTWPROTECT: that register guards the watchdog
+	 * block only, and the stall fields live in OPTIONS0 and SW_CPU_STALL,
+	 * outside it. NuttX does not unlock it here either. (The boot log
+	 * shows both fields already clear on this board, so these two writes
+	 * change nothing today -- they are here because NuttX has them and
+	 * because a board held by those bits instead of by RUNSTALL would
+	 * need them. Measured: RTC_CNTL_OPTIONS0_REG reads 0x1c008000, bits
+	 * 1:0 clear, and RTC_CNTL_SW_CPU_STALL_REG reads 0.)
+	 */
+	v = readl((void __iomem *)ESP32_RTC_SW_CPU_STALL);
+	v &= ~ESP32_RTC_SW_STALL_APPCPU_C1;
+	writel(v, (void __iomem *)ESP32_RTC_SW_CPU_STALL);
+
+	v = readl((void __iomem *)ESP32_RTC_OPTIONS0);
+	v &= ~ESP32_RTC_SW_STALL_APPCPU_C0;
+	writel(v, (void __iomem *)ESP32_RTC_OPTIONS0);
+
+	if (cpu != 1)
+		return;
+
+	/*
+	 * Only touch the clock gate and the reset when the gate is closed.
+	 *
+	 * This is NuttX's guard, and its reason is OpenOCD: a debugger can
+	 * have opened the gate and taken the core out of reset already, and
+	 * pulsing RESETING then would clear breakpoints the debugger had set.
+	 * On a cold boot the gate is closed -- measured on this board,
+	 * SYSTEM_CORE_1_CONTROL_0_REG reads 0x1 -- so the sequence runs.
+	 */
+	v = readl((void __iomem *)SYSTEM_CORE_1_CONTROL_0_REG);
