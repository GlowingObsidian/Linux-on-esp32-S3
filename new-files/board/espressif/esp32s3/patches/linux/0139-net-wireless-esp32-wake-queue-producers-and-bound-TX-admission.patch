+/* Eight software data slots leave room for control commands in the
+ * sixteen-slot transport queue. A stalled data packet waits at most 250ms;
+ * the complete data backlog therefore cannot consume the five-second host
+ * command deadline. The vendor's own static/cache pools remain unchanged.
+ */
+#define BLOB_TX_QUEUE_LIMIT 16
+#define BLOB_TX_DATA_LIMIT 8
+#define BLOB_TX_DATA_LOW 4
+
+/* Called only with tx_q.lock held: admission and retirement cannot lose a
+ * wakeup. Never wake a queue stopped by interface teardown or port closure.
+ */
+static void blob_tx_flow_locked(struct esp_wifi_blob *hw)
+{
+	struct esp_wifi_device *priv = hw->adapter.priv[ESP_STA_NW_IF];
+
+	if (!priv || !priv->ndev)
+		return;
+	if (hw->tx_data_pending >= BLOB_TX_DATA_LIMIT && !hw->tx_paused &&
+	    netif_running(priv->ndev) && !netif_queue_stopped(priv->ndev)) {
+		hw->tx_paused = true;
+		netif_stop_queue(priv->ndev);
+	} else if (hw->tx_paused && hw->tx_data_pending <= BLOB_TX_DATA_LOW) {
+		hw->tx_paused = false;
+		if (!hw->tx_stopping && netif_running(priv->ndev) &&
+		    READ_ONCE(priv->port_open) && !READ_ONCE(priv->stop_data))
+			netif_wake_queue(priv->ndev);
+	}
+}
+
+/* The pinned callback executes before esf_buf_recycle, as verified in
+ * ppProcTxDone. Treat it as a progress notification, NOT a reusable-buffer
+ * credit. Never retain/dereference the vendor's frame or length pointers.
+ * A short timed fallback covers the subsequent recycle and non-data frees.
+ */
+static void blob_tx_done(u8 ifidx, u8 *data, u16 *len, bool success)
+{
+	struct esp_wifi_blob *hw = READ_ONCE(g_blob);
+
+	if (ifidx != 0 || !hw)
+		return;
+	atomic_inc(&wifi_tx_done);
+	if (!success)
+		atomic_inc(&wifi_tx_done_failed);
+	wake_up(&hw->tx_wait);
+}
