From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: paulneja <207793167+paulneja@users.noreply.github.com>
Date: Sun, 26 Jul 2026 15:06:04 -0300
Subject: [PATCH 49/61] esp32s3 dts: cramfs root, panic=10, console on UART and USB

---
 arch/xtensa/boot/dts/esp32s3.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/xtensa/boot/dts/esp32s3.dtsi b/arch/xtensa/boot/dts/esp32s3.dtsi
index bf1f86e0a6bba..c2137602e3934 100644
--- a/arch/xtensa/boot/dts/esp32s3.dtsi
+++ b/arch/xtensa/boot/dts/esp32s3.dtsi
@@ -7,7 +7,7 @@ / {
 	interrupt-parent = <&pic>;
 
 	chosen {
-		bootargs = "earlycon=esp32s3uart,mmio32,0x60000000,115200n8,40000000 console=ttyS0,115200n8 debug rw root=mtd:rootfs no_hash_pointers ";
+		bootargs = "earlycon=esp32s3uart,mmio32,0x60000000,115200n8,40000000 console=ttyGS3 console=ttyS0,115200n8 rw root=mtd:rootfs rootfstype=cramfs panic=10 panic_print=0x20 ";
 	};
 
 	aliases {
-- 
2.55.0

