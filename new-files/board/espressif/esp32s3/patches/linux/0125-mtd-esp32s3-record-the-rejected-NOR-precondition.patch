diff --git a/drivers/mtd/devices/esp32s3-flash-nor-ll.c b/drivers/mtd/devices/esp32s3-flash-nor-ll.c
--- a/drivers/mtd/devices/esp32s3-flash-nor-ll.c
+++ b/drivers/mtd/devices/esp32s3-flash-nor-ll.c
@@ -16,6 +16,14 @@
 #define MISO (1U << 28)
 #define MOSI (1U << 27)
 #define CS_HOLD_SETUP ((1U << 6) | (1U << 7))
+/* Preserve the existing rejection checks while reporting the exact register.
+ * The task resides in SRAM; no diagnostic helper or log runs with caches off. */
+#define CHECK_REGISTER(reg, reject) do { \
+	t->preflight_register = (reg); \
+	t->preflight_value = rd(reg); \
+	if (reject) \
+		return; \
+} while (0)
 
 INLINE fn_u32 rd(fn_u32 address)
 {
@@ -162,14 +170,21 @@
 		return;
 	/* This port uses single-command STR flash, CS0, with octal PSRAM on
 	 * SPI0. Reject unsupported flash DDR/OPI instead of changing chip mode. */
-	if (rd(SPI1) || rd(SPI0) || (rd(SPI0 + 0x54) & 7) ||
-	    (rd(SPI1 + 0x54) & 7) || (rd(SPI0 + 0xe0) & 1) ||
-	    (rd(SPI0 + 0x08) & 0x270U) ||
-	    (rd(SPI1 + 0xa0) & 1) || (rd(SPI1 + 0x98) & 1) ||
-	    (rd(SPI1 + 0xa4) & 1) || !(rd(SPI1 + 0xe8) & 1) ||
-	    (rd(EXTMEM + 0x88) & 1) || (rd(EXTMEM + 0x28) & 7) ||
-	    ((rd(EXTMEM) >> 3) & 3) > 2)
-		return;
+	CHECK_REGISTER(SPI1, t->preflight_value);
+	CHECK_REGISTER(SPI0, t->preflight_value);
+	CHECK_REGISTER(SPI0 + 0x54, t->preflight_value & 7);
+	CHECK_REGISTER(SPI1 + 0x54, t->preflight_value & 7);
+	CHECK_REGISTER(SPI0 + 0xe0, t->preflight_value & 1);
+	CHECK_REGISTER(SPI0 + 0x08, t->preflight_value & 0x270U);
+	CHECK_REGISTER(SPI1 + 0xa0, t->preflight_value & 1);
+	CHECK_REGISTER(SPI1 + 0x98, t->preflight_value & 1);
+	CHECK_REGISTER(SPI1 + 0xa4, t->preflight_value & 1);
+	CHECK_REGISTER(SPI1 + 0xe8, !(t->preflight_value & 1));
+	CHECK_REGISTER(EXTMEM + 0x88, t->preflight_value & 1);
+	CHECK_REGISTER(EXTMEM + 0x28, t->preflight_value & 7);
+	CHECK_REGISTER(EXTMEM, ((t->preflight_value >> 3) & 3) > 2);
+	t->preflight_register = 0;
+	t->preflight_value = 0;
 	for (i = 0; i < 13; i++)
 		save[i] = rd(SPI1 + saved_offset(i));
 	/* SPI1 only. Leave SPI0 clock, PSRAM timing, pins and cache MMU alone. */
diff --git a/drivers/mtd/devices/esp32s3-flash-nor.h b/drivers/mtd/devices/esp32s3-flash-nor.h
--- a/drivers/mtd/devices/esp32s3-flash-nor.h
+++ b/drivers/mtd/devices/esp32s3-flash-nor.h
@@ -29,6 +29,8 @@
 	fn_u32 result, jedec, status_before, status_after;
 	fn_u32 commands, changed, cache_syncs, restored;
 	fn_u32 data[FN_FIFO_BYTES / 4];
+	/* First rejected hardware precondition, captured with both caches off. */
+	fn_u32 preflight_register, preflight_value;
 };
 
 #endif
diff --git a/drivers/mtd/devices/esp32s3-flash-nor-main.inc b/drivers/mtd/devices/esp32s3-flash-nor-main.inc
--- a/drivers/mtd/devices/esp32s3-flash-nor-main.inc
+++ b/drivers/mtd/devices/esp32s3-flash-nor-main.inc
@@ -220,12 +220,13 @@
 	struct fn_task __iomem *t = fg->nor + FN_TASK;
 	ssize_t ret;
 	mutex_lock(&fg->lock);
-	ret = sysfs_emit(buf, "jedec=%06x supported=%u scratch_passed=%u rw_enabled=%u flash_operations=%u operation=%u address=%08x length=%u result=%u commands=%u changed=%u cache_syncs=%u spi_restored=%u status_before=%02x status_after=%02x code_bytes=%u\n",
+	ret = sysfs_emit(buf, "jedec=%06x supported=%u scratch_passed=%u rw_enabled=%u flash_operations=%u operation=%u address=%08x length=%u result=%u commands=%u changed=%u cache_syncs=%u spi_restored=%u status_before=%02x status_after=%02x code_bytes=%u preflight_reg=%08x preflight_value=%08x\n",
 		fg->nor_jedec, fg->nor_id_ok, fg->nor_scratch_ok, fg->nor_rw,
 		fg->flash_operations, readl(&t->operation), readl(&t->address),
 		readl(&t->length), readl(&t->result), readl(&t->commands),
 		readl(&t->changed), readl(&t->cache_syncs), readl(&t->restored),
-		readl(&t->status_before), readl(&t->status_after), fg->nor_bytes);
+		readl(&t->status_before), readl(&t->status_after), fg->nor_bytes,
+		readl(&t->preflight_register), readl(&t->preflight_value));
 	mutex_unlock(&fg->lock);
 	return ret;
 }
