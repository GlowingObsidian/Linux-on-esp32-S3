+/* IDF wifi_static_queue_t ABI: libpp unwraps handle at offset zero.
+ * Ordinary _queue_create callers still receive the raw Linux queue.
+ */
+struct osi_wifi_queue {
+	void *handle;
+	void *storage;
+};
+
+static void *osi_wifi_create_queue(int queue_len, int item_size)
+{
+	struct osi_wifi_queue *queue;
+
+	if (queue_len <= 0 || item_size <= 0)
+		return NULL;
+	queue = kzalloc(sizeof(*queue), GFP_KERNEL);
+	if (!queue)
+		return NULL;
+	queue->handle = osi_queue_create_common(queue_len, item_size);
+	if (!queue->handle) {
+		kfree(queue);
+		return NULL;
+	}
+	return queue;
+}
+
+static void osi_wifi_delete_queue(void *opaque)
+{
+	struct osi_wifi_queue *queue = opaque;
+
+	if (!queue)
+		return;
+	osi_queue_delete(queue->handle);
+	kfree(queue);
 }
 
