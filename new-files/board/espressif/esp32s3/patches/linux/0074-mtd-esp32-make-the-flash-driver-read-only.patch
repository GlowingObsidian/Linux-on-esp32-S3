+/*
+ * No &ipc overlay. It used to hang the shared-memory Wi-Fi transport off
+ * the IPC node; both are gone. ESP32_WIFI_SHMEM is off (the blob port
+ * replaced it, see the wifi_blob node below) and the IPC itself was
+ * removed with the firmware that served it.
+ */
 
+/*
+ * Core 0's interrupt matrix, not core 1's.
+ *
+ * The S3 has two, at 0x600c2000 (core 0) and 0x600c2800 (core 1), and the
+ * ROM's intr_matrix_set picks between them on its cpu_no argument -- the
+ * first instruction pair in that function loads 0x600c2000 and only
+ * overwrites it with 0x600c2800 when cpu_no is non-zero.
+ *
+ * This used to name 0x600c2800 because Linux ran on core 1: the firmware
+ * kept core 0 for the radio, and every peripheral was routed to the core
+ * that would handle it. This port hands core 0 to Linux instead, so the
+ * matrix has to move with it. Left as it was, every routed peripheral --
+ * UART0, GPIO, SPI2, SPI3, USB -- is delivered to a core held in RUNSTALL,
+ * and nothing but the core's own internal timer interrupt arrives at all.
+ * That is enough to boot, because the timer bypasses the matrix and the
+ * console path is polled, and not enough to log in, because the tty needs
+ * the UART's RX and TX interrupts.
+ *
+ * The driver maps one matrix per reg entry (devm_of_iomap(node, cpu, ...)),
+ * so a second entry here is what SMP will add: <0x600c2000 0x800>,
+ * <0x600c2800 0x800>, and then each device names its core in the third
+ * cell of its interrupts property.
+ */
 &intc {
-	reg = <0x600c2800 0x800>;
+	reg = <0x600c2000 0x800>;
 };

