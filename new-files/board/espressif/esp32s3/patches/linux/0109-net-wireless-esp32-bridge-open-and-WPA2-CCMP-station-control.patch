+static int blob_station_mic_failure(u16 unicast)
+{
+	struct esp_wifi_blob *hw = g_blob;
+
+	if (hw && hw->adapter.priv[0])
+		cfg80211_michael_mic_failure(hw->adapter.priv[0]->ndev,
+			blob_station_bssid, unicast ? NL80211_KEYTYPE_PAIRWISE : NL80211_KEYTYPE_GROUP,
+			0, NULL, GFP_ATOMIC);
+	return 0;
+}
