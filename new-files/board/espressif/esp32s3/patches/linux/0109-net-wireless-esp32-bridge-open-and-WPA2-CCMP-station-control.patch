+static int blob_station_key(const struct wifi_sec_key *key, bool deleting)
+{
+	u32 index = get_unaligned_le32(&key->index);
+	u32 size = get_unaligned_le32(&key->len);
+	u32 seq_len = get_unaligned_le32(&key->seq_len);
+	u32 alg = get_unaligned_le32(&key->algo);
+	bool pairwise = key->pad[0];
+	int ret;
+
+	if (index > 5 || size > sizeof(key->data) || seq_len > sizeof(key->seq))
+		return -EINVAL;
+	if (deleting)
+		return esp_wifi_set_sta_key_internal(0, (u8 *)key->mac_addr, index,
+			pairwise, NULL, 0, NULL, 0, pairwise ? BIT(5) : BIT(4));
+	if (alg == 7) { /* IGTK */
+		struct { u8 keyid[2], pn[6], key[32]; } igtk = {0};
+
+		if ((size != 16 && size != 32) || seq_len != 6 || index < 4)
+			return -EINVAL;
+		put_unaligned_le16(index, igtk.keyid);
+		memcpy(igtk.pn, key->seq, 6);
+		memcpy(igtk.key, key->data, size);
+		return esp_wifi_set_igtk_internal(0, &igtk);
+	}
+	if (alg != 3 || size != 16) /* CCMP first; no silent unsupported cipher */
+		return -EOPNOTSUPP;
+	ret = esp_wifi_set_sta_key_internal(alg, (u8 *)key->mac_addr, index, pairwise,
+		(u8 *)key->seq, seq_len, (u8 *)key->data, size,
+		pairwise ? BIT(5)|BIT(2)|BIT(3) : BIT(4)|BIT(2));
+	if (!ret && !pairwise)
+		esp_wifi_auth_done_internal();
+	return ret;
+}
