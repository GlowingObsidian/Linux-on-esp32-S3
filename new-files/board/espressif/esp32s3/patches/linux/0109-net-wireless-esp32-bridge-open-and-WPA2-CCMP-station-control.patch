+static int blob_station_rx_mgmt(u8 type, u8 *frame, size_t len, u8 *sender,
+			       u32 rssi, u8 channel, u64 tsf)
+{
+	u8 *body;
+	struct ieee80211_hdr_3addr *header;
+	struct event_header *event;
+	u8 own_mac[6];
+	size_t event_size;
+	unsigned long flags;
+	bool valid;
+	int ret;
+
+	if (type == 5 || type == 8)
+		return blob_scan_rx_mgmt(type, frame, len, sender, rssi, channel, tsf);
+	if (type != 11 && type != 1 && type != 3)
+		return 0;
+	if (!frame || !sender || len < 6 || len > 2304)
+		return -EINVAL;
+	spin_lock_irqsave(&blob_station_lock, flags);
+	valid = blob_station_bssid_valid && !memcmp(sender, blob_station_bssid, 6);
+	spin_unlock_irqrestore(&blob_station_lock, flags);
+	if (!valid || osi_read_mac(own_mac, 0))
+		return -EINVAL;
+	event_size = type == 11 ? sizeof(struct auth_event) : sizeof(struct assoc_event);
+	body = kzalloc(event_size + 24 + len, GFP_ATOMIC);
+	if (!body)
+		return -ENOMEM;
+	event = (void *)body;
+	event->event_code = type == 11 ? EVENT_AUTH_RX : EVENT_ASSOC_RX;
+	event->len = cpu_to_le16(event_size + 24 + len - sizeof(*event));
+	if (type == 11) {
+		struct auth_event *auth = (void *)body;
+
+		memcpy(auth->bssid, sender, 6);
+		auth->frame_type = type;
+		auth->channel = channel;
+		auth->rssi = cpu_to_le32(rssi);
+		auth->tsf = cpu_to_le64(tsf);
+		auth->frame_len = cpu_to_le16(24 + len);
+		header = (void *)auth->frame;
+	} else {
+		struct assoc_event *assoc = (void *)body;
+
+		memcpy(assoc->bssid, sender, 6);
+		assoc->frame_type = type;
+		assoc->channel = channel;
+		assoc->rssi = cpu_to_le32(rssi);
+		assoc->tsf = cpu_to_le64(tsf);
+		assoc->frame_len = cpu_to_le16(24 + len);
+		header = (void *)assoc->frame;
+	}
+	header->frame_control = cpu_to_le16(type << 4);
+	memcpy(header->addr1, own_mac, 6);
+	memcpy(header->addr2, sender, 6);
+	memcpy(header->addr3, sender, 6);
+	memcpy((u8 *)header + 24, frame, len);
+	ret = blob_post_event(g_blob, body, event_size + 24 + len);
+	kfree(body);
+	return ret;
+}
