+static int blob_station_connect(u8 *bssid)
+{
+	unsigned long flags;
+
+	if (!bssid)
+		return -EINVAL;
+	spin_lock_irqsave(&blob_station_lock, flags);
+	memcpy(blob_station_bssid, bssid, 6);
+	blob_station_bssid_valid = true;
+	spin_unlock_irqrestore(&blob_station_lock, flags);
+	return esp_wifi_connect_internal(bssid);
+}
+
+static int blob_station_eapol(u8 *sender, u8 *data, u32 len)
+{
+	unsigned long flags;
+	bool valid;
+
+	if (!sender || !data || len < 4 || len > 2048)
+		return -EINVAL;
+	spin_lock_irqsave(&blob_station_lock, flags);
+	valid = blob_station_bssid_valid && !memcmp(sender, blob_station_bssid, 6);
+	spin_unlock_irqrestore(&blob_station_lock, flags);
+	return valid ? blob_queue_packet(g_blob, PACKET_TYPE_EAPOL, data, len) : -EINVAL;
+}
+
+static char *blob_station_parse_string(const char *value, size_t *length)
+{
+	size_t n;
+	char *out;
+
+	if (!value || !length)
+		return NULL;
+	n = strnlen(value, 257);
+	if (n > 256)
+		return NULL;
+	if (n >= 2 && value[0] == '"' && value[n - 1] == '"') {
+		out = osi_malloc(n - 1);
+		if (!out)
+			return NULL;
+		memcpy(out, value + 1, n - 2);
+		out[n - 2] = 0;
+		*length = n - 2;
+		return out;
+	}
+	if (n & 1)
+		return NULL;
+	out = osi_malloc(n / 2 + 1);
+	if (!out)
+		return NULL;
+	if (hexstr2bin(value, (u8 *)out, n / 2)) {
+		osi_free(out);
+		return NULL;
+	}
+	out[n / 2] = 0;
+	*length = n / 2;
+	return out;
+}
