+static int blob_station_auth(const struct cmd_sta_auth *auth, u16 len)
+{
+	blob_wifi_config_t config = {0};
+	unsigned long flags;
+	int ret;
+
+	if (len < sizeof(*auth) || auth->auth_type != 0 || auth->auth_data_len ||
+	    !auth->ssid[0] || auth->key_len || auth->channel < 1 || auth->channel > 14)
+		return -EOPNOTSUPP; /* first target: visible open/WPA2 networks */
+	memcpy(config.sta.ssid, auth->ssid, 32);
+	memcpy(config.sta.bssid, auth->bssid, 6);
+	config.sta.bssid_set = true;
+	config.sta.channel = auth->channel;
+	config.sta.pmf_cfg.capable = true;
+	config.sta.sae_pk_mode = 2; /* disabled */
+	if (auth->pad[0]) {
+		/* Linux performs the four-way handshake. As in esp-hosted,
+		 * a nonempty placeholder selects protected MAC operation;
+		 * real temporal keys arrive via CMD_ADD_KEY, never this field.
+		 */
+		memcpy(config.sta.password, "12345678", 8);
+		config.sta.threshold.authmode = 3; /* WPA2 */
+	}
+	spin_lock_irqsave(&blob_station_lock, flags);
+	memcpy(blob_station_bssid, auth->bssid, 6);
+	blob_station_bssid_valid = true;
+	spin_unlock_irqrestore(&blob_station_lock, flags);
+	ret = esp_wifi_register_mgmt_frame_internal(BIT(1)|BIT(3)|BIT(11)|BIT(10)|BIT(12), 0);
+	if (!ret)
+		ret = esp_wifi_set_config(0, &config);
+	if (!ret)
+		ret = esp_wifi_connect();
+	return ret;
+}
