+static bool blob_station_command(struct esp_wifi_blob *hw,
+				 const struct command_header *cmd, u16 len)
+{
+	int ret = -EINVAL;
+	u8 response[8] = {0};
+	u16 response_len = 0;
+
+	switch (cmd->cmd_code) {
+	case CMD_STA_AUTH:
+		ret = blob_station_auth((const void *)cmd, len);
+		break;
+	case CMD_STA_ASSOC: {
+		const struct cmd_sta_assoc *assoc = (const void *)cmd;
+
+		if (len < sizeof(*assoc) || assoc->assoc_ie_len > len - sizeof(*assoc))
+			break;
+		ret = esp_wifi_unset_appie_internal(1);
+		if (!ret && assoc->assoc_ie_len)
+			ret = esp_wifi_set_appie_internal(1, (u8 *)assoc->assoc_ie, assoc->assoc_ie_len, 0);
+		if (!ret)
+			ret = esp_wifi_issue_assoc_internal(0);
+		break;
+	}
+	case CMD_STA_DISCONNECT: {
+		const struct cmd_sta_disconnect *disc = (const void *)cmd;
+
+		if (len < sizeof(*disc))
+			break;
+		esp_wifi_deauthenticate_internal(get_unaligned_le16(&disc->reason_code));
+		ret = 0;
+		break;
+	}
+	case CMD_ADD_KEY:
+	case CMD_DEL_KEY: {
+		const struct cmd_key_operation *key = (const void *)cmd;
+
+		if (len >= sizeof(*key))
+			ret = blob_station_key(&key->key, cmd->cmd_code == CMD_DEL_KEY);
+		break;
+	}
+	case CMD_SET_MAC: {
+		const struct cmd_config_mac_address *mac = (const void *)cmd;
+
+		if (len >= sizeof(*mac)) {
+			ret = esp_wifi_set_mac(0, mac->mac_addr);
+			if (!ret) { memcpy(response, mac->mac_addr, 6); response_len = 8; }
+		}
+		break;
+	}
+	case CMD_GET_TXPOWER:
+	case CMD_SET_TXPOWER: {
+		const struct cmd_set_get_val *value = (const void *)cmd;
+		s8 power;
+
+		if (cmd->cmd_code == CMD_SET_TXPOWER && len < sizeof(*value))
+			break;
+		ret = cmd->cmd_code == CMD_GET_TXPOWER ? 0 :
+			esp_wifi_set_max_tx_power(get_unaligned_le32(&value->value));
+		if (!ret) ret = esp_wifi_get_max_tx_power(&power);
+		if (!ret) { put_unaligned_le32((s32)power, response); response_len = 4; }
+		break;
+	}
+	case CMD_SET_REG_DOMAIN:
+	case CMD_GET_REG_DOMAIN: {
+		const struct cmd_reg_domain *country = (const void *)cmd;
+		char cc[3] = {0};
+
+		if (cmd->cmd_code == CMD_SET_REG_DOMAIN && len < sizeof(*country))
+			break;
+		memcpy(cc, country->country_code, cmd->cmd_code == CMD_SET_REG_DOMAIN ? 2 : 0);
+		ret = cmd->cmd_code == CMD_GET_REG_DOMAIN ? 0 : esp_wifi_set_country_code(cc, true);
+		if (!ret) ret = esp_wifi_get_country_code(cc);
+		if (!ret) { memcpy(response, cc, 2); response_len = 4; }
+		break;
+	}
+	case CMD_SET_IP_ADDR:
+	case CMD_SET_MCAST_MAC_ADDR:
+		/* Linux owns IP configuration and receives all multicast for
+		 * filtering in its network stack; no firmware-side IP/filter.
+		 */
+		ret = 0;
+		break;
+	default:
+		return false;
+	}
+	if (ret)
+		pr_warn("native station command %u failed: %d\n", cmd->cmd_code, ret);
+	blob_post_cmd_resp(hw, cmd->cmd_code, response_len ? response : NULL,
+		response_len, ret ? CMD_RESPONSE_FAIL : CMD_RESPONSE_SUCCESS);
+	return true;
+}
