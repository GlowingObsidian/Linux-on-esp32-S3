+/* The DT supplies an exclusively reserved, DMA-capable D-bus SRAM range.
+ * Never satisfy a capability-constrained allocation with ordinary PSRAM.
+ * Headers consume one 32-byte quantum so returned buffers stay aligned.
+ */
+static struct gen_pool *osi_internal_pool;
+struct osi_internal_header { size_t requested; size_t allocated; };
+#define OSI_INTERNAL_HEADER_SIZE 32
+
+static bool osi_is_internal(const void *p)
+{
+	return p && osi_internal_pool &&
+		gen_pool_has_addr(osi_internal_pool, (unsigned long)p, 1);
+}
+
+static void *osi_malloc_internal(size_t size)
+{
+	struct osi_internal_header *h;
+	size_t total;
+	unsigned long addr;
+
+	if (!osi_internal_pool ||
+	    check_add_overflow(size ? size : 1, (size_t)OSI_INTERNAL_HEADER_SIZE, &total))
+		return NULL;
+	if (total > gen_pool_size(osi_internal_pool))
+		return NULL;
+	addr = gen_pool_alloc(osi_internal_pool, total);
+	if (!addr) {
+		pr_err_ratelimited("internal SRAM allocation %zu failed (%zu bytes free)\n",
+				  size, gen_pool_avail(osi_internal_pool));
+		return NULL;
+	}
+	h = (void *)addr;
+	h->requested = size;
+	h->allocated = total;
+	return (void *)(addr + OSI_INTERNAL_HEADER_SIZE);
+}
+
+static void osi_free_internal(void *p)
+{
+	struct osi_internal_header *h = p - OSI_INTERNAL_HEADER_SIZE;
+
+	gen_pool_free(osi_internal_pool, (unsigned long)h, h->allocated);
+}
+
+static void *osi_calloc_internal(size_t n, size_t size)
+{
+	size_t total;
+	void *p;
+
+	if (check_mul_overflow(n, size, &total))
+		return NULL;
+	p = osi_malloc_internal(total);
+	if (p)
+		memset(p, 0, total);
+	return p;
+}
+
+static void *osi_zalloc_internal(size_t size)
+{
+	return osi_calloc_internal(1, size);
+}
+
+static void *osi_realloc_internal(void *ptr, size_t size)
+{
+	void *p;
+	size_t old;
+
+	if (!ptr)
+		return osi_malloc_internal(size);
+	if (!size) {
+		if (osi_is_internal(ptr))
+			osi_free_internal(ptr);
+		else {
+			osi_heap_track(-(s64)ksize(ptr));
+			kfree(ptr);
+		}
+		return NULL;
+	}
+	old = osi_is_internal(ptr) ?
+		((struct osi_internal_header *)(ptr - OSI_INTERNAL_HEADER_SIZE))->requested :
+		ksize(ptr);
+	p = osi_malloc_internal(size);
+	if (!p)
+		return NULL;
+	memcpy(p, ptr, min(old, size));
+	if (osi_is_internal(ptr))
+		osi_free_internal(ptr);
+	else {
+		osi_heap_track(-(s64)ksize(ptr));
+		kfree(ptr);
+	}
+	return p;
+}
