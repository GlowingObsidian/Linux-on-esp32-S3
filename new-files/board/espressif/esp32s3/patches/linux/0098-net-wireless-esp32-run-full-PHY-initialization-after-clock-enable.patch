+int esp32_wifi_phy_enable(void)
+{
+	int ret = 0;
+
+	mutex_lock(&phy_init_lock);
+	if (!phy_calibrated) {
+		ret = register_chipv7_phy(phy_init_data, phy_rf_cal_data, PHY_RF_CAL_FULL);
+		if (!ret && !READ_ONCE(g_phyFuns))
+			ret = -EIO;
+		if (!ret)
+			phy_calibrated = true;
+		pr_info("full PHY initialization: ret=%d function_table=%s\n",
+			ret, READ_ONCE(g_phyFuns) ? "ready" : "NULL");
+	}
+	mutex_unlock(&phy_init_lock);
+	return ret;
 }
 
