From: Shreyan Dey <shreyan@example.com>
Subject: [PATCH] spi: esp32: handle SD initialization and RX-only transfers

Bound the clock divider, support GPIO chip select, restrict the advertised
word size to the implemented byte path, and return transfer failures.
This is the PIO prerequisite for SD; it does not implement GDMA.

--- a/drivers/spi/spi-esp32.c
+++ b/drivers/spi/spi-esp32.c
@@ -148,9 +148,13 @@
 	esp32_spi_write(spi, SPI_CTRL_REG, cr);
 
 	/* SPI_MISC_REG */
-	cr = //SPI_CS_KEEP_ACTIVE |
-		//FIELD_PREP(SPI_MASTER_CS_POL, BIT(cs)) |
-		(SPI_CS_DIS ^ BIT(cs));
+	cr = SPI_CS_DIS;
+	if (!spi_get_csgpiod(device, 0)) {
+		cr ^= BIT(cs);
+		cr |= esp32_spi_read(spi, SPI_MISC_REG) & SPI_CS_KEEP_ACTIVE;
+		if (device->mode & SPI_CS_HIGH)
+			cr |= FIELD_PREP(SPI_MASTER_CS_POL, BIT(cs));
+	}
 
 	if (device->mode & SPI_CPOL)
 		cr |= SPI_CK_IDLE_EDGE;
@@ -165,6 +169,9 @@
 	u8 cs = spi_get_chipselect(device, 0);
 	u32 cr = is_high ? 0 : SPI_CS_KEEP_ACTIVE;
 
+	if (spi_get_csgpiod(device, 0))
+		return;
+
 	/* SPI_MISC_REG */
 	cr |= (SPI_CS_DIS ^ BIT(cs));
 
@@ -177,45 +184,68 @@
 	esp32_spi_write(spi, SPI_MISC_REG, cr);
 }
 
-static void esp32_spi_wait_bit(struct esp32_spi *spi, u32 bit)
+static int esp32_spi_wait_bit(struct esp32_spi *spi, u32 bit)
 {
 	unsigned long timeout = jiffies + HZ;
 
 	while (esp32_spi_read(spi, SPI_CMD_REG) & bit) {
 		if (time_after(jiffies, timeout)) {
 			pr_warn("%s: timeout waiting for 0x%08x\n", __func__, bit);
-			return;
+			return -ETIMEDOUT;
 		}
 		cpu_relax();
 	}
-}
-
-static void esp32_spi_prepare_transfer(struct esp32_spi *spi,
+	return 0;
+}
