+/* PRE and N store divider minus one. Choose the smallest divisor that
+ * never exceeds the requested bus speed, including MMC's 400 kHz startup.
+ */
+static int esp32_spi_clock(u32 source, u32 requested, u32 *reg, u32 *actual)
+{
+	u32 pre, best_pre = 0, best_n = 0, best_div = 1025;
+
+	if (!source || !requested)
+		return -EINVAL;
+	if (requested >= source) {
+		*reg = SPI_CLK_EQU_SYSCLK;
+		*actual = source;
+		return 0;
+	}
+	for (pre = 1; pre <= 16; pre++) {
+		u32 n = max_t(u32, 2,
+			DIV_ROUND_UP(DIV_ROUND_UP(source, pre), requested));
+
+		if (n <= 64 && pre * n < best_div) {
+			best_pre = pre;
+			best_n = n;
+			best_div = pre * n;
+		}
+	}
+	if (!best_pre)
+		return -EINVAL;
+	*reg = FIELD_PREP(SPI_CLKDIV_PRE, best_pre - 1) |
+		FIELD_PREP(SPI_CLKCNT_N, best_n - 1) |
+		FIELD_PREP(SPI_CLKCNT_L, best_n - 1) |
+		FIELD_PREP(SPI_CLKCNT_H, best_n / 2 - 1);
+	*actual = source / best_div;
+	return 0;
+}
