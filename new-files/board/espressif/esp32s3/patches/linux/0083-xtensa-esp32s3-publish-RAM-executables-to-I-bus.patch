From: Shreyan Dey <shreyan@example.com>
Subject: [PATCH] xtensa: esp32s3: publish PSRAM executable mappings to I-bus

--- a/arch/xtensa/mm/Makefile
+++ b/arch/xtensa/mm/Makefile
@@ -12,3 +12,5 @@
 KASAN_SANITIZE_fault.o := n
 KASAN_SANITIZE_kasan_init.o := n
 KASAN_SANITIZE_mmu.o := n
+
+obj-$(CONFIG_XTENSA_SMP_ESP32) += esp32-cache.o
--- /dev/null
+++ b/arch/xtensa/mm/esp32-cache.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ESP32-S3 external caches are shared by both CPUs, outside Xtensa's L1
+ * description. Code copied into PSRAM must be published to its I-bus alias.
+ * Keep caches enabled: kernel text is in flash and stacks/data are in PSRAM.
+ */
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include <linux/spinlock.h>
+#include <asm/esp32-cache.h>
+
+#define EXTMEM_BASE 0x600c4000UL
+#define DCACHE_CTRL 0x00
+#define DCACHE_SYNC_CTRL 0x28
+#define DCACHE_SYNC_ADDR 0x2c
+#define DCACHE_SYNC_SIZE 0x30
+#define ICACHE_CTRL 0x60
+#define ICACHE_SYNC_CTRL 0x88
+#define ICACHE_SYNC_ADDR 0x8c
+#define ICACHE_SYNC_SIZE 0x90
+#define SYNC_SIZE_MASK GENMASK(22, 0)
+#define PSRAM_START 0x3d800000UL
+#define PSRAM_END 0x3e000000UL
+#define IBUS_OFFSET 0x06000000UL
+
+DEFINE_RAW_SPINLOCK(esp32_cache_lock);
+
+static u32 cache_read(u32 offset)
+{
+	return readl((void __iomem *)(EXTMEM_BASE + offset));
+}
+
+static void cache_write(u32 offset, u32 value)
+{
+	writel(value, (void __iomem *)(EXTMEM_BASE + offset));
+}
+
+static void cache_sync(u32 ctrl, u32 addr_reg, u32 size_reg,
+		       unsigned long start, unsigned long end,
+		       u32 line_size, u32 operation, u32 done)
+{
+	unsigned long aligned = round_down(start, line_size);
+	u32 lines = (round_up(end, line_size) - aligned) / line_size;
+	u32 value;
+	int ret;
+
+	cache_write(addr_reg, aligned);
+	cache_write(size_reg, (cache_read(size_reg) & ~SYNC_SIZE_MASK) | lines);
+	mb();
+	cache_write(ctrl, cache_read(ctrl) | operation);
+	ret = readl_poll_timeout_atomic((void __iomem *)(EXTMEM_BASE + ctrl),
+		value, value & done, 0, 1000000);
+	if (ret)
+		panic("ESP32-S3 executable cache sync timeout");
+	mb();
+}
+
+void esp32_sync_exec_cache(unsigned long start, unsigned long end)
+{
+	unsigned long flags;
+	u32 dline, iline;
+
+	if (start >= PSRAM_START + IBUS_OFFSET && end <= PSRAM_END + IBUS_OFFSET) {
+		start -= IBUS_OFFSET;
+		end -= IBUS_OFFSET;
+	}
+	if (start >= end || start < PSRAM_START || end > PSRAM_END)
+		return; /* Flash XIP mappings have no RAM writes to publish. */
+
+	raw_spin_lock_irqsave(&esp32_cache_lock, flags);
+	dline = 16U << ((cache_read(DCACHE_CTRL) >> 3) & 3);
+	iline = 16U << ((cache_read(ICACHE_CTRL) >> 3) & 1);
+	/* Publish D-bus stores before discarding the matching I-bus lines. */
+	cache_sync(DCACHE_SYNC_CTRL, DCACHE_SYNC_ADDR, DCACHE_SYNC_SIZE,
+		   start, end, dline, BIT(1), BIT(3));
+	cache_sync(ICACHE_SYNC_CTRL, ICACHE_SYNC_ADDR, ICACHE_SYNC_SIZE,
+		   start + IBUS_OFFSET, end + IBUS_OFFSET, iline, BIT(0), BIT(1));
+	raw_spin_unlock_irqrestore(&esp32_cache_lock, flags);
+}
--- /dev/null
+++ b/arch/xtensa/include/asm/esp32-cache.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _XTENSA_ESP32_CACHE_H
+#define _XTENSA_ESP32_CACHE_H
+#include <linux/spinlock_types.h>
+/* Shared S3 cache/MMU transaction registers, also used by NOMMU fork banks. */
+extern raw_spinlock_t esp32_cache_lock;
+void esp32_sync_exec_cache(unsigned long start, unsigned long end);
+#endif
--- a/arch/xtensa/include/asm/cacheflush.h
+++ b/arch/xtensa/include/asm/cacheflush.h
@@ -202,11 +202,17 @@
 #define flush_icache_user_range flush_icache_range
 
 /* Ensure consistency between data and instruction cache. */
+#ifdef CONFIG_XTENSA_SMP_ESP32
+#include <asm/esp32-cache.h>
+#define local_flush_icache_range(start, end) esp32_sync_exec_cache(start, end)
+#else
 #define local_flush_icache_range(start, end)				\
 	do {								\
 		__flush_dcache_range(start, (end) - (start));		\
 		__invalidate_icache_range(start,(end) - (start));	\
 	} while (0)
+
+#endif
 
 #if defined(CONFIG_MMU) && (DCACHE_WAY_SIZE > PAGE_SIZE)
 
@@ -222,8 +228,8 @@
 #define copy_to_user_page(vma, page, vaddr, dst, src, len)		\
 	do {								\
 		memcpy(dst, src, len);					\
-		__flush_dcache_range((unsigned long) dst, len);		\
-		__invalidate_icache_range((unsigned long) dst, len);	\
+		local_flush_icache_range((unsigned long) dst,		\
+					(unsigned long) dst + len);	\
 	} while (0)
 
 #define copy_from_user_page(vma, page, vaddr, dst, src, len) \
