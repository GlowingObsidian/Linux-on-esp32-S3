+#if defined(CONFIG_XTENSA_SMP_ESP32) && defined(CONFIG_SMP)
+struct esp32_intc_irq {
+	struct esp32_intc *intc;
+	unsigned int cpu;
+	unsigned int source;
+	unsigned int input;
+};
+
+static void esp32_intc_mask(struct irq_data *d)
+{
+	struct esp32_intc_irq *route = irq_data_get_irq_chip_data(d);
+
+	/* MMIO gating works from either CPU, unlike the parent's INTENABLE. */
+	esp32_intc_write(route->intc, route->cpu, route->source,
+			 ESP32_INTC_DISCONNECTED);
+}
+
+static void esp32_intc_unmask(struct irq_data *d)
+{
+	struct esp32_intc_irq *route = irq_data_get_irq_chip_data(d);
+
+	esp32_intc_write(route->intc, route->cpu, route->source, route->input);
+	esp32_enable_peripheral_irq(route->cpu, route->input);
+}
+
+static int esp32_intc_set_affinity(struct irq_data *d,
+				 const struct cpumask *mask, bool force)
+{
+	struct esp32_intc_irq *route = irq_data_get_irq_chip_data(d);
+
+	/* Preserve the DT's fixed CPU route; do not pretend the MX parent's
+	 * affinity callback can move an S3 interrupt-matrix connection.
+	 */
+	if (!cpumask_test_cpu(route->cpu, mask))
+		return -EINVAL;
+	irq_data_update_effective_affinity(d, cpumask_of(route->cpu));
+	return IRQ_SET_MASK_OK;
+}
+#endif
+
