+#if defined(CONFIG_XTENSA_SMP_ESP32) && defined(CONFIG_SMP)
+static int esp32_intc_domain_alloc(struct irq_domain *domain, unsigned int virq,
+				 unsigned int nr_irqs, void *data)
+{
+	struct irq_fwspec *spec = data, parent;
+	struct esp32_intc *priv = domain->host_data;
+	struct esp32_intc_irq *route;
+	unsigned int cpu, source, input;
+	int ret;
+
+	/* One independently allocated matrix route per device IRQ. */
+	if (nr_irqs != 1 || spec->param_count < 2 || spec->param_count > 3)
+		return -EINVAL;
+	cpu = spec->param_count == 3 ? spec->param[2] : 0;
+	source = spec->param[0];
+	input = spec->param[1];
+	if (cpu >= priv->n_cpus || source >= priv->n_irq ||
+	    input >= XCHAL_NUM_INTERRUPTS)
+		return -EINVAL;
+	if (!(BIT(input) & XCHAL_INTTYPE_MASK_EXTERN_LEVEL))
+		return -EINVAL;
+	if (input == 2 || source == 79 || source == 80)
+		return -EBUSY; /* reserved cross-core doorbells */
+	route = kzalloc(sizeof(*route), GFP_KERNEL);
+	if (!route)
+		return -ENOMEM;
+	*route = (struct esp32_intc_irq) { priv, cpu, source, input };
+	parent.fwnode = domain->parent->fwnode;
+	parent.param_count = 2;
+	parent.param[0] = input;
+	parent.param[1] = 0;
+	ret = irq_domain_alloc_irqs_parent(domain, virq, 1, &parent);
+	if (ret)
+		goto free_route;
+	ret = irq_domain_set_hwirq_and_chip(domain, virq, input,
+					   &esp32_intc_chip, route);
+	if (ret) {
+		irq_domain_free_irqs_parent(domain, virq, 1);
+		goto free_route;
+	}
+	/* Leave the source masked until generic IRQ startup unmasks it. */
+	esp32_intc_write(priv, cpu, source, ESP32_INTC_DISCONNECTED);
+	irq_data_update_effective_affinity(irq_domain_get_irq_data(domain, virq),
+					   cpumask_of(cpu));
+	return 0;
+free_route:
+	kfree(route);
+	return ret;
+}
+
+static void esp32_intc_domain_free(struct irq_domain *domain, unsigned int virq,
+				 unsigned int nr_irqs)
+{
+	unsigned int i;
+
+	for (i = 0; i < nr_irqs; ++i) {
+		struct irq_data *d = irq_domain_get_irq_data(domain, virq + i);
+		struct esp32_intc_irq *route = irq_data_get_irq_chip_data(d);
+
+		esp32_intc_mask(d);
+		irq_domain_reset_irq_data(d);
+		kfree(route);
+	}
+	irq_domain_free_irqs_parent(domain, virq, nr_irqs);
+}
+#else
 static int esp32_intc_domain_alloc(struct irq_domain *domain, unsigned int virq,
 				   unsigned int nr_irqs, void *data)
