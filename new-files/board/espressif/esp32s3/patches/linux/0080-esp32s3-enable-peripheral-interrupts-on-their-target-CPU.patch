+#ifdef CONFIG_XTENSA_SMP_ESP32
+static void esp32_enable_local_inputs(unsigned long inputs)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	xtensa_set_sr(xtensa_get_sr(intenable) | inputs, intenable);
+	asm volatile("rsync" ::: "memory");
+	local_irq_restore(flags);
+}
+
+void esp32_enable_peripheral_irq(unsigned int cpu, unsigned int hwirq)
+{
+	unsigned int here;
+
+	if (WARN_ON_ONCE(cpu >= nr_cpu_ids || hwirq >= XCHAL_NUM_INTERRUPTS))
+		return;
+	here = get_cpu();
+	if (cpu == here) {
+		esp32_enable_local_inputs(BIT(hwirq));
+	} else {
+		/* A synchronous IPI is unsafe under the caller's IRQ-desc lock.
+		 * Queue the input and ring the existing doorbell without waiting.
+		 * A not-yet-started CPU will drain this after enabling its IPI.
+		 */
+		set_bit(hwirq, &per_cpu(esp32_irq_enable_pending, cpu));
+		send_ipi_message(cpumask_of(cpu), IPI_ENABLE_IRQ);
+	}
+	put_cpu();
+}
+#endif
 
 void arch_send_call_function_ipi_mask(const struct cpumask *mask)
