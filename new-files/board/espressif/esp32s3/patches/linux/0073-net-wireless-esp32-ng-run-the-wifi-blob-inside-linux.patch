+/* eFuse. The factory MAC address lives here, and the blob asks for it */
+/* through _read_mac. The block is inside the peripheral window        */
+/* (0x60000000-0x6009FFFF), so it is ioremappable from this driver     */
+/* without a device-tree carve-out.                                    */
+/* ------------------------------------------------------------------ */
+
+#define ESP32_EFUSE_BASE		0x60007000
+#define EFUSE_RD_MAC_SPI_SYS_0_REG	0x044	/* MAC bytes 3..0 */
+#define EFUSE_RD_MAC_SPI_SYS_1_REG	0x048	/* MAC bytes 5..4 */
+
+static void __iomem *efuse_base;
