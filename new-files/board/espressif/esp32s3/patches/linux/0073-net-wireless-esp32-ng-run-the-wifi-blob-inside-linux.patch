+/* ------------------------------------------------------------------ */
+/* PHY and clock. These are the hooks libphy.a and the Wi-Fi task call */
+/* back into the host for. They were all no-ops, and that is the second */
+/* half of why the radio never came up: wifi_rf_phy_enable() calls     */
+/* _wifi_apb80m_request, then _wifi_clock_enable, then _phy_enable, and */
+/* with all three doing nothing the MAC and PHY blocks stayed gated    */
+/* off and the calibration wrote into a dead peripheral.               */
+/*                                                                     */
+/* The register map is the S3's, from the TRM's system/peripheral      */
+/* clock chapter and IDF's soc/esp32s3/include/soc/system_reg.h:       */
+/*                                                                     */
+/*   SYSTEM_WIFI_CLK_EN_REG      0x60026000 + 0x14                     */
+/*     bit 0  WIFI_BT_COMMON, bits 1..2 WIFI_BT_SDIO, ...              */
+/*     the Wi-Fi block's own clock gate; IDF writes 0xffffffff here    */
+/*     in esp_phy_enable_clock() and that is what this does.           */
+/*   SYSTEM_WIFI_RST_EN_REG      0x60026000 + 0x18                     */
+/*     bit 5  WIFI_RST, bit 6  MAC_RST                                 */
+/*   SYSTEM_PERIP_CLK_EN0_REG    0x600c0000 + 0x10                     */
+/*     bit 22 WIFI_CLK_EN, bit 21 FE_CLK_EN                            */
+/*   SYSTEM_PERIP_RST_EN0_REG    0x600c0000 + 0x18                     */
+/*     the matching reset bits                                         */
+/*   SYSTEM_WIFI_CLK_EN_REG's APB bit is what apb80m_request means:    */
+/*     IDF's periph_module_enable(PERIPH_WIFI_MODULE) path raises the  */
+/*     APB 80 MHz clock so the CPU can reach the MAC registers at all. */
+/*                                                                     */
+/* These are plain MMIO writes. CONFIG_MMU is off in this kernel, so   */
+/* ioremap is identity and the peripheral window is reachable as-is.   */
+/* ------------------------------------------------------------------ */
+
+#define ESP32_SYSTEM_BASE		0x60026000
+#define SYSTEM_WIFI_CLK_EN_REG		0x14
+#define SYSTEM_WIFI_RST_EN_REG		0x18
+
+#define ESP32_PERIP_BASE		0x600c0000
+#define SYSTEM_PERIP_CLK_EN0_REG	0x10
+#define SYSTEM_PERIP_RST_EN0_REG	0x18
+
+/* SYSTEM_PERIP_CLK_EN0: the Wi-Fi and front-end gates. */
+#define PERIP_WIFI_CLK_EN		BIT(22)
+#define PERIP_FE_CLK_EN			BIT(21)
+
+/* SYSTEM_WIFI_CLK_EN: the Wi-Fi/BT common gate is bit 0. */
+#define WIFI_BT_COMMON_CLK_EN		BIT(0)
+
+/* SYSTEM_WIFI_RST_EN: the two resets this port drives. */
+#define WIFI_RST			BIT(5)
+#define MAC_RST				BIT(6)
+
+#define ESP32_SYSTEM_REG(off)	((void __iomem *)(ESP32_SYSTEM_BASE + (off)))
+#define ESP32_PERIP_REG(off)	((void __iomem *)(ESP32_PERIP_BASE + (off)))
+
+static bool wifi_apb80m_on;
+static bool wifi_clock_on;
+
+/*
+ * osi_wifi_apb80m_request -- raise the APB 80 MHz clock so the CPU can
+ * reach the MAC's register file. Without it every store the blob makes
+ * to the MAC block is lost, and the first read back is whatever the bus
+ * returns for an unclocked peripheral.
+ *
+ * IDF does this through periph_module_enable(PERIPH_WIFI_MODULE), which
+ * sets both the peripheral clock gate and the Wi-Fi APB gate; both are
+ * written here.
+ */
+static void osi_wifi_apb80m_request(void)
+{
+	u32 v;
+
+	if (wifi_apb80m_on) {
+		osi_note("_wifi_apb80m_request (already on)");
+		return;
+	}
+	wifi_apb80m_on = true;
+
+	v = readl(ESP32_PERIP_REG(SYSTEM_PERIP_CLK_EN0_REG));
+	v |= PERIP_WIFI_CLK_EN | PERIP_FE_CLK_EN;
+	writel(v, ESP32_PERIP_REG(SYSTEM_PERIP_CLK_EN0_REG));
+
+	/* Take the MAC out of reset, then let it settle. The reset is
+	 * asserted-low in effect: writing the bit releases it.
+	 */
+	v = readl(ESP32_SYSTEM_REG(SYSTEM_WIFI_RST_EN_REG));
+	v &= ~(WIFI_RST | MAC_RST);
+	writel(v, ESP32_SYSTEM_REG(SYSTEM_WIFI_RST_EN_REG));
+
+	pr_info("osi: APB 80M on: PERIP_CLK_EN0=0x%08x WIFI_RST_EN=0x%08x\n",
+		readl(ESP32_PERIP_REG(SYSTEM_PERIP_CLK_EN0_REG)),
+		readl(ESP32_SYSTEM_REG(SYSTEM_WIFI_RST_EN_REG)));
+}
+
+static void osi_wifi_apb80m_release(void)
+{
+	if (!wifi_apb80m_on)
+		return;
+	wifi_apb80m_on = false;
+	osi_note("_wifi_apb80m_release");
+}
+
+/*
+ * osi_wifi_clock_enable -- the Wi-Fi block's own clock gate. IDF's
+ * esp_phy_enable_clock() writes 0xffffffff to SYSTEM_WIFI_CLK_EN; the
+ * field is a gate per sub-block and every one of them is wanted here.
+ */
+static void osi_wifi_clock_enable(void)
+{
+	if (wifi_clock_on) {
+		osi_note("_wifi_clock_enable (already on)");
+		return;
+	}
+	wifi_clock_on = true;
+
+	writel(0xffffffff, ESP32_SYSTEM_REG(SYSTEM_WIFI_CLK_EN_REG));
+	pr_info("osi: Wi-Fi clock on: WIFI_CLK_EN=0x%08x\n",
+		readl(ESP32_SYSTEM_REG(SYSTEM_WIFI_CLK_EN_REG)));
+}
+
+static void osi_wifi_clock_disable(void)
+{
+	if (!wifi_clock_on)
+		return;
+	wifi_clock_on = false;
+	osi_note("_wifi_clock_disable");
+}
+
+/*
+ * osi_wifi_reset_mac -- pulse the MAC reset. The blob calls this when it
+ * wants the MAC back at its power-on state; asserting and releasing the
+ * reset bit is what the hardware wants, and a short settle after it.
+ */
+static void osi_wifi_reset_mac(void)
+{
+	u32 v;
+
+	v = readl(ESP32_SYSTEM_REG(SYSTEM_WIFI_RST_EN_REG));
+	writel(v | MAC_RST, ESP32_SYSTEM_REG(SYSTEM_WIFI_RST_EN_REG));
+	udelay(10);
+	writel(v & ~MAC_RST, ESP32_SYSTEM_REG(SYSTEM_WIFI_RST_EN_REG));
+	udelay(10);
+	osi_note("_wifi_reset_mac");
+}
+
+/*
+ * osi_phy_enable -- the PHY's own enable. wifi_rf_phy_enable() reaches
+ * this through the OS interface table once the clocks above are up, and
+ * it is the last thing before ic_mac_init().
+ *
+ * The PHY library has already been brought up by
+ * esp32_wifi_phy_init() -> register_chipv7_phy_init_param() by the time
+ * this is called, so there is no second calibration here: this is the
+ * power-on of the analog front end that the calibration assumed.
+ *
+ * The SAR ADC and the power detector are the two analog blocks the PHY
+ * reads through, and they are powered by the SENS hooks in
+ * esp32-wifi-blob-phy.c; this only has to make sure the PHY's own
+ * register window is clocked, which is the FE gate above.
+ */
+static void osi_phy_enable(void)
+{
+	u32 v;
+
+	v = readl(ESP32_PERIP_REG(SYSTEM_PERIP_CLK_EN0_REG));
+	v |= PERIP_FE_CLK_EN | PERIP_WIFI_CLK_EN;
+	writel(v, ESP32_PERIP_REG(SYSTEM_PERIP_CLK_EN0_REG));
+
+	pr_info("osi: phy enable: PERIP_CLK_EN0=0x%08x\n",
+		readl(ESP32_PERIP_REG(SYSTEM_PERIP_CLK_EN0_REG)));
+}
+
