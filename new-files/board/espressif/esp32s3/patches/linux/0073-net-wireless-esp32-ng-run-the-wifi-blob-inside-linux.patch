+/*
+ * The blob's crypto table, from libnet80211.a (ieee80211_crypto.o, 116
+ * bytes of function pointers). It is a BSS symbol: all zero in the image,
+ * and the blob fills it itself.
+ *
+ * Do not call wpa_crypto_funcs_init() from here. That function copies
+ * *from* this symbol *into* its argument -- it is the blob's own helper,
+ * and wifi_init_process() calls it on the config we pass in, late in
+ * esp_wifi_init_internal(). Calling it early copies 116 zero bytes into
+ * the config, and wifi_menuconfig_init() then rejects the config because
+ * wpa_crypto_funcs.size is 0 instead of 116, returning 0x102.
+ *
+ * So the probe leaves the table zeroed and lets the blob fill it. The
+ * size/extra pair is the only part that has to be right up front.
+ */
+extern u8 wpa_crypto_funcs[];
+
+/*
+ * The config esp_wifi_init_internal() takes, laid out the way the blob
+ * reads it. The offsets are measured from the blob's own code, not taken
+ * from the IDF header -- see experiments/mmu-poc/fork/WIFI-BLOB-INIT-CONFIG.md
+ * for the disassembly each one comes from.
+ *
+ * The blob validates this struct before it uses it. wifi_menuconfig_init()
+ * rejects it with ESP_ERR_INVALID_ARG unless magic (offset 200) is
+ * 0x1F2F3F4F and the crypto table's size/extra words (offsets 4 and 8) are
+ * 116 and 1, and it range-checks most of the buffer counts. Getting the
+ * layout wrong therefore fails loudly rather than silently.
+ */
+#define WIFI_INIT_CONFIG_MAGIC		0x1F2F3F4F
+#define WPA_CRYPTO_FUNCS_SIZE		116
+
+struct wifi_blob_crypto_funcs {
+	u32 size;		/* must be 116 */
+	u32 extra;		/* must be 1 */
+	u8  table[WPA_CRYPTO_FUNCS_SIZE - 8];
+};
+
+struct wifi_blob_init_config {
+	void *osi_funcs;			/*   0 */
+	struct wifi_blob_crypto_funcs wpa_crypto_funcs;	/*   4, 116 bytes */
+	int static_rx_buf_num;			/* 120 */
+	int dynamic_rx_buf_num;			/* 124 */
+	int tx_buf_type;			/* 128 */
+	int static_tx_buf_num;			/* 132 */
+	int dynamic_tx_buf_num;			/* 136 */
+	int cache_tx_buf_num;			/* 140 */
+	int csi_enable;				/* 144 */
+	int ampdu_rx_enable;			/* 148 */
+	int ampdu_tx_enable;			/* 152 */
+	int amsdu_tx_enable;			/* 156 */
+	int nvs_enable;				/* 160 */
+	int nano_enable;			/* 164 */
+	int rx_ba_win;				/* 168 */
+	int wifi_task_core_id;			/* 172 */
+	int beacon_max_len;			/* 176 */
+	int mgmt_sbuf_num;			/* 180 */
