+/*
+ * The ROM's slot for the OS interface pointer. Named in
+ * esp32s3.rom.ld as `g_osi_funcs_p = 0x3fcef940`, in internal SRAM 1
+ * Block 8. Linux's RAM ends at 0x3e000000 (DT memory@0 is 0x3d800000 +
+ * 0x00800000), so this address is outside kernel memory: it is the ROM's,
+ * it is not cached by Linux, and writing it cannot corrupt the kernel.
+ */
+#define ESP32_ROM_OSI_FUNCS_P		0x3fcef940
+
+/*
+ * The blob's own entry points, from ieee80211_api.o and ieee80211_output.o.
+ * Declared here with the IDF signatures; the archives are linked with
+ * --whole-archive so these resolve at link time.
+ */
+extern int esp_wifi_init_internal(const void *config);
+extern int esp_wifi_deinit_internal(void);
+extern int esp_wifi_start(void);
+extern int esp_wifi_stop(void);
