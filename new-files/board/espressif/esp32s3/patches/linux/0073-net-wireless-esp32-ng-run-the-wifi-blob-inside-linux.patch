+/* ------------------------------------------------------------------ */
+/* The transport. esp_if_ops is what the driver's upper half calls.    */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The transport. esp_if_ops is four functions and the whole upper half of
+ * the driver works unchanged behind it -- but only if the adapter this
+ * backend owns is the one every path in the upper half is given, because
+ * after the driver's own patch 25 there is no global adapter to fall back
+ * on. So this struct embeds it, exactly as esp_shmem.c does, and
+ * container_of() gets it back from the pointer the driver hands in.
+ */
+static struct sk_buff *blob_read_packet(struct esp_adapter *adapter)
+{
+	struct esp_wifi_blob *hw =
+		container_of(adapter, struct esp_wifi_blob, adapter);
+	struct sk_buff *skb;
+
+	skb = skb_dequeue(&hw->rx_q[PRIO_Q_HIGH]);
+	if (!skb)
+		skb = skb_dequeue(&hw->rx_q[PRIO_Q_MID]);
+	if (!skb)
+		skb = skb_dequeue(&hw->rx_q[PRIO_Q_LOW]);
+	return skb;
+}
+
+/*
+ * The blob hands a received 802.11 frame to the driver through the rxcb it
+ * registers with esp_wifi_internal_reg_rxcb(). In the IDF build that
+ * callback is the netif's input function; here the frame is wrapped in an
+ * skb and queued, and the driver's own RX work picks it up exactly as it
+ * picks up a shmem frame.
+ *
+ * The payload header the driver's process_rx_packet() expects is not
+ * present on the frame the blob hands over -- in the IDF build the
+ * firmware's netif path puts it there. So it is built here, which is also
+ * where the interface type and number are stamped, and it is what makes
+ * get_priv_from_payload_header() find the station interface.
+ */
+static int blob_rx_cb(void *netif, void *buf, u16 len, void *eb)
+{
+	struct esp_wifi_blob *hw = g_blob;
+	struct sk_buff *skb;
+	struct esp_payload_header *hdr;
+	u16 total;
+
+	if (!hw)
+		return -1;
+
+	total = len + sizeof(*hdr);
+	skb = dev_alloc_skb(total + SKB_DATA_ADDR_ALIGNMENT);
+	if (!skb) {
+		pr_err("rx: dev_alloc_skb(%u) failed\n", total);
+		return -1;
+	}
+	skb_reserve(skb, SKB_DATA_ADDR_ALIGNMENT);
+	hdr = skb_put(skb, sizeof(*hdr));
+	memset(hdr, 0, sizeof(*hdr));
+	hdr->if_type = ESP_STA_IF;
+	hdr->if_num = 0;
+	hdr->flags = 0;
+	hdr->len = cpu_to_le16(len);
+	hdr->offset = cpu_to_le16(sizeof(*hdr));
+	hdr->packet_type = PACKET_TYPE_DATA;
+	skb_put_data(skb, buf, len);
+
+	skb_queue_tail(&hw->rx_q[PRIO_Q_HIGH], skb);
+	esp_process_new_packet_intr(&hw->adapter);
+	return 0;
+}
+
+/*
+ * Events.
+ *
+ * The blob raises Wi-Fi events through the OS interface's _event_post, and
+ * the driver's upper half needs to see them: process_cmd_event() is what
+ * turns an association into a cfg80211 connect result. In the IDF build
+ * the firmware's own wifi_event_handler() translates each IDF event into
+ * the driver's wire format and hands it to send_command_event(); here
+ * there is no firmware in between, so this is that translation.
+ *
+ * The translation is the firmware's, read off
+ * network_adapter/main/cmd.c's wifi_event_handler() and the helpers it
+ * calls, and it is deliberately the same shape rather than a new one:
+ * the host half already knows how to read it, and a second encoding
+ * would be a second thing to be wrong.
+ *
+ * Only three IDF events produce a wire event:
+ *
+ *   WIFI_EVENT_STA_DISCONNECTED -> EVENT_STA_DISCONNECT
+ *   WIFI_EVENT_STA_CONNECTED    -> nothing on its own; the firmware
+ *                                  sends EVENT_ASSOC_RX from the
+ *                                  association response frame, which
+ *                                  arrives here as a management frame
+ *                                  rather than an event
+ *   WIFI_EVENT_SCAN_DONE        -> EVENT_SCAN_RESULT with len 0
+ *
+ * The rest are logged and dropped. That is not a gap: the firmware
+ * dropped them too (its default case is a log line), and the driver's
+ * process_cmd_event() has no case for them either.
+ *
+ * The IDF ids are the enum in esp_wifi_types.h, whose first member is 0.
+ */
+#define WIFI_EVENT_SCAN_DONE		1
+#define WIFI_EVENT_STA_START		2
+#define WIFI_EVENT_STA_STOP		3
+#define WIFI_EVENT_STA_CONNECTED	4
+#define WIFI_EVENT_STA_DISCONNECTED	5
+
+/*
+ * The event base the blob posts against. Defined once, in
+ * esp_blob_support.c, because the blob's own ieee80211_api.o references it
+ * by name; declared here so this file can compare against it.
+ */
+extern const char *WIFI_EVENT;
+
+/*
+ * The IDF structures the blob hands over, as the firmware's cmd.c reads
+ * them. Field order and widths are the header's; the packing is explicit
+ * because the blob was compiled with IDF's, and a mismatch here would
+ * misread ssid_len or reason silently.
+ */
+struct blob_event_sta_connected {
+	u8  ssid[32];
+	u8  ssid_len;
+	u8  bssid[6];
+	u8  channel;
+	u32 authmode;
+	u16 aid;
+} __packed;
+
+struct blob_event_sta_disconnected {
+	u8  ssid[32];
+	u8  ssid_len;
+	u8  bssid[6];
+	u8  reason;
+	s8  rssi;
+} __packed;
+
+/*
+ * The disconnect event the host half parses. It is adapter.h's
+ * struct disconnect_event, repeated here because that struct is declared
+ * in the same header as the wire event codes and this file includes it
+ * only transitively; spelling it out keeps the offsets visible next to
+ * the IDF struct they are filled from.
+ */
+struct blob_disconnect_event {
+	struct event_header header;
+	u8  ssid[32];
+	u8  bssid[6];
+	u8  reason;
+} __packed;
+
+/*
+ * Queue one wire event for the driver's RX work, the same way a received
+ * frame is queued: an esp_payload_header, then the event body. The
+ * driver's process_rx_packet() strips the payload header, resolves the
+ * interface from it, and hands the rest to process_cmd_event().
+ */
+static int blob_post_event(struct esp_wifi_blob *hw, const void *body, u16 len)
+{
+	struct sk_buff *skb;
+	struct esp_payload_header *hdr;
+	u16 total = len + sizeof(*hdr);
+
+	skb = dev_alloc_skb(total + SKB_DATA_ADDR_ALIGNMENT);
+	if (!skb) {
+		pr_err("event: dev_alloc_skb(%u) failed\n", total);
+		return -ENOMEM;
+	}
+	skb_reserve(skb, SKB_DATA_ADDR_ALIGNMENT);
+
+	hdr = skb_put(skb, sizeof(*hdr));
+	memset(hdr, 0, sizeof(*hdr));
+	hdr->if_type = ESP_STA_IF;
+	hdr->if_num = 0;
+	hdr->flags = 0;
+	hdr->len = cpu_to_le16(len);
+	hdr->offset = cpu_to_le16(sizeof(*hdr));
+	hdr->packet_type = PACKET_TYPE_EVENT;
+
+	skb_put_data(skb, body, len);
+
+	skb_queue_tail(&hw->rx_q[PRIO_Q_HIGH], skb);
+	esp_process_new_packet_intr(&hw->adapter);
+	return 0;
+}
+
+int esp_wifi_blob_event_post(const char *event_base, int32_t event_id,
+			     void *event_data, size_t event_data_size,
+			     uint32_t ticks_to_wait)
+{
+	struct esp_wifi_blob *hw = g_blob;
+
+	if (!hw)
+		return -ENODEV;
+
+	/*
+	 * A NULL base is the blob posting without a subsystem, which the
+	 * firmware's handler also refused. Anything else that is not
+	 * WIFI_EVENT is someone else's event and not this path's.
+	 */
+	if (!event_base || strcmp(event_base, WIFI_EVENT)) {
+		pr_info("event: ignored base=%s id=%d\n",
+			event_base ? event_base : "(null)", event_id);
+		return 0;
+	}
+
+	switch (event_id) {
+	case WIFI_EVENT_STA_START:
+		pr_info("event: station started\n");
+		break;
+
+	case WIFI_EVENT_STA_STOP:
+		pr_info("event: station stopped\n");
+		break;
+
+	case WIFI_EVENT_STA_CONNECTED: {
+		struct blob_event_sta_connected *c = event_data;
+
+		/*
+		 * The firmware does not forward this one. It records the
+		 * state and waits for the association response, which
+		 * arrives as a management frame and becomes EVENT_ASSOC_RX
+		 * -- that is what carries the frame cfg80211 needs. Logging
+		 * it here is what makes the ordering visible on a board run.
+		 */
+		if (c) {
+			char ssid[33];
+
+			memcpy(ssid, c->ssid, 32);
+			ssid[32] = '\0';
+			pr_info("event: station connected ssid=%s bssid=%pM ch=%u\n",
+				ssid, c->bssid, c->channel);
+		} else {
+			pr_info("event: station connected, no data\n");
+		}
+		break;
+	}
+
+	case WIFI_EVENT_STA_DISCONNECTED: {
+		struct blob_disconnect_event ev;
+		struct blob_event_sta_disconnected *d = event_data;
+
+		if (!d) {
+			pr_err("event: disconnect with no data\n");
+			break;
+		}
+
+		memset(&ev, 0, sizeof(ev));
+		ev.header.event_code = EVENT_STA_DISCONNECT;
+		ev.header.status = 0;
+		ev.header.len = cpu_to_le16(sizeof(ev) - sizeof(ev.header));
+		memcpy(ev.ssid, d->ssid, 32);
+		memcpy(ev.bssid, d->bssid, 6);
+		ev.reason = d->reason;
+
+		pr_info("event: station disconnected reason=%u\n", d->reason);
+		blob_post_event(hw, &ev, sizeof(ev));
+		break;
+	}
+
+	case WIFI_EVENT_SCAN_DONE: {
+		struct event_header ev;
+
+		/*
+		 * The firmware sends the bare header with len 0 for this
+		 * one -- the scan results come back separately, one
+		 * EVENT_SCAN_RESULT per AP, from the probe-response path.
+		 */
+		memset(&ev, 0, sizeof(ev));
+		ev.event_code = EVENT_SCAN_RESULT;
+		ev.status = 0;
+		ev.len = 0;
+
+		pr_info("event: scan done\n");
+		blob_post_event(hw, &ev, sizeof(ev));
+		break;
+	}
+
+	default:
+		pr_info("event: id=%d data=%p size=%zu unhandled\n",
+			event_id, event_data, event_data_size);
+		break;
+	}
+
+	return 0;
+}
+
+/*
+ * Command responses.
+ *
+ * The driver's upper half is written against a firmware that answers
+ * commands: every cmd_*() helper queues a command node, and
+ * wait_and_decode_cmd_resp() then blocks on adapter->cmd_resp until a
+ * PACKET_TYPE_COMMAND_RESPONSE skb arrives on the rx path. There is no
+ * firmware here. The blob is the radio, and esp_wifi_internal_tx() puts
+ * a frame on the air -- it does not answer anything.
+ *
+ * Two of those commands are sent during the driver's own bring-up, from
+ * esp_cfg80211_add_iface(): CMD_INIT_INTERFACE and CMD_GET_MAC. Without
+ * a reply each waits out COMMAND_RESPONSE_TIMEOUT (5 s) and
+ * esp_cfg80211_add_iface() fails, so esp_add_card() fails, so no
+ * espsta0 and no wiphy -- the interface never appears. That is why this
+ * exists.
+ *
+ * Both are answered from the blob itself rather than faked:
+ *
+ *   CMD_INIT_INTERFACE  the blob has no per-interface state to create
+ *                       here; the interface is already up, because
+ *                       esp_wifi_start() ran before this was ever
+ *                       called. A success header is the whole answer.
+ *   CMD_GET_MAC         esp_wifi_get_mac() is in the blob
+ *                       (libnet80211.a, ieee80211_api.o) and returns the
+ *                       real station address out of eFuse. Use it rather
+ *                       than inventing one, so the MAC the kernel
+ *                       registers is the MAC the radio transmits with.
+ *
+ * The reply is queued on the same rx queue a received frame uses, with
+ * the same payload header shape, so it reaches process_rx_packet() ->
+ * process_cmd_resp() by the path the driver already has. The interface
+ * number is ESP_STA_IF/0, which is what prepare_command_request() sets
+ * on the way out and what get_priv_from_payload_header() matches on.
+ */
+extern int esp_wifi_get_mac(int ifx, u8 *mac);
+
+#define ESP_STA_IF_NUM		0
+
+static int blob_post_cmd_resp(struct esp_wifi_blob *hw, u8 cmd_code,
+			      const void *body, u16 body_len)
+{
+	struct sk_buff *skb;
+	struct esp_payload_header *hdr;
+	struct command_header *cmd;
+	u16 total = sizeof(*cmd) + body_len;
+
+	skb = dev_alloc_skb(total + sizeof(*hdr) + SKB_DATA_ADDR_ALIGNMENT);
+	if (!skb) {
+		pr_err("cmd: dev_alloc_skb(%u) failed\n", total);
+		return -ENOMEM;
+	}
+	skb_reserve(skb, SKB_DATA_ADDR_ALIGNMENT);
+
+	hdr = skb_put(skb, sizeof(*hdr));
+	memset(hdr, 0, sizeof(*hdr));
+	hdr->if_type = ESP_STA_IF;
+	hdr->if_num = ESP_STA_IF_NUM;
+	hdr->flags = 0;
+	hdr->len = cpu_to_le16(total);
+	hdr->offset = cpu_to_le16(sizeof(*hdr));
+	hdr->packet_type = PACKET_TYPE_COMMAND_RESPONSE;
+
+	cmd = skb_put(skb, sizeof(*cmd));
+	memset(cmd, 0, sizeof(*cmd));
+	cmd->cmd_code = cmd_code;
+	cmd->cmd_status = CMD_RESPONSE_SUCCESS;
+	cmd->len = cpu_to_le16(total);
+
+	if (body_len)
+		skb_put_data(skb, body, body_len);
+
+	skb_queue_tail(&hw->rx_q[PRIO_Q_HIGH], skb);
+	esp_process_new_packet_intr(&hw->adapter);
+	return 0;
+}
+
+/*
+ * Answer the two commands the driver's bring-up sends, and report
+ * whether this was one of them. Everything else goes to the radio.
+ */
+static bool blob_maybe_answer_cmd(struct esp_wifi_blob *hw, u8 cmd_code)
+{
+	struct cmd_config_mac_address resp;
+	u8 mac[MAC_ADDR_LEN];
+	int ret;
+
+	switch (cmd_code) {
+	case CMD_INIT_INTERFACE:
+		ret = blob_post_cmd_resp(hw, cmd_code, NULL, 0);
+		if (ret)
+			return false;
+		pr_info("cmd: init interface answered\n");
+		return true;
+
+	case CMD_GET_MAC:
+		ret = esp_wifi_get_mac(ESP_STA_IF_NUM, mac);
+		if (ret) {
+			pr_err("cmd: esp_wifi_get_mac: %d\n", ret);
+			return false;
+		}
+		memset(&resp, 0, sizeof(resp));
+		memcpy(resp.mac_addr, mac, MAC_ADDR_LEN);
+		ret = blob_post_cmd_resp(hw, cmd_code, &resp, sizeof(resp));
+		if (ret)
+			return false;
+		pr_info("cmd: get mac answered %pM\n", mac);
+		return true;
+
+	default:
+		return false;
+	}
+}
+
+/*
+ * write -- the driver has already built the payload header, so skb->data
+ * is the frame as it goes on the wire; the header is stripped back off
+ * before the blob sees it.
+ */
+static int blob_write_packet(struct esp_adapter *adapter, struct sk_buff *skb)
+{
+	struct esp_payload_header *hdr;
+	struct command_header *cmd;
+	u16 offset;
+	u16 len;
+
+	if (!skb || !skb->data || !skb->len) {
+		if (skb)
+			dev_kfree_skb(skb);
+		return -EINVAL;
+	}
+
+	hdr = (struct esp_payload_header *)skb->data;
+	offset = le16_to_cpu(hdr->offset);
+	if (offset < sizeof(*hdr) || offset > skb->len) {
+		pr_err("tx: bad payload offset %u (len %u)\n", offset, skb->len);
+		dev_kfree_skb(skb);
+		return -EINVAL;
+	}
+
+	/*
+	 * A command the driver's own bring-up sends is answered here, from
+	 * the blob, before the frame is handed to the radio. See the note
+	 * on blob_post_cmd_resp above for why these two and not others.
+	 */
+	len = le16_to_cpu(hdr->len);
+	if (hdr->packet_type == PACKET_TYPE_COMMAND_REQUEST &&
+	    len >= sizeof(*cmd) && offset + sizeof(*cmd) <= skb->len) {
+		cmd = (struct command_header *)(skb->data + offset);
+		if (g_blob && blob_maybe_answer_cmd(g_blob, cmd->cmd_code)) {
+			dev_kfree_skb(skb);
+			return 0;
+		}
+	}
+
+	skb_pull(skb, offset);
+
+	esp_wifi_internal_tx(NULL, skb->data, skb->len);
+	dev_kfree_skb(skb);
+	return 0;
+}
+
+/*
+ * ------------------------------------------------------------------
+ * Symbols main.c expects from the transport.
+ *
+ * main.c is shared between every transport this driver has -- shmem,
+ * SPI, SDIO -- and each of those provides these three. The blob is a
+ * fourth transport and has to provide them too.
+ *
+ * They were invisible until esp_add_card() became reachable: while
+ * nothing called it, the linker discarded the functions that reference
+ * these and the missing definitions never mattered. Calling
+ * esp_add_card() from the probe pulled in the whole of main.c, and the
+ * link failed on all three.
+ * ------------------------------------------------------------------
+ */
+
+/*
+ * host_sleep -- set by a transport while the host is suspended, and
+ * tested by esp_hard_start_xmit() to refuse a transmit. There is no
+ * suspend path in the blob: the radio is on the same core as the
+ * kernel, so there is no window where the host is asleep and the radio
+ * is not. It stays 0, and the transmit check is always satisfied.
+ */
+volatile u8 host_sleep;
+
+/*
+ * esp_deinit_module -- the transport's teardown hook, called from
+ * process_event_esp_bootup() before it re-initialises. The blob has no
+ * transport state to drop here: esp_wifi_deinit_internal() is what
+ * tears the radio down, and the probe calls it directly on its error
+ * paths. Nothing to do, so this reports success.
+ */
+int esp_deinit_module(struct esp_adapter *adapter)
+{
+	return 0;
+}
+
+/*
+ * esp_validate_chipset -- records which chip the firmware reported, so
+ * the driver knows what it is talking to. The blob is not firmware
+ * running elsewhere: it is Espressif's ESP32-S3 libraries linked into
+ * this kernel, so the answer is known at compile time rather than
+ * received over a transport. Report ESP32-S3 and record it, so
+ * adapter->chipset is set the same way a transport would set it.
+ */
+int esp_validate_chipset(struct esp_adapter *adapter, u8 chipset)
+{
+	if (!adapter)
+		return -EINVAL;
+
+	/*
+	 * Accept only what this blob can be. A different value would mean
+	 * the caller is describing a chip whose libraries are not the ones
+	 * linked here, which is worth saying rather than silently
+	 * accepting -- the blob's calibration data is per-chip.
+	 */
+	if (chipset != ESP_FIRMWARE_CHIP_ESP32S3) {
+		pr_err("blob: chipset %#x is not the ESP32-S3 this blob was built for\n",
+		       chipset);
+		adapter->chipset = ESP_FIRMWARE_CHIP_UNRECOGNIZED;
+		return -EINVAL;
+	}
+
+	adapter->chipset = chipset;
+	pr_info("blob: chipset=%s ID=%02x (linked, not reported over a transport)\n",
+		esp_chipname_from_id(chipset), chipset);
+	return 0;
+}
+
+static int blob_init(struct esp_adapter *adapter)
+{
+	return 0;
+}
+
+static int blob_deinit(struct esp_adapter *adapter)
+{
+	return 0;
+}
+
+static const struct esp_if_ops if_ops = {
+	.init = blob_init,
+	.read = blob_read_packet,
+	.write = blob_write_packet,
+	.deinit = blob_deinit,
+};
+
+/* ------------------------------------------------------------------ */
+/* Probe.                                                              */
+/* ------------------------------------------------------------------ */
+
+/* Defined below the probe, which calls it through the gate. */
+static int esp32_wifi_blob_start(struct esp_wifi_blob *hw);
+
+/*
+ * The gate. Off by default, because with it on the probe faults before
+ * userspace starts and there is no shell to work from.
+ *
+ * A plain module_param would only set this variable: the probe has
+ * already returned by the time anyone can write to it, so flipping the
+ * flag would do nothing until the next boot. The setter below calls the
+ * blob's bring-up directly, which is what makes the toggle useful after
+ * boot -- and is why the bring-up was split out of the probe.
+ *
+ * The parameter appears at /sys/module/esp32_wifi/parameters/enable.
+ * esp32_wifi, not esp32_wifi_blob: the object is esp32-wifi.o and the
+ * sysfs directory follows the object name. It is also settable on the
+ * kernel command line as esp32_wifi.enable=1.
+ */
+static bool wifi_blob_enable;
+
+/*
+ * The bring-up runs from a workqueue, not from the store callback.
+ *
+ * The store callback runs under the parameter's own lock, and the
+ * bring-up blocks -- it takes semaphores, waits on queues and, when it
+ * faults, never returns. Holding that lock across a call that does not
+ * come back is what makes a second `echo 1` hang the board instead of
+ * failing. Deferring to a workqueue returns from the write immediately
+ * and runs the bring-up in process context, where it belongs.
+ */
+static void wifi_blob_start_work(struct work_struct *w)
+{
+	esp32_wifi_blob_start(g_blob);
+}
+
+static DECLARE_WORK(wifi_blob_work, wifi_blob_start_work);
+
+static int wifi_blob_enable_set(const char *val,
+				const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret || !wifi_blob_enable)
+		return ret;
+	if (!g_blob) {
+		pr_err("osi: no probe yet; cannot start the blob\n");
+		return -ENODEV;
+	}
+	schedule_work(&wifi_blob_work);
+	return 0;
+}
+
+static const struct kernel_param_ops wifi_blob_enable_ops = {
+	.set = wifi_blob_enable_set,
+	.get = param_get_bool,
+};
+
+module_param_cb(enable, &wifi_blob_enable_ops, &wifi_blob_enable, 0644);
+MODULE_PARM_DESC(enable, "Run the Wi-Fi blob at probe (default: off)");
+
+static int esp32_wifi_blob_probe(struct platform_device *pdev)
+{
+	struct esp_wifi_blob *hw;
+	u32 osi_addr = ESP32_ROM_OSI_FUNCS_P;
+	int ret, i;
+
+	/*
+	 * The fault dump goes in first, before a single blob instruction
+	 * runs. It was registered at the end of probe on the reasoning that
+	 * a fault before the blob is up is not a blob fault -- but the
+	 * bring-up itself is the window that faults, and that window had no
+	 * dump at all. The crash this was moved for printed pc, ra and
+	 * excvaddr and nothing else: no exccause, no windowbase, no
+	 * windowstart, which is exactly the set needed to tell a bad store
+	 * from a bad window spill, and the reading was guesswork without
+	 * them.
+	 *
+	 * Registered here, it is unregistered on every error path below --
+	 * the paths that return without going through err_unmap would
+	 * otherwise leave a notifier pointing at a module that is going
+	 * away.
+	 */
+	register_die_notifier(&osi_die_nb);
+
+	hw = devm_kzalloc(&pdev->dev, sizeof(*hw), GFP_KERNEL);
+	if (!hw) {
+		unregister_die_notifier(&osi_die_nb);
+		return -ENOMEM;
+	}
+	platform_set_drvdata(pdev, hw);
+	for (i = 0; i < MAX_PRIORITY_QUEUES; i++)
+		skb_queue_head_init(&hw->rx_q[i]);
+	skb_queue_head_init(&hw->tx_q);
+
+	/*
+	 * The interrupt matrix, so _set_intr can turn a (matrix row, core
+	 * interrupt) pair into a Linux IRQ. It is a separate node from this
+	 * one, so it is looked up by compatible rather than by phandle --
+	 * the driver has no business requiring the board's DT to name it.
+	 */
+	hw->intc_np = of_find_compatible_node(NULL, NULL, "esp,esp32-intc");
+	if (!hw->intc_np)
+		dev_warn(&pdev->dev,
+			 "no esp,esp32-intc node; the blob's interrupts cannot be wired\n");
+
+	of_property_read_u32(pdev->dev.of_node, "osi-funcs-address", &osi_addr);
+	hw->osi_slot = ioremap(osi_addr, sizeof(void *));
+	if (!hw->osi_slot) {
+		dev_err(&pdev->dev, "ioremap(0x%x) failed\n", osi_addr);
+		unregister_die_notifier(&osi_die_nb);
+		return -ENOMEM;
+	}
+	dev_info(&pdev->dev, "OS interface slot at 0x%x -> %p\n",
+		 osi_addr, hw->osi_slot);
+
+	ret = esp32_wifi_phy_init();
+	if (ret) {
+		dev_err(&pdev->dev, "PHY bring-up failed: %d\n", ret);
+		goto err_unmap;
+	}
+
+	ret = esp_wifi_init(&hw->adapter, &if_ops);
+	if (ret < 0) {
+		dev_err(&pdev->dev, "esp_wifi_init failed: %d\n", ret);
+		goto err_phy;
+	}
+	g_blob = hw;
+
+	/* Install the interface before the blob runs a single instruction.
+	 * The ROM owns this slot; the blob reads it, and it must read ours.
+	 */
+	writel((u32)(uintptr_t)&g_osi_funcs, hw->osi_slot);
+	if (readl(hw->osi_slot) != (u32)(uintptr_t)&g_osi_funcs) {
+		dev_err(&pdev->dev,
+			"OS interface pointer did not take: wrote %08x, read %08x\n",
+			(u32)(uintptr_t)&g_osi_funcs, readl(hw->osi_slot));
+		ret = -EIO;
+		goto err_probe_adapter;
+	}
+	dev_info(&pdev->dev, "OS interface installed at 0x%x\n", osi_addr);
+
+	/*
+	 * xphyQueue is a ROM pointer slot at 0x3fcef904, not storage the blob
+	 * owns. The blob only ever reads it. pp_post reads it and hands it to
+	 * _queue_send_from_isr (slot byte 100); ppTask reads it and hands it
+	 * to _queue_msg_waiting (slot byte 116) as its second action after
+	 * entry. Nothing in the 106-object corpus writes it, and neither does
+	 * this port, so whatever the ROM left there is what the blob gets.
+	 *
+	 * The port's queue functions check only for NULL, so a non-NULL
+	 * garbage value is dereferenced as a struct osi_queue. Print the slot
+	 * before the blob starts: the oops cannot answer this, and one boot
+	 * log settles whether the ROM left 0, a real handle, or garbage.
+	 */
+	hw->xphy_slot = ioremap(0x3fcef904, sizeof(void *));
+	if (!hw->xphy_slot) {
+		dev_err(&pdev->dev, "ioremap(0x3fcef904) failed\n");
+		ret = -ENOMEM;
+		goto err_probe_adapter;
+	}
+	dev_info(&pdev->dev, "xphyQueue slot 0x3fcef904 = %08x\n",
+		 readl(hw->xphy_slot));
+
+	/*
+	 * Record every ROM pointer slot the blob reads, so the die
+	 * notifier can print them at the fault. The addresses are the
+	 * absolute ROM slots bound in the linker script; the blob reads
+	 * them, nothing in the corpus writes them, and this port writes
+	 * only xphyQueue. A failure here is not fatal -- the dump skips
+	 * a slot whose mapping is NULL -- but a slot that cannot be
+	 * mapped is worth knowing about, so say so.
+	 */
+	osi_rom_slots[0] = hw->xphy_slot;
+	osi_rom_slots[1] = ioremap(0x3fcef910, sizeof(void *));
+	osi_rom_slots[2] = ioremap(0x3fcef90c, sizeof(void *));
+	osi_rom_slots[3] = ioremap(0x3fcef914, sizeof(void *));
+	osi_rom_slots[4] = ioremap(0x3fcef918, sizeof(void *));
+	for (i = 1; i < OSI_ROM_SLOT_NR; i++) {
+		if (!osi_rom_slots[i])
+			dev_warn(&pdev->dev, "cannot map ROM slot %s\n",
+				 osi_rom_slot_names[i]);
+	}
+	osi_rom_slots_dump("probe");
+
+	/*
+	 * If the ROM left nothing there, give the blob a real queue. The
+	 * message is two words: pp_post writes msg[0] at a1+0 and msg[1] at
+	 * a1+4 (s32i.n a2, a1, 0 / s32i.n a3, a1, 4), and ppTask reads a1+0
+	 * back after the receive. Both frames are entry a1, 48, so 8 bytes is
+	 * the item size the blob's own send and receive agree on.
+	 */
+	if (!readl(hw->xphy_slot)) {
+		void *q = osi_queue_create(64, 8);
+
+		if (!q) {
+			dev_err(&pdev->dev, "xphyQueue: could not create\n");
+			ret = -ENOMEM;
+			goto err_probe_adapter;
+		}
+		writel((u32)(uintptr_t)q, hw->xphy_slot);
+		dev_info(&pdev->dev, "xphyQueue populated with %p\n", q);
+	}
+
+	/*
+	 * The blob will not take NULL here. esp_wifi_init_internal() returns
+	 * ESP_ERR_INVALID_ARG (0x102) immediately when its argument is NULL,
+	 * and everything downstream of it then fails for a reason that has
+	 * nothing to do with the radio. It wants a populated config, and the
+	 * three fields that matter most are the OS interface, the crypto
+	 * table and the magic.
+	 *
+	 * The crypto table is left zeroed. wifi_menuconfig_init() checks
+	 * only its size (116) and extra (1) on the way in; the 116 function
+	 * pointers are then written by the blob itself, when
+	 * wifi_init_process() calls wifi_crypto_init() ->
+	 * wpa_crypto_funcs_init(&cfg->wpa_crypto_funcs). Filling them here
+	 * would be overwritten anyway, and calling that helper early copies
+	 * zeros and fails the size check.
+	 *
+	 * The buffer counts are IDF's defaults for a station-only build. The
+	 * blob range-checks them, so they have to be inside the ranges
+	 * wifi_menuconfig_init() enforces, but the exact values are a tuning
+	 * question rather than a correctness one. The fill itself lives in
+	 * esp32_wifi_blob_start(), below the gate, because the sysfs write
+	 * has to be able to run it after boot.
+	 */
+
+	/*
+	 * The gate. Everything above this point is one-time probe setup --
+	 * the die notifier, the hw allocation, the ioremaps, the PHY
+	 * bring-up, the adapter and netdev, the idempotent ROM-slot writes
+	 * -- and none of it may run twice. Everything below is the blob's
+	 * own bring-up, and it is the part that faults.
+	 *
+	 * With the blob off the board reaches userspace, which it otherwise
+	 * does not: the probe faults before init runs, so there is no shell
+	 * to inspect anything from. That is the whole reason for the gate.
+	 * From that shell:
+	 *
+	 *   echo "read 0x3fcef904" > /dev/esp32-regs; cat /dev/esp32-regs
+	 *   echo 1 > /sys/module/esp32_wifi/parameters/enable
+	 *
+	 * The esp32-regs read shows what the ROM left in a slot; the write
+	 * command sets one to a known value; the sysfs write starts the blob
+	 * and the die notifier prints every slot at the fault. A question
+	 * that used to cost a build now costs a reboot.
+	 *
+	 * The parameter is on esp32_wifi, not esp32_wifi_blob: the object is
+	 * esp32-wifi.o, and the sysfs directory follows the object name.
+	 */
+	if (!wifi_blob_enable) {
+		dev_info(&pdev->dev,
+			 "blob disabled; booting without it. Start it with:\n");
+		dev_info(&pdev->dev,
+			 "  echo 1 > /sys/module/esp32_wifi/parameters/enable\n");
+		return 0;
+	}
+
+	return esp32_wifi_blob_start(hw);
+
+	/*
+	 * The probe's own unwinds. These are reachable only from the setup
+	 * above the gate, which runs once at boot, so they may tear down
+	 * everything -- the notifier, the OSI mapping, the PHY.
+	 *
+	 * The label is err_probe_adapter, not err_adapter, even though the
+	 * two would not collide: esp32_wifi_blob_start() below has its own
+	 * err_adapter and labels are function-scoped, so both would compile.
+	 * They do different things, though -- this one tears down the PHY
+	 * and the mapping, that one only the adapter and the blob -- and a
+	 * reader should not have to work out which function they are in to
+	 * know which unwind they are looking at.
+	 */
+err_probe_adapter:
+	esp_wifi_deinit(&hw->adapter);
+err_phy:
+	esp32_wifi_phy_deinit();
+err_unmap:
+	iounmap(hw->osi_slot);
+	g_blob = NULL;
+	unregister_die_notifier(&osi_die_nb);
+	return ret;
+}
+
+/*
+ * The blob's bring-up, split out of the probe so the sysfs gate can run
+ * it after boot with the already-probed hw.
+ *
+ * The boundary is esp_coex_adapter_register() because that is the first
+ * call that hands the blob a pointer into this port's state. Above it,
+ * nothing has been given away; below it, the blob owns the coex lock,
+ * the scheduler callbacks and the netdev.
+ *
+ * It runs once. A second entry would re-enter esp_wifi_init_internal()
+ * on a half-initialised blob and bury whatever the first attempt was
+ * going to say under a new fault, which is the opposite of the point.
+ */
+static int esp32_wifi_blob_start(struct esp_wifi_blob *hw)
+{
+	struct wifi_blob_init_config cfg;
+	int ret;
+
+	if (hw->blob_started)
+		return -EBUSY;
+	hw->blob_started = true;
+
+	memset(&cfg, 0, sizeof(cfg));
+	cfg.osi_funcs = &g_osi_funcs;
+	cfg.wpa_crypto_funcs.size = WPA_CRYPTO_FUNCS_SIZE;
+	cfg.wpa_crypto_funcs.extra = 1;
+	cfg.static_rx_buf_num = 10;
+	cfg.dynamic_rx_buf_num = 32;
+	cfg.tx_buf_type = 1;
+	cfg.dynamic_tx_buf_num = 32;
+	cfg.ampdu_rx_enable = 1;
+	cfg.ampdu_tx_enable = 1;
+	cfg.rx_ba_win = 6;
+	cfg.nvs_enable = 0;
+	cfg.wifi_task_core_id = 0;
+	cfg.mgmt_sbuf_num = 6;
+	cfg.feature_caps = 0;
+	cfg.magic = WIFI_INIT_CONFIG_MAGIC;
+
+	/*
+	 * The coexistence environment, before the blob is initialised.
+	 *
+	 * Order matters and it is IDF's, not a guess: the adapter is
+	 * registered first, then coex_pre_init() brings up the coex lock and
+	 * environment. Doing only the first -- which is what a port that
+	 * copies IDF's wifi_init.c without its system-init hook ends up
+	 * doing -- leaves esp_wifi_init_internal() to fault when it
+	 * registers its scheduler callbacks. s31's radio_stack.c spells this
+	 * out; see the comment on the declarations above.
+	 *
+	 * A failure here is reported and does not abort. The blob may still
+	 * come up, and if it does not, the next line's error says so with
+	 * more information than an early return would.
+	 */
+	/*
+	 * The two calls below are bracketed by prints, and that is not
+	 * noise.
+	 *
+	 * coex_pre_init() does not return on this port: the board's log
+	 * stopped inside it, after coex_rom_osi_funcs_init's own
+	 * "coex firmware version" line, with no fault and no further
+	 * output. A hang withholds the one thing a crash gives you -- the
+	 * address it died at -- so the only way to read it is to make it
+	 * say where it got to.
+	 *
+	 * "enter"/"leave" around each call narrows it to a single
+	 * function. Inside coex_pre_init the semphr_take prints do the
+	 * rest: if a blocking take is what never returns, the log ends on
+	 * "blocking take" and names the handle.
+	 */
+	pr_info("osi: coex: adapter_register enter\n");
+	ret = esp_coex_adapter_register(&g_coex_adapter_funcs);
+	pr_info("osi: coex: adapter_register leave: %d\n", ret);
+	if (ret)
+		dev_warn(hw->adapter.dev, "esp_coex_adapter_register: %d\n", ret);
+
+	pr_info("osi: coex: pre_init enter\n");
+	ret = coex_pre_init();
+	pr_info("osi: coex: pre_init leave: %d\n", ret);
+	if (ret)
+		dev_warn(hw->adapter.dev, "coex_pre_init: %d\n", ret);
+
+	/*
+	 * No esp_event_loop_create_default() here.
+	 *
+	 * IDF calls it before esp_wifi_init(), and s31 does too
+	 * (radio_stack.c:1250), so it looks like part of the sequence. It
+	 * is not part of this port's, for two reasons.
+	 *
+	 * It is not needed: the blob posts every Wi-Fi event through
+	 * osi->_event_post -- the OS interface at offset 176 of struct
+	 * wifi_osi_funcs, which this probe points at
+	 * esp_wifi_blob_event_post. Nothing in esp_wifi_init_internal's
+	 * call chain touches esp_event_loop_*, and nothing the blob does
+	 * afterwards does either.
+	 *
+	 * And it cannot be linked: esp_event_loop_create_default() lives
+	 * in libesp_event.a's default_event_loop.c.obj, which calls
+	 * esp_event_loop_create(), which lives in esp_event.c.obj, which
+	 * needs FreeRTOS -- xQueueGenericCreate, xTaskCreatePinnedToCore,
+	 * vTaskDelete, xQueueReceive and nine more. This port has no
+	 * FreeRTOS. Linking the archive to get the one function drags in
+	 * the whole queue and task layer.
+	 *
+	 * s31 can call it because s31 has a FreeRTOS emulation underneath
+	 * (firmware/radio/s31_rtos_queue.c, s31_rtos_core.c, s31_rtos_event.c
+	 * -- 1919 lines). This port does not, and does not need one for
+	 * this. See experiments/mmu-poc/fork/COEX-LINK-ANALYSIS.md.
+	 */
+
+	ret = esp_wifi_init_internal(&cfg);
+	if (ret) {
+		dev_err(hw->adapter.dev, "esp_wifi_init_internal: %d\n", ret);
+		goto err_adapter;
+	}
+	dev_info(hw->adapter.dev, "blob initialised\n");
+
+	/*
+	 * What the blob left in the ROM slots, now that its init has run.
+	 *
+	 * This is the pair to the esp32-regs write: set a slot from the
+	 * shell, start the blob, and this line says whether the blob
+	 * overwrote it, kept it, or never got here. A pre-boot read can
+	 * only ever show what the ROM left; this shows what the blob did
+	 * with it.
+	 */
+	osi_rom_slots_dump("after init_internal");
+
+	ret = esp_wifi_set_mode(1);	/* WIFI_MODE_STA */
+	if (ret)
+		dev_warn(hw->adapter.dev, "esp_wifi_set_mode: %d\n", ret);
+
+	ret = esp_wifi_start();
+	if (ret) {
+		dev_err(hw->adapter.dev, "esp_wifi_start: %d\n", ret);
+		goto err_blob_deinit;
+	}
+	hw->started = true;
+	dev_info(hw->adapter.dev, "blob started; the radio is Linux's\n");
+
+	/*
+	 * The rx callback goes in last, and only here.
+	 *
+	 * esp_wifi_internal_reg_rxcb() is not a plain setter: the blob's own
+	 * implementation (ieee80211_api.o) runs an OS-interface check first
+	 * and returns ESP_ERR_WIFI_NOT_INIT (0x3001) when it has not been
+	 * initialised yet, and ESP_ERR_WIFI_NOT_STARTED (0x3004) when the
+	 * interface number is out of range. Registering it before
+	 * esp_wifi_init_internal() therefore fails with 12289 and takes the
+	 * whole probe down with it -- which is what happened on the board.
+	 *
+	 * Registering it after esp_wifi_start() also matches both references:
+	 * IDF's wifi_netif.c attaches the interface before calling this, and
+	 * the firmware's own cmd.c registers its rxcb from the
+	 * WIFI_EVENT_STA_CONNECTED handler, i.e. after the radio is running.
+	 *
+	 * The interface number is WIFI_IF_STA (0), not a netif pointer -- the
+	 * blob's first argument is the interface enum. Passing NULL is
+	 * correct here and only here.
+	 */
+	ret = esp_wifi_internal_reg_rxcb(NULL, blob_rx_cb);
+	if (ret) {
+		dev_err(hw->adapter.dev, "esp_wifi_internal_reg_rxcb: %d\n", ret);
+		goto err_blob_deinit;
+	}
+	dev_info(hw->adapter.dev, "rx callback registered\n");
+
+	/*
+	 * Bring the driver's own upper half up: the wiphy and espsta0.
+	 *
+	 * This is the step the shmem port gets for free and this one does
+	 * not. There, the firmware sends an ESP_INTERNAL_BOOTUP_EVENT once
+	 * it is running, process_event_esp_bootup() handles it, and that is
+	 * what calls esp_add_card() -- esp_add_wiphy() and
+	 * esp_add_network_ifaces() behind it. Here there is no firmware to
+	 * send that event, so nothing ever called it: the blob came up and
+	 * the driver's upper half stayed dark, with no wiphy and no
+	 * interface, which is why the board showed no espsta0.
+	 *
+	 * The order is the firmware's: the radio is initialised, then
+	 * started, then the interface is created on top of it. The two
+	 * commands esp_cfg80211_add_iface() sends on the way through
+	 * (CMD_INIT_INTERFACE and CMD_GET_MAC) are answered by
+	 * blob_write_packet() -- see blob_post_cmd_resp().
+	 *
+	 * A failure here is fatal rather than a warning. Without the
+	 * interface there is nothing for userspace to configure, so a probe
+	 * that "succeeded" would leave a radio no one can reach.
+	 */
+	ret = esp_add_card(&hw->adapter);
+	if (ret) {
+		dev_err(hw->adapter.dev, "esp_add_card: %d\n", ret);
+		goto err_blob_deinit;
+	}
+	dev_info(hw->adapter.dev, "wiphy and espsta0 registered\n");
+
+	return 0;
+
+	/*
+	 * Only the two unwinds this function owns. The probe's err_phy,
+	 * err_unmap and the die-notifier unregister are deliberately not
+	 * here: this can be entered from a sysfs write long after probe
+	 * returned, and tearing down the PHY, the OSI mapping or the
+	 * notifier would break state the running board still depends on.
+	 */
+err_blob_deinit:
+	esp_wifi_deinit_internal();
+err_adapter:
+	esp_wifi_deinit(&hw->adapter);
+	return ret;
+}
+
+static void esp32_wifi_blob_remove(struct platform_device *pdev)
+{
+	struct esp_wifi_blob *hw = platform_get_drvdata(pdev);
+	int i;
+
+	if (!hw)
+		return;
+	unregister_die_notifier(&osi_die_nb);
+	if (hw->started) {
+		esp_wifi_stop();
+		esp_wifi_deinit_internal();
+	}
+	esp_wifi_deinit(&hw->adapter);
+	for (i = 0; i < MAX_PRIORITY_QUEUES; i++)
+		skb_queue_purge(&hw->rx_q[i]);
+	skb_queue_purge(&hw->tx_q);
+	esp32_wifi_phy_deinit();
+	if (hw->osi_slot)
+		iounmap(hw->osi_slot);
+	g_blob = NULL;
+}
+
+static const struct of_device_id esp32_wifi_blob_match[] = {
+	{ .compatible = "esp,esp32-wifi-blob" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, esp32_wifi_blob_match);
+
+static struct platform_driver esp32_wifi_blob_driver = {
+	.probe = esp32_wifi_blob_probe,
+	.remove = esp32_wifi_blob_remove,
+	.driver = {
+		.name = "esp32-wifi-blob",
+		.of_match_table = of_match_ptr(esp32_wifi_blob_match),
+	},
+};
+module_platform_driver(esp32_wifi_blob_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Espressif Wi-Fi blob hosted inside Linux");
diff --git a/drivers/net/wireless/espressif/esp32-ng/esp_blob_support.c b/drivers/net/wireless/espressif/esp32-ng/esp_blob_support.c
new file mode 100644
index 0000000000000..1111111111111
--- /dev/null
+++ b/drivers/net/wireless/espressif/esp32-ng/esp_blob_support.c
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The symbols the Wi-Fi blob needs that nothing else supplies.
+ *
+ * Measured, not guessed. Taking the station-only archive set
+ * (libnet80211.a, libpp.a, libcore.a, libwapi.a, libespnow.a) plus libphy.a,
+ * collecting every undefined symbol, and subtracting what the same set
+ * defines, leaves twenty-one names. Thirteen of them are the mesh entry
+ * points, stubbed at the bottom of this file. Eight remain:
+ *
+ *   WIFI_EVENT   a global event base id, referenced only by ieee80211_api.o
+ *   ets_delay_us a ROM function the linker scripts do not export
+ *   hexstr2bin   a wpa_supplicant helper
+ *   puts         newlib's, not the ROM's
+ *   sprintf      newlib's too, and the kernel already has one, so this
+ *                file does not define it -- see the note at puts
+ *   phy_enter_critical, phy_exit_critical, phy_printf
+ *                declared in esp_blob_phy.c, the other half of this port
+ *
+ * Everything else the blob reaches for is a ROM address, bound by name in
+ * arch/xtensa/kernel/vmlinux.lds.S. The ROM linker scripts (esp32s3.rom.ld
+ * and friends) are not linked into this kernel, so those names would
+ * otherwise be undefined at the final link.
+ *
+ * The ROM exports ets_delay_us at 0x40000600 in esp32s3.rom.ld, but the
+ * symbol is defined here against the kernel's own udelay instead of bound
+ * to the ROM address -- the same calibrated busy-wait, and it keeps the
+ * call inside Linux where a traceback can see it. hexstr2bin is four
+ * lines. WIFI_EVENT is an id, and the blob only ever passes it to the OS
+ * interface's _event_post, so what it actually needs is for this side to
+ * recognise it.
+ */
+
+#define pr_fmt(fmt) "esp32-wifi-blob: " fmt
+
+#include <linux/ctype.h>
+#include <linux/sprintf.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+/*
+ * The event base the blob posts its Wi-Fi events against. Only
+ * ieee80211_api.o references it, and it only ever reaches the OS
+ * interface, so the value is ours to choose -- but it must be stable,
+ * because esp_event_handler_register() on the IDF side registers against
+ * the same string. This is the IDF default.
+ */
+const char *WIFI_EVENT = "WIFI_EVENT";
+
+/*
+ * ets_delay_us is a ROM function. esp32s3.rom.ld names it at
+ * 0x40000600, but the ROM linker script is not linked into this kernel --
+ * it describes a different image's memory layout. So it is implemented
+ * here against the kernel's own microsecond delay, which is the same
+ * thing: a calibrated busy-wait.
+ */
+void ets_delay_us(uint32_t us)
+{
+	udelay(us);
+}
+
+/*
+ * hexstr2bin, from wpa_supplicant's common.c. Parses a hex string into
+ * bytes, returning 0 on success and -1 on a malformed string. The blob
+ * calls it for PSK and BSSID parsing.
+ */
+static int hex_digit(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+int hexstr2bin(const char *hex, u8 *buf, size_t len)
+{
+	size_t i;
+	int a, b;
+
+	for (i = 0; i < len; i++) {
+		a = hex_digit(*hex++);
+		if (a < 0)
+			return -1;
+		b = hex_digit(*hex++);
+		if (b < 0)
+			return -1;
+		buf[i] = (u8)((a << 4) | b);
+	}
+	return 0;
+}
+
+/*
+ * puts. newlib's, in the IDF build, and the kernel has none, so the blob's
+ * reference has to land somewhere. It is used only for log lines, so it
+ * goes to the kernel log.
+ *
+ * sprintf is deliberately NOT defined here. The kernel already has one --
+ * lib/vsprintf.c:3106, EXPORT_SYMBOL'd at :3117 -- and defining a second
+ * is a link error: "multiple definition of `sprintf'". The blob's
+ * reference binds to the kernel's, which is the better outcome anyway,
+ * since it is the one the rest of the kernel formats with.
+ */
+void puts(const char *s)
+{
+	pr_info("%s\n", s);
+}
+
+/*
+ * The mesh entry points.
+ *
+ * libnet80211.a references these thirteen; libmesh.a is the only archive that
+ * defines them. libmesh.a is deliberately not linked -- it is 972644 bytes for
+ * a feature this port does not offer, and pulling it in drags roughly two
+ * hundred more esp_mesh_* and esp_event_* references with it, none of which
+ * anything here would ever call.
+ *
+ * They cannot simply be left undefined, though: ieee80211_ioctl.o reaches
+ * mesh_set_ie_crypto_config and ieee80211_mesh_quick.o reaches
+ * ieee80211_init_mesh_assoc_ie, and both objects are pulled in for the station
+ * path. So the symbols have to exist.
+ *
+ * Each one refuses. The return values are not invented: they are read off the
+ * real implementations in libmesh.a. Every setter returns ESP_ERR_INVALID_ARG
+ * (0x102) when handed a NULL pointer and 0 otherwise, every getter returns
+ * 0x102 for a NULL destination, and ieee80211_vnd_mesh_roots_get returns -1
+ * for an out-of-range index. Returning the same values for the same inputs
+ * means a station-mode caller that somehow reaches one of these sees exactly
+ * what it would have seen with libmesh.a linked, rather than a new failure
+ * mode that did not exist before.
+ *
+ * The one behavioural difference is that a *valid* call also refuses, where
+ * the real code would have done the work. Nothing in the station path makes a
+ * valid call -- these are reachable only through the mesh ioctls -- so this is
+ * a port that does not offer mesh, not a port that offers broken mesh.
+ */
+#define ESP_ERR_INVALID_ARG 0x102
+
+int mesh_set_ie_crypto_config(void *ie, void *conf)
+{
+	if (!ie)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: set_ie_crypto_config ignored, mesh is not built in\n");
+	return 0;
+}
+
+int mesh_set_rssi_threshold(void *conf)
+{
+	if (!conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: set_rssi_threshold ignored, mesh is not built in\n");
+	return 0;
+}
+
+int mesh_set_parent_monitor_config(void *conf)
+{
+	if (!conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: set_parent_monitor_config ignored, mesh is not built in\n");
+	return 0;
+}
+
+int mesh_set_parent_candidate(void *cand, void *conf)
+{
+	if (!cand || !conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: set_parent_candidate ignored, mesh is not built in\n");
+	return 0;
+}
+
+int mesh_get_rssi_threshold(void *conf)
+{
+	if (!conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: get_rssi_threshold ignored, mesh is not built in\n");
+	return 0;
+}
+
+int mesh_get_parent_monitor_config(void *conf)
+{
+	if (!conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: get_parent_monitor_config ignored, mesh is not built in\n");
+	return 0;
+}
+
+int mesh_get_parent_candidate(void *conf)
+{
+	if (!conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: get_parent_candidate ignored, mesh is not built in\n");
+	return 0;
+}
+
+int mesh_clear_parent_candidate(void)
+{
+	pr_info("mesh: clear_parent_candidate ignored, mesh is not built in\n");
+	return 0;
+}
+
+int ieee80211_vnd_mesh_roots_set(u8 idx, void *arg, void *roots)
+{
+	if (idx >= 5 || !roots)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: vnd_mesh_roots_set ignored, mesh is not built in\n");
+	return 0;
+}
+
+int ieee80211_vnd_mesh_roots_get(u8 idx, void *roots, int count)
+{
+	if (idx >= 4)
+		return -1;
+	pr_info("mesh: vnd_mesh_roots_get ignored, mesh is not built in\n");
+	return -1;
+}
+
+int ieee80211_vnd_mesh_quick_set(void *conf)
+{
+	if (!conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: vnd_mesh_quick_set ignored, mesh is not built in\n");
+	return 0;
+}
+
+int ieee80211_vnd_mesh_quick_get(void *conf)
+{
+	if (!conf)
+		return ESP_ERR_INVALID_ARG;
+	pr_info("mesh: vnd_mesh_quick_get ignored, mesh is not built in\n");
+	return 0;
+}
+
+int ieee80211_init_mesh_assoc_ie(void *ie, void *arg, u8 len)
+{
+	if (!ie || !arg)
+		return 1;
+	pr_info("mesh: init_mesh_assoc_ie ignored, mesh is not built in\n");
+	return 1;
+}
diff --git a/drivers/net/wireless/espressif/esp32-ng/esp_blob_phy.c b/drivers/net/wireless/espressif/esp32-ng/esp_blob_phy.c
new file mode 100644
index 0000000000000..1111111111111
--- /dev/null
+++ b/drivers/net/wireless/espressif/esp32-ng/esp_blob_phy.c
@@ -0,0 +1,523 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The glue libphy.a needs, and the order the radio comes up in.
+ *
+ * libphy.a is not self-contained. Measured with nm over the archive:
+ * subtracting what it defines leaves fifteen names, of which nine are
+ * satisfiable elsewhere --
+ *
+ *   memcpy, memset        the kernel's
+ *   sprintf, ets_delay_us this port's (see esp32-wifi-blob-support.c)
+ *   __divdf3, __divdi3, __fixdfsi, __floatsidf, __subdf3
+ *                         libgcc soft-float, and the Xtensa cross libgcc
+ *                         provides all five
+ *   phy_get_romfuncs      = 0x40005c58 in esp32s3.rom.ld
+ *   rom_phy_param_addr    = 0x40006324
+ *   rom_rx_gain_force     = 0x4000642c
+ *
+ * and six are real work, which is this file:
+ *
+ *   phy_enter_critical, phy_exit_critical
+ *   phy_printf
+ *   set_xpd_sar, phy_set_pwdet_power, phy_set_tsens_power
+ *
+ * The three set_* are the ones worth reading. In the IDF build they live
+ * in phy_override.c and they exist because the PHY library calls back into
+ * the SoC layer to power the SAR ADC, the power detector and the
+ * temperature sensor on and off as calibration needs them. They are not
+ * optional decorations: the PHY's calibration sequence calls them, and a
+ * stub that does nothing leaves the analog blocks powered down and the
+ * calibration reading garbage.
+ *
+ * This file therefore drives the same registers IDF's
+ * sar_periph_ctrl_*_power_acquire()/release() pair drives. The register
+ * addresses and bit positions come from the S3 TRM, section 37 (SENS),
+ * and match IDF's soc/esp32s3/include/soc/sens_reg.h:
+ *
+ *   SENS_SAR_POWER_XPD_SAR_REG   0x60008800 + 0x00  -- SAR ADC power
+ *     SENS_FORCE_XPD_SAR           bits 30:29
+ *       0 = no force, 1 = force off, 3 = force on
+ *   SENS_SAR_PWDET_CTRL_REG      0x60008800 + 0x34  -- power detector
+ *     SENS_PWDET_SAR_POWER_CTRL    bit 17  (1 = powered)
+ *   SENS_SAR_TSENS_CTRL_REG      0x60008800 + 0x3c  -- temperature sensor
+ *     SENS_TSENS_CLK_DIV           bits 13:8
+ *     SENS_TSENS_POWER_UP          bit 7
+ *     SENS_TSENS_POWER_UP_FORCE    bit 6
+ *     SENS_TSENS_DUMP_OUT          bit 5
+ *     SENS_TSENS_READY             bit 4  (read-only)
+ *     SENS_TSENS_OUT               bits 3:0 (read-only)
+ *
+ * The PHY also needs the SAR peripheral clock gated on, which is
+ * SENS_SAR_PERI_CLK_GATE_CONF_REG at 0x60008800 + 0x20, bit
+ * SENS_SARADC_CLK_EN (bit 19) and SENS_TSENS_CLK_EN (bit 20).
+ *
+ * Every one of these is logged on the first transition, so a board run
+ * shows the order the PHY asks for power and whether it ever asks at all.
+ */
+
+#define pr_fmt(fmt) "esp32-wifi-phy: " fmt
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+/* SENS block, from the S3 TRM's peripheral map. */
+#define ESP32_SENS_BASE			0x60008800
+#define SENS_SAR_POWER_XPD_SAR_REG	0x00
+#define SENS_SAR_PERI_CLK_GATE_CONF	0x20
+#define SENS_SAR_PWDET_CTRL_REG		0x34
+#define SENS_SAR_TSENS_CTRL_REG		0x3c
+
+#define SENS_FORCE_XPD_SAR_SHIFT	29
+#define SENS_FORCE_XPD_SAR_MASK		0x3
+#define SENS_FORCE_XPD_SAR_OFF		1
+#define SENS_FORCE_XPD_SAR_ON		3
+
+#define SENS_PWDET_SAR_POWER_CTRL	BIT(17)
+
+#define SENS_TSENS_CLK_DIV_SHIFT	8
+#define SENS_TSENS_CLK_DIV_MASK		0x3f
+#define SENS_TSENS_POWER_UP		BIT(7)
+#define SENS_TSENS_POWER_UP_FORCE	BIT(6)
+#define SENS_TSENS_DUMP_OUT		BIT(5)
+#define SENS_TSENS_READY		BIT(4)
+#define SENS_TSENS_OUT_MASK		0xf
+
+#define SENS_SARADC_CLK_EN		BIT(19)
+#define SENS_TSENS_CLK_EN		BIT(20)
+
+/* The PHY's own clock divider, from IDF's phy_init.c. */
+#define ESP_PHY_TSENS_CLK_DIV		6
+
+static void __iomem *sens_base;
+static DEFINE_SPINLOCK(phy_lock);
+
+static bool sar_adc_on;
+static bool pwdet_on;
+static bool tsens_on;
+
+static inline u32 sens_read(u32 off)
+{
+	return readl(sens_base + off);
+}
+
+static inline void sens_write(u32 off, u32 val)
+{
+	writel(val, sens_base + off);
+}
+
+static inline void sens_set_bits(u32 off, u32 bits)
+{
+	sens_write(off, sens_read(off) | bits);
+}
+
+static inline void sens_clr_bits(u32 off, u32 bits)
+{
+	sens_write(off, sens_read(off) & ~bits);
+}
+
+/* ------------------------------------------------------------------ */
+/* The three power hooks the PHY calls.                                */
+/* ------------------------------------------------------------------ */
+
+/*
+ * set_xpd_sar -- the SAR ADC's power. IDF's sar_periph_ctrl_pwdet_power_*
+ * also touches the RTC I2C registers, but those are for the ESP32; on the
+ * S3 the SAR ADC's power is this one field. Force-on is 3, force-off is 1,
+ * and 0 hands it back to the automatic controller.
+ */
+void set_xpd_sar(bool en)
+{
+	unsigned long flags;
+	u32 v;
+
+	spin_lock_irqsave(&phy_lock, flags);
+	if (sar_adc_on == en) {
+		spin_unlock_irqrestore(&phy_lock, flags);
+		return;
+	}
+	sar_adc_on = en;
+
+	v = sens_read(SENS_SAR_POWER_XPD_SAR_REG);
+	v &= ~(SENS_FORCE_XPD_SAR_MASK << SENS_FORCE_XPD_SAR_SHIFT);
+	v |= (en ? SENS_FORCE_XPD_SAR_ON : SENS_FORCE_XPD_SAR_OFF)
+	     << SENS_FORCE_XPD_SAR_SHIFT;
+	sens_write(SENS_SAR_POWER_XPD_SAR_REG, v);
+
+	pr_info("SAR ADC power %s (XPD_SAR=0x%08x)\n", en ? "on" : "off", v);
+	spin_unlock_irqrestore(&phy_lock, flags);
+}
+
+void phy_set_pwdet_power(bool en)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&phy_lock, flags);
+	if (pwdet_on == en) {
+		spin_unlock_irqrestore(&phy_lock, flags);
+		return;
+	}
+	pwdet_on = en;
+
+	if (en)
+		sens_set_bits(SENS_SAR_PWDET_CTRL_REG, SENS_PWDET_SAR_POWER_CTRL);
+	else
+		sens_clr_bits(SENS_SAR_PWDET_CTRL_REG, SENS_PWDET_SAR_POWER_CTRL);
+
+	pr_info("power detector %s\n", en ? "on" : "off");
+	spin_unlock_irqrestore(&phy_lock, flags);
+}
+
+/*
+ * phy_set_tsens_power -- the temperature sensor. This one is not a
+ * courtesy call: the PHY uses the die temperature to correct its own
+ * calibration, so it must actually read the sensor, which means
+ * phy_get_tsens_value() below has to return a real number.
+ */
+void phy_set_tsens_power(bool en)
+{
+	unsigned long flags;
+	u32 v;
+
+	spin_lock_irqsave(&phy_lock, flags);
+	if (tsens_on == en) {
+		spin_unlock_irqrestore(&phy_lock, flags);
+		return;
+	}
+	tsens_on = en;
+
+	v = sens_read(SENS_SAR_TSENS_CTRL_REG);
+	v &= ~(SENS_TSENS_CLK_DIV_MASK << SENS_TSENS_CLK_DIV_SHIFT);
+	v |= ESP_PHY_TSENS_CLK_DIV << SENS_TSENS_CLK_DIV_SHIFT;
+	if (en)
+		v |= SENS_TSENS_POWER_UP | SENS_TSENS_POWER_UP_FORCE;
+	else
+		v &= ~(SENS_TSENS_POWER_UP | SENS_TSENS_POWER_UP_FORCE);
+	sens_write(SENS_SAR_TSENS_CTRL_REG, v);
+
+	if (en) {
+		/* The sensor needs its clock; IDF gates it with the SAR
+		 * peripheral clock, which is the same gate the ADC uses.
+		 */
+		sens_set_bits(SENS_SAR_PERI_CLK_GATE_CONF,
+			      SENS_SARADC_CLK_EN | SENS_TSENS_CLK_EN);
+	}
+
+	pr_info("temperature sensor %s (TSENS_CTRL=0x%08x)\n",
+		en ? "on" : "off", v);
+	spin_unlock_irqrestore(&phy_lock, flags);
+}
+
+/*
+ * phy_get_tsens_value -- one raw reading. The S3's sensor is a
+ * successive-approximation loop: raise dump_out, wait for ready, read
+ * out. IDF's temp_sensor_get_raw_value() does exactly this and then
+ * converts; the PHY does its own conversion, so the raw value is what it
+ * wants.
+ */
+int16_t phy_get_tsens_value(void)
+{
+	u32 v;
+	int i;
+
+	if (!sens_base)
+		return 0;
+
+	sens_set_bits(SENS_SAR_TSENS_CTRL_REG, SENS_TSENS_DUMP_OUT);
+	for (i = 0; i < 100; i++) {
+		if (sens_read(SENS_SAR_TSENS_CTRL_REG) & SENS_TSENS_READY)
+			break;
+		udelay(10);
+	}
+	v = sens_read(SENS_SAR_TSENS_CTRL_REG);
+	sens_clr_bits(SENS_SAR_TSENS_CTRL_REG, SENS_TSENS_DUMP_OUT);
+
+	if (i == 100)
+		pr_warn("temperature sensor never became ready\n");
+
+	return (int16_t)(v & SENS_TSENS_OUT_MASK);
+}
+
+/*
+ * set_xpd_sar_amp is the same hook under the name some PHY revisions
+ * call. Both are exported so whichever the archive references resolves.
+ */
+void set_xpd_sar_amp(bool en)
+{
+	set_xpd_sar(en);
+}
+
+/* ------------------------------------------------------------------ */
+/* Critical sections. The PHY takes these around its register          */
+/* sequences. IDF's version is a FreeRTOS spinlock that returns 0;      */
+/* here it is the kernel's interrupt-disable, and the return value is   */
+/* the saved flags, which is what phy_exit_critical gets back.          */
+/* ------------------------------------------------------------------ */
+
+uint32_t phy_enter_critical(void)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	return (uint32_t)flags;
+}
+
+void phy_exit_critical(uint32_t level)
+{
+	local_irq_restore((unsigned long)level);
+}
+
+/* ------------------------------------------------------------------ */
+/* Logging. The PHY library's own printf.                              */
+/* ------------------------------------------------------------------ */
+
+int phy_printf(const char *format, ...)
+{
+	va_list args;
+	char buf[160];
+	int n;
+
+	va_start(args, format);
+	n = vscnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+	pr_info("[phy] %s", buf);
+	return n;
+}
+
+int rtc_printf(const char *format, ...)
+{
+	va_list args;
+	char buf[160];
+	int n;
+
+	va_start(args, format);
+	n = vscnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+	pr_info("[rtc] %s", buf);
+	return n;
+}
+
+/*
+ * The coexistence layer's log shim.
+ *
+ * libcoexist.a calls this from coexist_api.o, coexist_core.o,
+ * coexist_param.o and coexist_scheme.o, and does not define it. It is not
+ * in the ROM either -- esp32s3.rom.ld has no such name.
+ *
+ * It is defined here rather than pulled from IDF's libesp_phy.a, which
+ * does have it, for two reasons.
+ *
+ * The first is that libesp_phy.a's lib_printf.c.obj defines the whole
+ * family -- phy_printf, rtc_printf, wpa_printf, wpa2_printf, wps_printf,
+ * pp_printf, sc_printf, core_printf, net80211_printf, wapi_printf,
+ * mesh_printf and coexist_printf -- as global symbols in one object file,
+ * and the linker pulls a whole member at a time. Two of them, phy_printf
+ * and rtc_printf, are already defined above, so linking the archive is a
+ * multiple definition error. That is what the first attempt at this hit.
+ *
+ * The second is that the archive's version does not log. All twelve are
+ * identical trampolines into a local clone, lib_printf$constprop$0, which
+ * formats into a 79-byte stack buffer and returns -- it never writes the
+ * buffer anywhere. coexist_printf there is format-and-discard. The body
+ * below goes to pr_info like its two neighbours, so the coexistence
+ * layer's messages reach the kernel log instead of a dead stack buffer.
+ *
+ * The counter is here for the hang. coexist_printf is the coexistence
+ * layer's only way to speak, so a numbered line is a position marker: if
+ * the boot stops after "[coex 7] ...", the call that never returned is
+ * the one that would have printed 8. Without it a hang in libcoexist.a
+ * is silent, because the library has no other output.
+ */
+static unsigned int coex_printf_calls;
+
+int coexist_printf(const char *format, ...)
+{
+	va_list args;
+	char buf[160];
+	int n;
+
+	va_start(args, format);
+	n = vscnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+	pr_info("[coex %u] %s", ++coex_printf_calls, buf);
+	return n;
+}
+
+/* ------------------------------------------------------------------ */
+/* Bring-up.                                                           */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The PHY's own init entry point, from libphy.a. It is what IDF's
+ * esp_phy_init() calls after it has copied the PHY init data out of the
+ * phy_init partition. The signature is IDF's, from
+ * esp_phy/include/esp_phy_init.h, with the calibration-data structs
+ * passed as opaque pointers because this port does not include IDF's
+ * headers.
+ */
+extern int register_chipv7_phy_init_param(void *param, void *cal_data,
+					  bool full_cal);
+
+/*
+ * The PHY needs the ROM's own function table before anything else: it
+ * reads the pointer at phy_get_romfuncs() and calls through it for the
+ * low-level analog access. On the ROM this is initialised by the ROM's
+ * startup, so it is already valid by the time Linux runs. Reading it back
+ * is the cheapest possible check that the ROM is where the linker script
+ * says it is, and that this kernel can reach it.
+ */
+typedef void *(*phy_get_romfuncs_fn)(void);
+
+void esp32_wifi_phy_check_rom(void)
+{
+	phy_get_romfuncs_fn fn = (phy_get_romfuncs_fn)0x40005c58;
+	void *rom = fn();
+
+	pr_info("ROM phy funcs at %p (phy_get_romfuncs=0x40005c58)\n", rom);
+	if (!rom)
+		pr_err("ROM returned a NULL phy func table; the PHY cannot run\n");
+}
+
+/*
+ * The PHY's calibration data. IDF keeps this in a 1904-byte blob in the
+ * phy_init partition and hands the pointer to esp_phy_init(); the PHY
+ * library writes its calibration results back into it and reads them on
+ * the next boot to skip a full recalibration. Nothing on this board
+ * carries that partition, so the buffer is ours: zeroed, which the PHY
+ * reads as "no valid calibration" and answers with a full one.
+ *
+ * register_chipv7_phy_init_param() takes it as its second argument. The
+ * size is IDF's PHY_RF_CAL_PART_LEN for the S3.
+ */
+#define PHY_RF_CAL_DATA_LEN	1904
+
+static u8 phy_rf_cal_data[PHY_RF_CAL_DATA_LEN] __aligned(4);
+
+/*
+ * The PHY init data. register_chipv7_phy_init_param() reads up to byte
+ * 76 of this with no validation, so 112 bytes is IDF's length with room
+ * past the highest byte it touches. See the comment at the call site.
+ */
+#define PHY_INIT_DATA_LEN	112
+
+static const u8 phy_init_data[PHY_INIT_DATA_LEN] __aligned(4) = {
+	0x00, 0x00, 0x50, 0x50, 0x50, 0x4c, 0x4c, 0x48, 0x4c, 0x48, 0x48, 0x44,
+	0x4a, 0x46, 0x46, 0x42, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff,
+	0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+	0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+	0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+	0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x74,
+};
+
+int esp32_wifi_phy_init(void)
+{
+	int ret;
+
+	if (!sens_base) {
+		sens_base = ioremap(ESP32_SENS_BASE, 0x100);
+		if (!sens_base) {
+			pr_err("ioremap(0x%x) failed\n", ESP32_SENS_BASE);
+			return -ENOMEM;
+		}
+	}
+
+	pr_info("SENS at %p, XPD_SAR=0x%08x TSENS_CTRL=0x%08x PWDET=0x%08x\n",
+		sens_base,
+		sens_read(SENS_SAR_POWER_XPD_SAR_REG),
+		sens_read(SENS_SAR_TSENS_CTRL_REG),
+		sens_read(SENS_SAR_PWDET_CTRL_REG));
+	esp32_wifi_phy_check_rom();
+
+	/*
+	 * Run the PHY's own bring-up. This is the call the whole file exists
+	 * for and it was missing: everything above is preparation, and
+	 * without this the radio is never calibrated and never enabled.
+	 *
+	 * It is the host's job, not the blob's. Traced through the linked
+	 * image, register_chipv7_phy() has no caller anywhere -- the Wi-Fi
+	 * task's init path (esp_wifi_init_internal -> wifi_init_in_caller_task
+	 * -> ic_create_wifi_task -> pp_create_task) only creates the task and
+	 * returns, and wifi_init_process(), which does reach ic_init ->
+	 * hal_init, runs later inside that task and expects the PHY to be up
+	 * already. IDF's esp_phy_init() is what calls this, and IDF's
+	 * esp_phy_init() is the host.
+	 *
+	 * The first argument is the PHY init data, and it is NOT optional.
+	 *
+	 * An earlier version passed NULL, on the theory that the function
+	 * falls back to a default table. That fallback belongs to
+	 * register_chipv7_phy(), a different function this port does not
+	 * call. register_chipv7_phy_init_param() dereferences its first
+	 * argument at +0x46 with no check of any kind:
+	 *
+	 *     423a5176:  l8ui a8, a2, 0        ; a2 is the first argument
+	 *
+	 * With NULL the load faults at excvaddr 0. The function has no
+	 * magic compare, no CRC and no error return path; it reads the
+	 * table and returns. Function size is 0x12f, the last read is
+	 * a2[76] at 423a5257, then retw.n -- so the argument must point at
+	 * at least 77 readable bytes.
+	 *
+	 * The blob builds its own 14-byte table at a1+2..a1+15 before it
+	 * reads a2 (423a5140..423a5173):
+	 *
+	 *     52 52 50 4c 4c 48 4c 48 48 46 4a 46 46 44
+	 *
+	 * That table is a CAP, not a default. The loop at 423a5195 clamps
+	 * the caller's value down to it (bge a13, a3, skip / s8i a13, a8,
+	 * 244), so passing the blob's own table would make every value
+	 * equal its own cap and the loop a no-op.
+	 *
+	 * This is IDF's phy_init_data for the S3, from
+	 * components/esp_phy/esp32s3/include/phy_init_data.h, with
+	 * CONFIG_ESP_PHY_MAX_TX_POWER=20 so LIMIT(20*4, 0, cap) gives the
+	 * caps below. The board has no phy_init partition, so the table is
+	 * compiled in rather than read from flash. IDF's esp_phy_init()
+	 * passes this same table on a real system.
+	 *
+	 * The third argument is the calibration mode. 1 is PHY_RF_CAL_FULL,
+	 * which is what IDF uses on a first boot with no stored calibration
+	 * and what TheButlah's bare-metal S3 port passes.
+	 */
+	ret = register_chipv7_phy_init_param((void *)phy_init_data,
+					     phy_rf_cal_data, true);
+	pr_info("register_chipv7_phy_init_param -> %d\n", ret);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+void esp32_wifi_phy_deinit(void)
+{
+	if (sens_base) {
+		if (sar_adc_on)
+			set_xpd_sar(false);
+		if (pwdet_on)
+			phy_set_pwdet_power(false);
+		if (tsens_on)
+			phy_set_tsens_power(false);
+		iounmap(sens_base);
+		sens_base = NULL;
+	}
+}
+
+/*
+ * phy_get_romfuncs, rom_phy_param_addr and rom_rx_gain_force are ROM
+ * addresses, not code to write. esp32s3.rom.ld names them --
+ * 0x40005c58, 0x40006324 and 0x4000642c -- and the ROM is mapped at boot,
+ * so the linker needs the names bound to those addresses and nothing
+ * more. The kernel's linker script has no such symbols, so this patch
+ * binds them in arch/xtensa/kernel/vmlinux.lds.S instead, where an
+ * absolute assignment costs nothing and produces no code. There are
+ * deliberately no definitions here: a C definition would be a second
+ * symbol of the same name and the link would fail on the duplicate.
+ */
+
