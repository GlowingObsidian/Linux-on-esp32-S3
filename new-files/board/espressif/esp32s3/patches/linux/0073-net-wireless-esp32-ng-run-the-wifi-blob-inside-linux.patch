+/* ------------------------------------------------------------------ */
+/* Logging. Every wrapper that is not obviously trivial says so once.  */
+/* ------------------------------------------------------------------ */
+
+static bool osi_log_once[128];
+static DEFINE_SPINLOCK(osi_log_lock);
+
+/*
+ * The range a handle from this port can legitimately have. Defined here
+ * rather than beside osi_handle_bad() because the fault dump below
+ * prints them, and that dump sits above it in the file.
+ */
+#define OSI_HANDLE_LO	0x3d800000UL	/* the memory node's own start */
+#define OSI_HANDLE_HI	0x80000000UL	/* above all kernel virtual */
+
+static void osi_note(const char *what)
+{
+	unsigned long flags;
+	u32 h = 0;
+	const char *p;
+
+	for (p = what; *p; p++)
+		h = h * 31 + *p;
+	h &= 127;
+
+	spin_lock_irqsave(&osi_log_lock, flags);
+	if (!osi_log_once[h]) {
+		osi_log_once[h] = true;
+		spin_unlock_irqrestore(&osi_log_lock, flags);
+		pr_info("osi: %s (first call)\n", what);
+		return;
+	}
+	spin_unlock_irqrestore(&osi_log_lock, flags);
+}
+
+/*
+ * A fault-time dump the generic Oops does not give us.
+ *
+ * show_regs on xtensa prints pc, ps, depc, excvaddr and the register
+ * file, and that is all. It does not print exccause, which is the field
+ * that says WHAT kind of fault it was, and it does not print
+ * windowbase/windowstart, which say whether the fault was taken inside
+ * a rotated register window -- the difference between "a store went to
+ * a bad address" and "the window spill itself went to a bad address".
+ *
+ * Both of those were needed to read the crash this driver first
+ * produced and neither was available, so the reading was guesswork for
+ * several rounds. This prints them, resolves pc and ra to symbols with
+ * %pS, and reports the OSI handle bounds so a rejected handle can be
+ * checked against them from the log alone.
+ *
+ * It runs from a die notifier, so it prints before the panic and
+ * whatever the fault path prints afterwards still follows it.
+ */
+
+/*
+ * The ROM pointer slots the blob reads but nothing populates.
+ *
+ * Declared before the die notifier, not after it, because the notifier
+ * calls osi_rom_slots_dump() and a static function has to be defined or
+ * declared before its first use. struct esp_wifi_blob -- which owns the
+ * mappings -- is defined further down the file, so a file-scope array is
+ * the only way both the notifier and the probe can see them without
+ * moving the struct.
+ *
+ * The probe ioremaps each slot and records it here. The notifier then
+ * prints the live value of every one at the instant of a fault, which is
+ * the one moment a pre-boot read cannot cover: by the time the board is
+ * dead, the shell that would have read the slot is gone.
+ */
+#define OSI_ROM_SLOT_NR	5
+
+static void __iomem *osi_rom_slots[OSI_ROM_SLOT_NR];
+
+static const char * const osi_rom_slot_names[OSI_ROM_SLOT_NR] = {
+	"xphyQueue",
+	"s_pp_task_create_sem",
+	"s_pp_task_del_sem",
+	"pp_task_hdl",
+	"s_wifi_queue",
+};
+
+static void osi_rom_slots_dump(const char *tag)
+{
+	int i;
+
+	for (i = 0; i < OSI_ROM_SLOT_NR; i++) {
+		if (!osi_rom_slots[i])
+			continue;
+		pr_emerg("osi: ROM slot %s at %s = %08x\n",
+			 osi_rom_slot_names[i], tag,
+			 readl(osi_rom_slots[i]));
+	}
+}
+
+static int osi_die_notifier(struct notifier_block *nb, unsigned long val,
+			    void *data)
+{
+	struct die_args *args = data;
+	struct pt_regs *regs = args->regs;
+	unsigned long exccause, wb, ws;
+
+	if (!regs)
+		return NOTIFY_DONE;
+
+	/* exccause is not in pt_regs on all builds; read it live. The
+	 * register still holds the cause of the fault we are inside.
+	 */
+	__asm__ __volatile__("rsr %0, exccause" : "=r"(exccause));
+	__asm__ __volatile__("rsr %0, windowbase" : "=r"(wb));
+	__asm__ __volatile__("rsr %0, windowstart" : "=r"(ws));
+
+	pr_emerg("osi: fault: exccause=%lu (%s) windowbase=%lu windowstart=%08lx\n",
+		 exccause,
+		 exccause == 29 ? "STORE_CACHE_ATTRIBUTE" :
+		 exccause == 28 ? "LOAD_CACHE_ATTRIBUTE" :
+		 exccause == 24 ? "DTLB_MISS" :
+		 exccause == 16 ? "ITLB_MISS" :
+		 exccause == 9  ? "UNALIGNED" :
+		 exccause == 6  ? "INTEGER_DIVIDE_BY_ZERO" :
+		 exccause == 0  ? "ILLEGAL_INSTRUCTION" : "other",
+		 wb, ws);
+	pr_emerg("osi: fault: pc=%08lx %pS\n", regs->pc, (void *)regs->pc);
+	pr_emerg("osi: fault: ra=%08lx %pS\n",
+		 regs->areg[0] & 0x3fffffff,
+		 (void *)(regs->areg[0] & 0x3fffffff));
+	pr_emerg("osi: fault: excvaddr=%08lx a1=%08lx a2=%08lx a3=%08lx a4=%08lx\n",
+		 regs->excvaddr, regs->areg[1], regs->areg[2],
+		 regs->areg[3], regs->areg[4]);
+	pr_emerg("osi: fault: handle window [%08lx, %08lx)\n",
+		 (unsigned long)OSI_HANDLE_LO, (unsigned long)OSI_HANDLE_HI);
+
+	/* The ROM slots as they stand at the fault. This is the only
+	 * moment they can be read: the board does not survive to a shell,
+	 * so a value the blob wrote on its way down is visible nowhere
+	 * else. Pair it with `echo "write <addr> <value>" > /dev/esp32-regs`
+	 * to test whether a slot's contents change the outcome.
+	 */
+	osi_rom_slots_dump("die");
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block osi_die_nb = {
+	.notifier_call = osi_die_notifier,
+};
+
+/* ------------------------------------------------------------------ */
+/* Memory. The blob allocates through these and frees through _free.   */
+/* ------------------------------------------------------------------ */
+
+/* The bytes this layer has handed to the blob and not yet taken back. */
+/* osi_get_free_heap_size subtracts it, so the figure the blob sees is  */
+/* the pool it actually allocates from rather than the whole free page  */
+/* pool.                                                                */
+static atomic64_t osi_heap_used = ATOMIC64_INIT(0);
+
+static void osi_heap_track(s64 delta)
+{
+	atomic64_add(delta, &osi_heap_used);
+}
+
+/* A zero-byte kmalloc does not return NULL. It returns ZERO_SIZE_PTR,  */
+/* which is the constant (void *)16, and every later dereference of it  */
+/* faults at a low address. The blob's own allocator callers never ask  */
+/* for zero (the smallest literal size any of them passes is 8), so a   */
+/* zero here means the size arrived from a field this port has not      */
+/* filled in, or from a structure the blob laid out differently than    */
+/* the port believes. Substitute one byte so the allocation is real and */
+/* the blob keeps running, and name the caller so the source is         */
+/* identifiable from a single boot log.                                 */
+#define OSI_ALLOC_SIZE(size)						\
+	((size) ? (size) : (pr_err("osi: zero-size alloc from %pS\n",	\
+				   __builtin_return_address(0)), 1UL))
+
+static void *osi_malloc(size_t size)
+{
+	void *p = kmalloc(OSI_ALLOC_SIZE(size), GFP_ATOMIC);
+
+	if (!p) {
+		pr_err("osi: kmalloc(%zu) failed\n", size);
+		return NULL;
+	}
+	osi_heap_track(ksize(p));
+	return p;
+}
+
+static void osi_free(void *p)
+{
+	if (!p)
+		return;
+	osi_heap_track(-(s64)ksize(p));
+	kfree(p);
+}
+
+static void *osi_zalloc(size_t size)
+{
+	void *p = kzalloc(OSI_ALLOC_SIZE(size), GFP_ATOMIC);
+
+	if (p)
+		osi_heap_track(ksize(p));
+	return p;
+}
+
+static void *osi_realloc(void *ptr, size_t size)
+{
+	size_t before = ptr ? ksize(ptr) : 0;
+	void *p = krealloc(ptr, OSI_ALLOC_SIZE(size), GFP_ATOMIC);
+
+	if (p)
+		osi_heap_track((s64)ksize(p) - (s64)before);
+	return p;
+}
+
+static void *osi_calloc(size_t n, size_t size)
+{
+	void *p = kcalloc(n ? n : 1, OSI_ALLOC_SIZE(size), GFP_ATOMIC);
+
+	if (p)
+		osi_heap_track(ksize(p));
+	return p;
+}
+
+/* IDF's slot is esp_get_free_internal_heap_size, which answers        */
+/* "how much 8-bit, DMA-capable, internal-SRAM heap is left" -- the    */
+/* pool the blob's own buffers come from. si_meminfo's freeram is the  */
+/* whole free page pool (~7.8 MiB here) and is uncorrelated with       */
+/* whether a DMA-capable allocation will succeed, so the blob was      */
+/* told there was room and then failed its allocations. The honest     */
+/* answer for this port is the free size of the same pool osi_malloc   */
+/* draws from, minus what this layer has already handed out.           */
+
+static uint32_t osi_get_free_heap_size(void)
+{
+	s64 used = atomic64_read(&osi_heap_used);
+	u64 free = (u64)global_zone_page_state(NR_FREE_PAGES) * PAGE_SIZE;
+
+	/* A double free would drive the counter negative; clamp rather than
+	 * wrap, so the blob never sees an absurd figure.
+	 */
+	if (used < 0)
+		used = 0;
+	if ((u64)used >= free)
+		return 0;
+	return (uint32_t)(free - (u64)used);
+}
+
+/* ------------------------------------------------------------------ */
+/* Mutexes. The blob's mutexes are recursive, because the Wi-Fi code    */
+/* takes the same lock from nested paths. Linux's are not, so a        */
+/* recursive wrapper is needed: owner plus a count.                    */
+/* ------------------------------------------------------------------ */
+
+struct osi_mutex {
+	struct mutex lock;
+	struct task_struct *owner;
+	int count;
+};
+
+/* Every handle the blob hands back to this layer is one of our own
+ * kmalloc'd objects, so a handle that is not one of ours is a bug
+ * somewhere above and passing it on to mutex_lock()/spin_lock() faults
+ * deep inside the lock code with no indication of which call site was
+ * at fault. This check exists to make that failure name itself.
+ *
+ * An earlier version of it bounded the handle to the device tree's
+ * memory node -- 0x3d800000 for 0x00800000, ending at 0x3e000000
+ * (arch/xtensa/boot/dts/arduino-nano-esp32.dts) -- on the reasoning
+ * that this port has a single memory node so nothing we allocate can
+ * fall outside it. That reasoning was wrong, and the boot log proved
+ * it: _spin_lock_create returned a pointer, the blob stored it in the
+ * ROM global g_intr_lock_mux (0x3fcef920, internal SRAM 1 block 8),
+ * read it back unchanged, and _wifi_int_disable then rejected it as a
+ * bad handle. The window was the wrong test. Internal SRAM is not in
+ * the device tree because Linux does not own it, but the blob's own
+ * ROM globals live there and the pointer round-trips through them
+ * perfectly well.
+ *
+ * So the test is now what it should always have been: is this address
+ * one this layer could have returned? Kmalloc only ever hands back
+ * kernel virtual addresses, which on this NOMMU port is the one
+ * direct-mapped region the memory node describes. The bound is kept
+ * only as a sanity floor and ceiling around the whole of RAM rather
+ * than around a single node, so a pointer into the ROM globals is
+ * accepted and a wild one is still caught.
+ *
+ * The floor is the memory node's own start, 0x3d800000, and getting it
+ * wrong twice is worth recording.
+ *
+ * The first version bounded the handle to the node -- 0x3d800000 to
+ * 0x3e000000 -- and the boot log showed _spin_lock_create's pointer
+ * being rejected after it had round-tripped through the blob's ROM
+ * global g_intr_lock_mux (0x3fcef920, internal SRAM 1 block 8), which
+ * is above the node because Linux does not own it. So the floor was
+ * raised to 0x3f000000 to admit 0x3fcef920.
+ *
+ * That was worse, and the next boot log said so in one line:
+ *
+ *     osi: _mutex_create -> 3d9a16a0 (caller osi_recursive_mutex_create)
+ *     osi: _mutex_lock(3d9a16a0) task swapper/0 caller wifi_api_lock+0x40
+ *     osi: _mutex_lock: bad handle 3d9a16a0 (caller osi_mutex_lock+0x48)
+ *
+ * 0x3d9a16a0 is a mutex this layer created one line earlier, and it was
+ * rejected. This port's kmalloc'd objects live in PSRAM at 0x3d8xxxxx
+ * to 0x3d9xxxxx, because the memory node IS the PSRAM. Raising the
+ * floor above the node did not widen the window, it cut the whole
+ * kernel heap out of it, and every handle this layer had ever returned
+ * was then refused: _mutex_lock answered pdFALSE for mutexes it had
+ * created itself, _semphr_take and _semphr_give answered pdFALSE for
+ * the wifi task's own semaphore, and _wifi_int_disable fell back to
+ * local_irq_save on a spinlock it had created.
+ *
+ * What that produced is worth recording accurately, because the first
+ * version of this comment got it wrong twice. The crash was
+ *
+ *     Unable to handle kernel paging request at virtual address fffffff4
+ *      pc = 421699ec, ra = 8216a51c
+ *
+ * and 0xfffffff4 is NULL - 12. An earlier version of this comment read
+ * 0x421699ec as init_wait_var_entry and 0x4216a51c as finish_wait. Both
+ * were wrong, and both were wrong because they were resolved against a
+ * System.map from a different build. Against the map of the image that
+ * actually ran, the two are
+ *
+ *     421699dc <__add_wait_queue>:
+ *     421699df:  l32i.n a8, a2, 0     a8 = list->next
+ *     421699e3:  addi   a8, a8, -12   a8 = entry - 12
+ *     421699ec:  l32i.n a12, a8, 0    <-- the fault
+ *
+ * and
+ *
+ *     4216a515:  mov.n  a11, a3       a11 = wq_entry
+ *     4216a517:  mov.n  a10, a7       a10 = wq_head
+ *     4216a519:  call8  421699dc <__add_wait_queue>
+ *     4216a51c:  extui  a8, a1, 0, 13 <-- ra
+ *
+ * so the fault is __add_wait_queue+0x10 loading from a8 = 0xfffffff4,
+ * and since __add_wait_queue subtracts 12 from the list head it is
+ * given, the wait_queue_entry it walked to was 0xffffffe8 = NULL - 24.
+ * The caller is prepare_to_wait_event+0x48, whose call at +0x45 is the
+ * one into __add_wait_queue.
+ *
+ * prepare_to_wait_event is reached from the ___wait_event macro, which
+ * is expanded inline at the port's three wait_event_killable_timeout
+ * sites -- osi_queue_send_wait, osi_queue_recv and
+ * osi_event_group_wait_bits. Each has the same four calls inlined
+ * (init_wait_entry, prepare_to_wait_event, schedule_timeout,
+ * finish_wait) and each l32r resolves to the same address, so all three
+ * are reachable and only the sp print says which one faulted.
+ *
+ * An earlier version of this comment named ___down_common as the
+ * caller. That was wrong: ___down_common calls sem_del_waiter and
+ * schedule_timeout and never prepare_to_wait_event. It was asserted
+ * from the down path being plausible, not read from the disassembly.
+ *
+ * ___wait_event declares its wait_queue_entry on the enclosing frame
+ * and passes its address, so an entry of NULL - 24 means that frame's
+ * stack pointer is wrong. The oops frame is not self-consistent
+ * (depc = 0x1c is not a code address, lbeg = 0x423ad572 is in
+ * .rodata), so it cannot name the caller; the sp print can.
+ *
+ * The window has to cover both ends at once, so it is the node's floor
+ * with the ROM globals' ceiling: everything from the bottom of PSRAM to
+ * the top of kernel virtual. A wild pointer is still caught at either
+ * end, and both real kinds of handle -- heap in PSRAM, ROM global in
+ * internal SRAM -- are inside it. */
+
+/*
+ * The bounds are read through a volatile pointer, and that is not
+ * decoration.
+ *
+ * Written as plain constants the comparison folded away. In the shipped
+ * vmlinux every call site compiled to
+ *
+ *     l32r  a8, 0x3effffff      ; OSI_HANDLE_HI - 1
+ *     addi.n a8, a8, -1
+ *     neg   a8, a8
+ *     extui a8, a8, 0, 8
+ *     bgez  a2, <ok>            ; the ONLY test left
+ *
+ * -- the upper bound reduced to a constant that made its own branch
+ * dead, and the lower bound disappeared entirely, so the check that
+ * remained was "is this pointer negative". A handle of 0x10 and a
+ * handle of 0x3d9a16a0 both passed it. The source and the binary
+ * disagreed, and the binary is what ran.
+ *
+ * Reading through volatile forces both comparisons to be emitted. This
+ * costs one load per handle check on a path that already takes a printk
+ * when it fails, and it is the difference between the guard existing
+ * and the guard being a comment.
+ */
+static const unsigned long osi_handle_lo_const = OSI_HANDLE_LO;
+static const unsigned long osi_handle_hi_const = OSI_HANDLE_HI;
+
+static bool osi_handle_bad(const void *p)
+{
+	unsigned long v = (unsigned long)p;
+	unsigned long lo = *(volatile const unsigned long *)&osi_handle_lo_const;
+	unsigned long hi = *(volatile const unsigned long *)&osi_handle_hi_const;
+
+	return v < lo || v >= hi;
+}
+
+static void osi_handle_warn(const char *what, const void *p)
+{
+	pr_err("osi: %s: bad handle %p (caller %pS)\n", what, p,
+	       __builtin_return_address(0));
+}
+
+static void *osi_mutex_create(void)
+{
+	struct osi_mutex *m = kzalloc(sizeof(*m), GFP_KERNEL);
+
+	if (!m)
+		return NULL;
+	mutex_init(&m->lock);
+	pr_info("osi: _mutex_create -> %p (caller %pS)\n", m,
+		__builtin_return_address(0));
+	return m;
+}
+
+static void *osi_recursive_mutex_create(void)
+{
+	return osi_mutex_create();
+}
+
+/* vSemaphoreDelete, which is what IDF binds to _mutex_delete.           */
+/*                                                                        */
+/* A mutex that is still held is NOT freed. Freeing it is what the crash  */
+/* this was written for looks like: the blob deletes a mutex, the block   */
+/* goes back to the allocator, something else takes it, and the next      */
+/* _mutex_lock on the stale handle runs the kernel's mutex slowpath on a  */
+/* wait_list that is no longer a list -- which faults inside list_add     */
+/* with excvaddr 0xfffffff4, exactly the address a NULL next->prev gives. */
+/*                                                                        */
+/* IDF's vSemaphoreDelete does not check either, but a FreeRTOS semaphore */
+/* carries its own holder and a delete of a held one is a configASSERT    */
+/* failure in a debug build. There is no such assert here, so the check   */
+/* is written out: an owned mutex is left alone and says so.              */
+static void osi_mutex_delete(void *mutex)
+{
+	struct osi_mutex *m = mutex;
+
+	pr_info("osi: _mutex_delete(%p) task %s caller %pS\n", m, current->comm,
+		__builtin_return_address(0));
+
+	if (!m)
+		return;
+	if (osi_handle_bad(m)) {
+		osi_handle_warn("_mutex_delete", m);
+		return;
+	}
+	if (m->owner) {
+		pr_err("osi: _mutex_delete(%p) refused: still held by %s (count %d)\n",
+		       m, m->owner->comm, m->count);
+		return;
+	}
+	kfree(m);
+}
+
+/* FreeRTOS's pdTRUE/pdFALSE, as in the semaphore block below: the     */
+/* blob reads xSemaphoreTake's result for a mutex too, so 1 means      */
+/* locked and 0 means not. The macros are defined further down, in the */
+/* semaphore section, and this block is above it, so the literals are  */
+/* used here with the meaning spelled out.                             */
+static int32_t osi_mutex_lock(void *mutex)
+{
+	struct osi_mutex *m = mutex;
+
+	/* Every lock and unlock is named while the port is being brought
+	 * up. The crash this was written for is a fault inside the kernel's
+	 * own mutex slowpath, on a mutex whose wait_list is not a valid
+	 * list, and the only way to tell which mutex that is -- and whether
+	 * the lock and unlock calls for it pair up -- is to print the
+	 * handle and the blob call site on both sides. %pS resolves through
+	 * kallsyms, which is on, so the call site is a name and not an
+	 * address to look up by hand.
+	 *
+	 * The handle is printed raw. It is one of this layer's own
+	 * kmalloc'd objects, so it is a kernel virtual address, and the
+	 * whole point is to see whether the same one comes back.
+	 */
+	pr_info("osi: _mutex_lock(%p) task %s caller %pS\n", m, current->comm,
+		__builtin_return_address(0));
+
+	if (!m)
+		return 0;		/* pdFALSE */
+	if (osi_handle_bad(m)) {
+		osi_handle_warn("_mutex_lock", m);
+		return 0;		/* pdFALSE */
+	}
+	if (m->owner == current) {
+		m->count++;
+		return 1;		/* pdTRUE */
+	}
+	mutex_lock(&m->lock);
+	m->owner = current;
+	m->count = 1;
+	return 1;			/* pdTRUE */
+}
+
+static int32_t osi_mutex_unlock(void *mutex)
+{
+	struct osi_mutex *m = mutex;
+	int32_t ret;
+
+	pr_info("osi: _mutex_unlock(%p) task %s caller %pS\n", m, current->comm,
+		__builtin_return_address(0));
+
+	if (!m)
+		return 0;		/* pdFALSE */
+	if (osi_handle_bad(m)) {
+		osi_handle_warn("_mutex_unlock", m);
+		return 0;		/* pdFALSE */
+	}
+	/* An unlock from a task that does not hold the mutex is refused,
+	 * the way xSemaphoreGiveRecursive refuses it, and the refusal is
+	 * loud: it means the blob's lock and unlock calls for this mutex
+	 * did not pair up, which is the failure that leaves a mutex the
+	 * blob believes it holds actually free.
+	 */
+	if (m->owner != current) {
+		pr_err("osi: _mutex_unlock(%p) refused: owner %s, caller %s\n",
+		       m, m->owner ? m->owner->comm : "none", current->comm);
+		return 0;		/* pdFALSE */
+	}
+	ret = 1;			/* pdTRUE */
+	if (--m->count == 0) {
+		m->owner = NULL;
+		mutex_unlock(&m->lock);
+	}
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* The blob's time unit is a FreeRTOS tick, and a tick is NOT a        */
+/* millisecond. IDF builds FreeRTOS at CONFIG_FREERTOS_HZ 100           */
+/* (freertos/Kconfig:31-34), so portTICK_PERIOD_MS is 1000/100 = 10,    */
+/* and every tick argument the blob passes means ten milliseconds.      */
+/*                                                                     */
+/* Getting this wrong is not a rounding error: a 10 ms timeout becomes  */
+/* a 10 ms timeout only if the divisor is applied, and a 1000-tick      */
+/* wait becomes one second instead of ten. The blob's own              */
+/* _task_ms_to_tick is the authority -- IDF's wrapper is                */
+/* `return (int32_t)(ms / portTICK_PERIOD_MS);` -- so this file        */
+/* applies the same divisor everywhere a tick count crosses into a      */
+/* Linux wait.                                                          */
+/* ------------------------------------------------------------------ */
+
+/* FreeRTOS ticks to Linux jiffies, and ticks to microseconds. */
+#define OSI_TICK_PERIOD_MS	10
+#define OSI_TICKS_TO_JIFFIES(t)	msecs_to_jiffies((t) * OSI_TICK_PERIOD_MS)
+#define OSI_TICKS_TO_US(t)	((t) * OSI_TICK_PERIOD_MS * 1000)
+
+/* ------------------------------------------------------------------ */
+/* Semaphores. Counting, with a tick-based timeout.                    */
+/*                                                                     */
+/* THE RETURN VALUES ARE FreeRTOS's, NOT LINUX's. This is the single   */
+/* most important thing in this file and it is easy to get wrong,      */
+/* because the natural thing to write is the Linux convention.         */
+/*                                                                     */
+/* The blob is compiled against FreeRTOS and reads every one of these  */
+/* as a BaseType_t: pdTRUE (1) for success, pdFALSE (0) for failure.   */
+/* IDF's own adapter is the authority -- esp_coex_adapter.c's          */
+/* esp_coex_common_semphr_take_wrapper is literally                    */
+/* `return (int32_t)xSemaphoreTake(semphr, block_time_tick);`, and     */
+/* projdefs.h defines pdTRUE 1 / pdFALSE 0.                            */
+/*                                                                     */
+/* Returning 0 for success instead of 1 is not a cosmetic difference.  */
+/* coex_core_lock in libcoexist.a computes `neg (take_result != 1)`,   */
+/* so a successful take reported as 0 reads as failure, and            */
+/* coex_pre_init returns -1 before it ever reaches                     */
+/* coex_rom_osi_funcs_init. That is exactly the board symptom this     */
+/* comment was written for.                                            */
+/* ------------------------------------------------------------------ */
+
+/* FreeRTOS's two boolean results, named so the intent is visible at   */
+/* every return below rather than a bare 0 or 1.                       */
+#define OSI_PD_TRUE	1
+#define OSI_PD_FALSE	0
+
+struct osi_sem {
+	struct semaphore sem;
+	u32 max;
+};
+
+static void *osi_semphr_create(uint32_t max, uint32_t init)
+{
+	struct osi_sem *s = kzalloc(sizeof(*s), GFP_KERNEL);
+
+	if (!s)
+		return NULL;
+	sema_init(&s->sem, init);
+	s->max = max;
+	/* Paired with the blocking-take print. If a take comes back with a
+	 * count or a first_waiter that does not match what was created here,
+	 * the object was overwritten between the two, and this line is the
+	 * only record of what it held when it was made.
+	 */
+	pr_info("osi: _semphr_create(%u, %u) -> %p count=%u\n",
+		max, init, s, s->sem.count);
+	return s;
+}
+
+static void osi_semphr_delete(void *semphr)
+{
+	kfree(semphr);
+}
+
+static int32_t osi_semphr_take(void *semphr, uint32_t ticks)
+{
+	struct osi_sem *s = semphr;
+
+	if (!s)
+		return OSI_PD_FALSE;
+	/* A handle outside the kernel's own RAM is not ours to dereference.
+	 * Without this the blob's bad pointer reached down_interruptible and
+	 * faulted in __down with nothing naming the caller -- see the
+	 * _wifi_thread_semphr_get comment above for how one got here.
+	 */
+	if (osi_handle_bad(s)) {
+		osi_handle_warn("semphr_take", s);
+		return OSI_PD_FALSE;
+	}
+	/* The blocking take must NOT be interruptible.
+	 *
+	 * IDF's wrapper is xSemaphoreTake(handle, portMAX_DELAY), and a
+	 * portMAX_DELAY take in FreeRTOS cannot fail: xQueueSemaphoreTake
+	 * only reaches its errQUEUE_EMPTY returns through
+	 * xTaskCheckForTimeOut, and that function's first branch is
+	 * `if (*pxTicksToWait == portMAX_DELAY) return pdFALSE;` -- "never
+	 * time out" (tasks.c). So the call blocks until it takes the
+	 * semaphore and returns pdPASS. There is no -EINTR equivalent.
+	 *
+	 * down_interruptible() does have one, and that is the whole bug.
+	 * A pending signal makes it return -EINTR, which this function
+	 * turned into pdFALSE (0). coex_core_lock is the caller that
+	 * notices: it computes `neg (take_result != 1)` and returns -1 for
+	 * anything that is not exactly 1, and coex_core_pre_init propagates
+	 * that -1 straight out. The board printed "coex_pre_init: -1" for
+	 * that reason, and every coex lock/unlock after it was broken too.
+	 *
+	 * down_killable is the right primitive rather than plain down():
+	 * it ignores ordinary signals, so it matches FreeRTOS's
+	 * uninterruptible blocking, but it still returns -EINTR for
+	 * SIGKILL, so a wedged blob cannot make the task unkillable. The
+	 * one case it can still fail is the one case where the process is
+	 * being torn down anyway, and returning pdFALSE there is correct.
+	 */
+	if (ticks == OSI_FUNCS_TIME_BLOCKING) {
+		int ret;
+
+		/*
+		 * The blocking take is where a hang hides.
+		 *
+		 * A take with OSI_FUNCS_TIME_BLOCKING never times out, so if
+		 * the semaphore is never given this call does not return and
+		 * the boot log simply stops -- no fault, no pc, no excvaddr,
+		 * nothing to read. That is exactly what the board did: the
+		 * log ended inside coex_pre_init with no further output.
+		 *
+		 * The two prints below bracket the wait. "blocking take" is
+		 * printed before down_killable, "blocking take done" after.
+		 * A log that ends on the first and never shows the second
+		 * names this call, this handle and this task as the thing
+		 * that stopped, which is the fact a hang otherwise withholds.
+		 *
+		 * They are pr_info rather than pr_debug so they survive
+		 * whatever the loglevel is set to, and they are cheap: this
+		 * path is taken once per coex lock and once per ioctl, not
+		 * per packet.
+		 */
+		/*
+		 * The count, the wait list and the stack pointer are here
+		 * because of a fault on this path that the oops could not
+		 * name. The faulting instruction is
+		 *
+		 *     421699ec:  l32i.n a12, a8, 0     __add_wait_queue+0x10
+		 *
+		 * with a8 = 0xfffffff4. __add_wait_queue does
+		 * `addi a8, a8, -12` on the list head it is given, so the
+		 * wait_queue_entry it walked to was 0xffffffe8 = NULL - 24.
+		 * The return address 0x4216a51c is prepare_to_wait_event+0x48,
+		 * whose call at +0x45 is the one into __add_wait_queue.
+		 * prepare_to_wait_event is reached from the ___wait_event
+		 * macro, expanded at the port's three
+		 * wait_event_killable_timeout sites -- NOT from
+		 * ___down_common, which never calls it. See the comment on
+		 * osi_queue_recv.
+		 *
+		 * So this print is for the semaphore path only, and the three
+		 * queue/event prints cover the other direction. ___wait_event
+		 * declares its wait_queue_entry on the enclosing frame, so an
+		 * entry of NULL - 24 means that frame's stack pointer is
+		 * wrong. The oops frame is not self-consistent (depc = 0x1c
+		 * is not a code address), so it cannot name the caller. These
+		 * fields can: a count that is already negative or absurdly
+		 * large means the object was overwritten, a first_waiter that
+		 * is not NULL on a fresh binary semaphore means the list was
+		 * corrupted, and a frame address outside the task stack means
+		 * the corruption is earlier still.
+		 *
+		 * This kernel's struct semaphore is lock, count,
+		 * first_waiter -- there is no wait_list (see
+		 * include/linux/semaphore.h), so the list is reached
+		 * through first_waiter, not a list_head on the semaphore.
+		 */
+		pr_info("osi: semphr_take(%p) blocking take, task %s count=%u first_waiter=%p sp=%p caller=%pS\n",
+			s, current->comm, s->sem.count,
+			s->sem.first_waiter,
+			__builtin_frame_address(0),
+			__builtin_return_address(0));
+		ret = down_killable(&s->sem);
+		pr_info("osi: semphr_take(%p) blocking take done: %d\n", s, ret);
+
+		if (ret)
+			pr_warn("osi: semphr_take(%p) blocking take failed: %d (task %s)\n",
+				s, ret, current->comm);
+		return ret ? OSI_PD_FALSE : OSI_PD_TRUE;
+	}
+	if (ticks == 0)
+		return down_trylock(&s->sem) ? OSI_PD_FALSE : OSI_PD_TRUE;
+	return down_timeout(&s->sem, OSI_TICKS_TO_JIFFIES(ticks)) ? OSI_PD_FALSE
+								  : OSI_PD_TRUE;
+}
+
+static int32_t osi_semphr_give(void *semphr)
+{
+	struct osi_sem *s = semphr;
+
+	if (!s)
+		return OSI_PD_FALSE;
+	if (osi_handle_bad(s)) {
+		osi_handle_warn("semphr_give", s);
+		return OSI_PD_FALSE;
+	}
+	up(&s->sem);
+	return OSI_PD_TRUE;
+}
+
+/* ------------------------------------------------------------------ */
+/* _wifi_thread_semphr_get. This one is NOT optional.                  */
+/*                                                                     */
+/* The blob calls it once per ioctl and stores the result in the ioctl */
+/* argument block, then blocks on that same value later in the same    */
+/* call. Leaving it NULL made the blob store a NULL handle and hand it */
+/* straight to _semphr_take(), which then read a struct semaphore out  */
+/* of address 0 -- or, when the slot held a stale value from an        */
+/* earlier call, out of whatever that was. The panic's faulting        */
+/* address moved between boots for exactly that reason.                */
+/*                                                                     */
+/* IDF's own contract (components/esp_wifi/esp32s3/esp_adapter.c,      */
+/* wifi_thread_semphr_get_wrapper) is a per-thread counting semaphore  */
+/* held in a pthread key, created on first use and destroyed by the    */
+/* key's destructor when the thread exits. Linux has no pthread keys   */
+/* here, so the equivalent is a list keyed on `current`, with the      */
+/* entry freed when the task exits.                                    */
+/*                                                                     */
+/* The blob takes it with OSI_FUNCS_TIME_BLOCKING and gives it back,   */
+/* so it is a plain binary semaphore: created count 0, max 1.          */
+/* ------------------------------------------------------------------ */
+
+struct osi_thread_sem {
+	struct list_head node;
+	struct task_struct *task;
+	struct osi_sem sem;
+};
+
+static LIST_HEAD(osi_thread_sems);
+static DEFINE_SPINLOCK(osi_thread_sems_lock);
+
+static void osi_thread_sem_free(struct task_struct *task)
+{
+	struct osi_thread_sem *ts, *tmp;
+
+	spin_lock(&osi_thread_sems_lock);
+	list_for_each_entry_safe(ts, tmp, &osi_thread_sems, node) {
+		if (ts->task == task) {
+			list_del(&ts->node);
+			spin_unlock(&osi_thread_sems_lock);
+			kfree(ts);
+			return;
+		}
+	}
+	spin_unlock(&osi_thread_sems_lock);
+}
+
+static void *osi_wifi_thread_semphr_get(void)
+{
+	struct task_struct *task = current;
+	struct osi_thread_sem *ts;
+
+	spin_lock(&osi_thread_sems_lock);
+	list_for_each_entry(ts, &osi_thread_sems, node) {
+		if (ts->task == task) {
+			spin_unlock(&osi_thread_sems_lock);
+			pr_info("osi: thread semphr get -> %p (task %s, existing)\n",
+				&ts->sem, task->comm);
+			return &ts->sem;
+		}
+	}
+	spin_unlock(&osi_thread_sems_lock);
+
+	ts = kzalloc(sizeof(*ts), GFP_ATOMIC);
+	if (!ts)
+		return NULL;
+
+	ts->task = task;
+	sema_init(&ts->sem.sem, 0);
+	ts->sem.max = 1;
+
+	spin_lock(&osi_thread_sems_lock);
+	list_add(&ts->node, &osi_thread_sems);
+	spin_unlock(&osi_thread_sems_lock);
+
+	pr_info("osi: thread semphr get -> %p (task %s, new)\n", &ts->sem,
+		task->comm);
+	return &ts->sem;
+}
+
+/* ------------------------------------------------------------------ */
+/* Queues. A ring of fixed-size items, with send-from-ISR. The blob    */
+/* treats a queue as an opaque handle and never looks inside, so the   */
+/* shape is ours.                                                      */
+/* ------------------------------------------------------------------ */
+
+struct osi_queue {
+	u8 *buf;
+	u32 item_size;
+	u32 len;
+	u32 head;
+	u32 tail;
+	u32 count;
+	spinlock_t lock;
+	wait_queue_head_t wait;
+};
+
+static void *osi_queue_create_common(uint32_t queue_len, uint32_t item_size)
+{
+	struct osi_queue *q;
+
+	if (!queue_len || !item_size)
+		return NULL;
+	q = kzalloc(sizeof(*q), GFP_KERNEL);
+	if (!q)
+		return NULL;
+	q->buf = kzalloc((size_t)queue_len * item_size, GFP_KERNEL);
+	if (!q->buf) {
+		kfree(q);
+		return NULL;
+	}
+	q->item_size = item_size;
+	q->len = queue_len;
+	spin_lock_init(&q->lock);
+	init_waitqueue_head(&q->wait);
+	return q;
+}
+
+static void *osi_queue_create(uint32_t queue_len, uint32_t item_size)
+{
+	return osi_queue_create_common(queue_len, item_size);
+}
+
+static void *osi_wifi_create_queue(int queue_len, int item_size)
+{
+	if (queue_len <= 0 || item_size <= 0)
+		return NULL;
+	return osi_queue_create_common((uint32_t)queue_len, (uint32_t)item_size);
+}
+
+static void osi_queue_delete(void *queue)
+{
+	struct osi_queue *q = queue;
+
+	if (!q)
+		return;
+	kfree(q->buf);
+	kfree(q);
+}
+
+static int osi_queue_put(struct osi_queue *q, void *item, bool front)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&q->lock, flags);
+	if (q->count == q->len) {
+		spin_unlock_irqrestore(&q->lock, flags);
+		return -1;
+	}
+	if (front) {
+		q->head = (q->head + q->len - 1) % q->len;
+		memcpy(q->buf + q->head * q->item_size, item, q->item_size);
+	} else {
+		memcpy(q->buf + q->tail * q->item_size, item, q->item_size);
+		q->tail = (q->tail + 1) % q->len;
+	}
+	q->count++;
+	spin_unlock_irqrestore(&q->lock, flags);
+	wake_up(&q->wait);
+	return 0;
+}
+
+/* FreeRTOS's pdTRUE/pdFALSE once more. xQueueSend and xQueueReceive   */
+/* return pdTRUE on success and errQUEUE_FULL / errQUEUE_EMPTY on      */
+/* failure -- and projdefs.h defines BOTH of those error codes as 0,   */
+/* so failure is 0 for every queue call. osi_queue_put keeps the Linux */
+/* convention internally; the conversion happens here, at the boundary */
+/* the blob sees, so the internal callers stay readable.               */
+/* One wait path for every send, so the tick argument means the same   */
+/* thing in all four entry points. xQueueGenericSend's contract is     */
+/* "block up to xTicksToWait for space, then post", so the wait is for */
+/* space and the put is retried after it -- an earlier version waited  */
+/* a fixed 1000 ms regardless of ticks, busy-waited with udelay for    */
+/* the finite case, and never waited at all in the to-front case.      */
+/*                                                                     */
+/* The wait is killable, not interruptible, for the same reason        */
+/* osi_semphr_take's blocking arm is: FreeRTOS's xQueueGenericSend      */
+/* has no signal path, so an ordinary signal must not turn a wait into  */
+/* a failure. Only SIGKILL ends it early, and then the caller is dying  */
+/* anyway. See the comment on osi_semphr_take.                          */
+static int32_t osi_queue_send_wait(struct osi_queue *q, void *item,
+				   uint32_t ticks, bool front)
+{
+	unsigned long flags;
+	long left;
+
+	if (ticks == OSI_FUNCS_TIME_BLOCKING)
+		left = MAX_SCHEDULE_TIMEOUT;
+	else
+		left = OSI_TICKS_TO_JIFFIES(ticks);
+
+	for (;;) {
+		if (!osi_queue_put(q, item, front))
+			return 1;	/* pdTRUE */
+		if (!left)
+			return 0;	/* errQUEUE_FULL */
+		/*
+		 * One of the three sites that expand ___wait_event, and so
+		 * one of the three that can reach the fault this print is
+		 * for. See the comment on osi_queue_recv for the chain.
+		 */
+		pr_info("osi: %s(%p) sp=%p ticks=%u wq=%p next=%p prev=%p\n",
+			__func__, q, __builtin_frame_address(0), ticks,
+			&q->wait, q->wait.head.next, q->wait.head.prev);
+		left = wait_event_killable_timeout(q->wait,
+				({ spin_lock_irqsave(&q->lock, flags);
+				   int ok = q->count < q->len;
+				   spin_unlock_irqrestore(&q->lock, flags); ok; }),
+				left);
+		if (left < 0)
+			return 0;	/* errQUEUE_FULL */
+	}
+}
+
+static int32_t osi_queue_send(void *queue, void *item, uint32_t ticks)
+{
+	if (!queue || osi_handle_bad(queue)) {
+		osi_handle_warn("_queue_send", queue);
+		return 0;		/* errQUEUE_FULL */
+	}
+	return osi_queue_send_wait(queue, item, ticks, false);
+}
+
+static int32_t osi_queue_send_from_isr(void *queue, void *item, void *hptw)
+{
+	/* *hptw is pxHigherPriorityTaskWoken and must be written, for the
+	 * same reason as the semaphore pair above: the caller reads it back
+	 * and branches on it. pdFALSE is the true answer here -- nothing in
+	 * this port sends from a real ISR, so no unblock can require a
+	 * context switch. See osi_semphr_take_from_isr.
+	 */
+	if (hptw)
+		*(int32_t *)hptw = 0;
+	if (!queue || osi_handle_bad(queue)) {
+		osi_handle_warn("_queue_send_from_isr", queue);
+		return 0;
+	}
+	return osi_queue_put(queue, item, false) ? 0 : 1;
+}
+
+static int32_t osi_queue_send_to_back(void *queue, void *item, uint32_t ticks)
+{
+	return osi_queue_send(queue, item, ticks);
+}
+
+static int32_t osi_queue_send_to_front(void *queue, void *item, uint32_t ticks)
+{
+	if (!queue || osi_handle_bad(queue)) {
+		osi_handle_warn("_queue_send_to_front", queue);
+		return 0;
+	}
+	return osi_queue_send_wait(queue, item, ticks, true);
+}
+
+static int32_t osi_queue_recv(void *queue, void *item, uint32_t ticks)
+{
+	struct osi_queue *q = queue;
+	unsigned long flags;
+	long left;
+
+	if (!q || osi_handle_bad(q)) {
+		osi_handle_warn("_queue_recv", q);
+		return 0;		/* errQUEUE_EMPTY */
+	}
+	if (ticks == OSI_FUNCS_TIME_BLOCKING)
+		left = MAX_SCHEDULE_TIMEOUT;
+	else
+		left = OSI_TICKS_TO_JIFFIES(ticks);
+
+	for (;;) {
+		spin_lock_irqsave(&q->lock, flags);
+		if (q->count) {
+			memcpy(item, q->buf + q->head * q->item_size, q->item_size);
+			q->head = (q->head + 1) % q->len;
+			q->count--;
+			spin_unlock_irqrestore(&q->lock, flags);
+			return 1;	/* pdTRUE */
+		}
+		spin_unlock_irqrestore(&q->lock, flags);
+		if (!left)
+			return 0;	/* errQUEUE_EMPTY */
+		/*
+		 * One of the three ___wait_event sites. The chain this print
+		 * is for, verified against this image's own System.map:
+		 *
+		 *   osi_queue_recv / osi_queue_send_wait /
+		 *   osi_event_group_wait_bits
+		 *     -> init_wait_entry
+		 *     -> prepare_to_wait_event+0x45   (call8 __add_wait_queue)
+		 *     -> __add_wait_queue+0x10        (l32i.n a12, a8, 0)
+		 *
+		 * with a8 = 0xfffffff4, i.e. the wait_queue_entry the macro
+		 * declared on this frame resolved to NULL - 24. Each of the
+		 * three port functions has the same four calls inlined --
+		 * init_wait_entry, prepare_to_wait_event, schedule_timeout,
+		 * finish_wait -- and each l32r resolves to the same address,
+		 * so all three are reachable and only the print says which.
+		 *
+		 * ___down_common is NOT on this path. It calls sem_del_waiter
+		 * and schedule_timeout and never prepare_to_wait_event; an
+		 * earlier version of this comment named it and was wrong.
+		 *
+		 * sp is the datum. If it is a sane stack address and the
+		 * entry still lands at NULL - 24, the frame is the problem.
+		 * If sp is already bad, the corruption is earlier.
+		 */
+		pr_info("osi: %s(%p) sp=%p ticks=%u wq=%p next=%p prev=%p\n",
+			__func__, q, __builtin_frame_address(0), ticks,
+			&q->wait, q->wait.head.next, q->wait.head.prev);
+		left = wait_event_killable_timeout(q->wait,
+				({ spin_lock_irqsave(&q->lock, flags);
+				   int ok = q->count > 0;
+				   spin_unlock_irqrestore(&q->lock, flags); ok; }),
+				left);
+		if (left < 0)
+			return 0;
+	}
+}
+
+static uint32_t osi_queue_msg_waiting(void *queue)
+{
+	struct osi_queue *q = queue;
+	unsigned long flags;
+	u32 n;
+
+	if (!q || osi_handle_bad(q)) {
+		osi_handle_warn("_queue_msg_waiting", q);
+		return 0;
+	}
+	spin_lock_irqsave(&q->lock, flags);
+	n = q->count;
+	spin_unlock_irqrestore(&q->lock, flags);
+	return n;
+}
+
+/* ------------------------------------------------------------------ */
+/* Event groups. A bitfield plus a wait queue, which is what FreeRTOS  */
+/* event groups are.                                                   */
+/* ------------------------------------------------------------------ */
+
+struct osi_evtgrp {
+	u32 bits;
+	spinlock_t lock;
+	wait_queue_head_t wait;
+};
+
+static void *osi_event_group_create(void)
+{
+	struct osi_evtgrp *g = kzalloc(sizeof(*g), GFP_KERNEL);
+
+	if (!g)
+		return NULL;
+	spin_lock_init(&g->lock);
+	init_waitqueue_head(&g->wait);
+	return g;
+}
+
+static void osi_event_group_delete(void *event)
+{
+	kfree(event);
+}
+
+/* xEventGroupSetBits returns the value of the group AT THE TIME THE   */
+/* CALL RETURNS -- after the set, not before (event_groups.h:474-482,  */
+/* and its own example at :498-521 tests the return for the bits just  */
+/* set). osi_event_group_clear_bits is the opposite and correctly      */
+/* returns the value before the clear (event_groups.h:340).            */
+static uint32_t osi_event_group_set_bits(void *event, uint32_t bits)
+{
+	struct osi_evtgrp *g = event;
+	unsigned long flags;
+	u32 after;
+
+	if (!g)
+		return 0;
+	spin_lock_irqsave(&g->lock, flags);
+	g->bits |= bits;
+	after = g->bits;
+	spin_unlock_irqrestore(&g->lock, flags);
+	wake_up_all(&g->wait);
+	return after;
+}
+
+static uint32_t osi_event_group_clear_bits(void *event, uint32_t bits)
+{
+	struct osi_evtgrp *g = event;
+	unsigned long flags;
+	u32 before;
+
+	if (!g)
+		return 0;
+	spin_lock_irqsave(&g->lock, flags);
+	before = g->bits;
+	g->bits &= ~bits;
+	spin_unlock_irqrestore(&g->lock, flags);
+	return before;
+}
+
+static uint32_t osi_event_group_wait_bits(void *event, uint32_t wait_for,
+					  int clear_on_exit, int wait_all,
+					  uint32_t ticks)
+{
+	struct osi_evtgrp *g = event;
+	unsigned long flags;
+	long left;
+	u32 got;
+
+	if (!g)
+		return 0;
+	left = (ticks == OSI_FUNCS_TIME_BLOCKING) ? MAX_SCHEDULE_TIMEOUT
+						  : OSI_TICKS_TO_JIFFIES(ticks);
+
+	for (;;) {
+		spin_lock_irqsave(&g->lock, flags);
+		got = g->bits;
+		if ((wait_all && (got & wait_for) == wait_for) ||
+		    (!wait_all && (got & wait_for))) {
+			if (clear_on_exit)
+				g->bits &= ~wait_for;
+			spin_unlock_irqrestore(&g->lock, flags);
+			return got;
+		}
+		spin_unlock_irqrestore(&g->lock, flags);
+		if (!left)
+			break;
+		/* The third ___wait_event site. See osi_queue_recv. */
+		pr_info("osi: %s(%p) sp=%p ticks=%u wq=%p next=%p prev=%p\n",
+			__func__, g, __builtin_frame_address(0), ticks,
+			&g->wait, g->wait.head.next, g->wait.head.prev);
+		left = wait_event_killable_timeout(g->wait,
+				({ spin_lock_irqsave(&g->lock, flags);
+				   u32 b = g->bits;
+				   spin_unlock_irqrestore(&g->lock, flags);
+				   (wait_all && (b & wait_for) == wait_for) ||
+				   (!wait_all && (b & wait_for)); }),
+				left);
+		if (left < 0)
+			break;
+	}
+
+	/* xEventGroupWaitBits returns "the value of the event group at the */
+	/* time either the bits being waited for became set, or the block   */
+	/* time expired" (event_groups.h:283-286), so the timeout path      */
+	/* re-reads the group rather than reporting the stale snapshot the  */
+	/* loop last looked at.                                             */
+	spin_lock_irqsave(&g->lock, flags);
+	got = g->bits;
+	spin_unlock_irqrestore(&g->lock, flags);
+	return got;
+}
+
+/* ------------------------------------------------------------------ */
+/* Tasks. The blob's Wi-Fi task becomes a kthread.                     */
+/* ------------------------------------------------------------------ */
+
+struct osi_task {
+	struct task_struct *tsk;
+	int (*fn)(void *);
+	void *arg;
+	char name[16];
+};
+
+/*
+ * The handle _task_create hands back is this struct, not the task_struct
+ * behind it, and _task_get_current_task has to answer with the same kind
+ * of object or the blob's own identity test never matches.
+ *
+ * That test is real: libnet80211.a's current_task_is_wifi_task calls
+ * _task_get_current_task and compares the result against s_wifi_task_hdl,
+ * the handle _task_create stored, and ieee80211_ioctl branches on the
+ * answer -- a nonzero result skips setting bit 0 of the request's flags
+ * word. Returning `current` there compares a task_struct against an
+ * osi_task, which is never equal, so the flag was set on every ioctl.
+ *
+ * The trampoline records the osi_task in task_struct::set_child_tid, which
+ * is per-thread, is never touched by anything this port runs, and is
+ * cleared by the kernel on exit. A lookup table would need a lock on the
+ * hot path and would have to be torn down on thread exit; this needs
+ * neither.
+ */
+static int osi_task_trampoline(void *data)
+{
+	struct osi_task *t = data;
+
+	/* set_child_tid is a userspace ABI field, so it is a __user pointer
+	 * by type. The value is ours and is never dereferenced, but the
+	 * cast has to go through uintptr_t to keep sparse and the compiler
+	 * from objecting to the address-space change.
+	 */
+	current->set_child_tid = (int __user *)(uintptr_t)t;
+
+	osi_note("task entry");
+	t->fn(t->arg);
+	/* The thread's _wifi_thread_semphr_get entry, if it ever asked for
+	 * one, dies with it -- the same lifetime IDF gets from the pthread
+	 * key destructor. osi_task_delete calls this too, for the paths that
+	 * end the thread without returning here; the function tolerates a
+	 * task with no entry, so a double call is harmless.
+	 */
+	osi_thread_sem_free(current);
+	return 0;
+}
+
+/* xTaskCreate returns pdPASS (1) on success and pdFAIL (0) on         */
+/* failure -- IDF's wrapper is `return (uint32_t)xTaskCreate(...)` and */
+/* task.h:544 documents pdPASS. This returned Linux's 0/-1, which the  */
+/* blob reads as failure on the success path.                          */
+static int32_t osi_task_create_common(void *task_func, const char *name,
+				      uint32_t stack_depth, void *param,
+				      uint32_t prio, void *task_handle)
+{
+	struct osi_task *t;
+	struct task_struct *tsk;
+
+	t = kzalloc(sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return 0;		/* pdFAIL */
+	t->fn = task_func;
+	t->arg = param;
+	strscpy(t->name, name ? name : "esp_wifi", sizeof(t->name));
+
+	tsk = kthread_create(osi_task_trampoline, t, "%s", t->name);
+	if (IS_ERR(tsk)) {
+		kfree(t);
+		return 0;		/* pdFAIL */
+	}
+	t->tsk = tsk;
+	/* Take a reference so the handle stays valid after the kthread
+	 * exits on its own -- see osi_task_delete.
+	 */
+	get_task_struct(tsk);
+	/* FreeRTOS priorities run the other way from Linux's, and the blob
+	 * asks for 23-ish for its Wi-Fi task. Anything above the default is
+	 * enough for a radio task on a board with nothing else to run.
+	 */
+	if (prio)
+		set_user_nice(tsk, -10);
+	wake_up_process(tsk);
+
+	if (task_handle)
+		*(void **)task_handle = t;
+	osi_note("task created");
+	return 1;			/* pdPASS */
+}
+
+static int32_t osi_task_create(void *task_func, const char *name,
+			       uint32_t stack_depth, void *param,
+			       uint32_t prio, void *task_handle)
+{
+	return osi_task_create_common(task_func, name, stack_depth, param,
+				      prio, task_handle);
+}
+
+static int32_t osi_task_create_pinned_to_core(void *task_func, const char *name,
+					      uint32_t stack_depth, void *param,
+					      uint32_t prio, void *task_handle,
+					      uint32_t core_id)
+{
+	/* One core. The pin is honoured by ignoring it. */
+	return osi_task_create_common(task_func, name, stack_depth, param,
+				      prio, task_handle);
+}
+
+/* IDF binds this slot straight to vTaskDelete, which never blocks on  */
+/* the target's exit -- it unlinks the TCB and the idle task reclaims  */
+/* the stack later. kthread_stop waits for the target to exit, so a    */
+/* task blocked forever would hang the caller, and a task that already */
+/* returned on its own has freed its own task_struct, making t->tsk a  */
+/* dangling pointer. The get_task_struct in osi_task_create_common     */
+/* holds the reference open, and kthread_should_stop() tells the two   */
+/* cases apart.                                                        */
+
+/*
+ * End the calling thread, from inside it.
+ *
+ * This is kthread_exit() written out, because the driver's own
+ * esp_kernel_port.h shadows it: it defines
+ *
+ *     #define do_exit(code) kthread_complete_and_exit(NULL, code)
+ *
+ * for kernels >= 5.17, and include/linux/kthread.h defines
+ *
+ *     #define kthread_exit(result) do_exit(result)
+ *
+ * so the two compose into kthread_complete_and_exit(NULL, result). That
+ * is the right function and the right call -- but it means kthread_exit
+ * is a function-like macro that takes an argument, and writing it the
+ * way the kernel's own documentation shows it, `kthread_exit()`, expands
+ * to `kthread_complete_and_exit(NULL, )` and does not compile.
+ *
+ * The macro is not wrong for its own users: the driver calls do_exit()
+ * in its own code and wants that meaning. It is only this file, which
+ * includes both headers, that cannot use the short spelling. So the call
+ * is spelled out here, once, with the meaning written down.
+ *
+ * kthread_complete_and_exit() does not return.
+ */
+static void osi_task_exit(void)
+{
+	kthread_complete_and_exit(NULL, 0);
+}
+
+/*
+ * vTaskDelete takes a TaskHandle_t, and NULL means "delete the calling
+ * task". The blob never passes NULL here -- libpp.a's
+ * pp_delete_task_manually loads pp_task_hdl and deletes that, from
+ * another context -- but the NULL case is handled as FreeRTOS defines it
+ * rather than left as a no-op, because a no-op would leave the caller
+ * running when it expects never to return.
+ *
+ * The self case cannot use kthread_stop: that sets KTHREAD_SHOULD_STOP
+ * and then waits for the thread's exit completion, so calling it on
+ * `current` waits for a thread that cannot exit while it is waiting. A
+ * kthread that wants to end itself just returns, which the trampoline
+ * does, so the right action here is to stop running the blob's function
+ * and let the thread unwind. osi_task_exit() below is that, and it does
+ * not return.
+ *
+ * An earlier version guarded kthread_stop with kthread_should_stop(),
+ * which asks about the CALLING thread, not about t->tsk -- so it never
+ * suppressed the self case it looked like it was guarding.
+ *
+ * osi_task_exit unwinds without returning through osi_task_trampoline,
+ * so the per-thread semaphore the trampoline would have freed has to be
+ * freed here instead, before the exit. It has to be BEFORE: the exit does
+ * not come back. osi_thread_sem_free is a no-op for a task that never
+ * called _wifi_thread_semphr_get, so the common case pays a list walk and
+ * nothing else.
+ */
+static void osi_task_delete(void *task_handle)
+{
+	struct osi_task *t = task_handle;
+
+	if (!t) {
+		osi_thread_sem_free(current);
+		osi_task_exit();
+		return;			/* not reached */
+	}
+	if (t->tsk) {
+		if (t->tsk == current) {
+			osi_thread_sem_free(current);
+			osi_task_exit();
+		}
+		kthread_stop(t->tsk);
+		put_task_struct(t->tsk);
+	}
+	kfree(t);
+}
+
+/* vTaskDelay takes ticks, not milliseconds. */
+static void osi_task_delay(uint32_t ticks)
+{
+	if (ticks)
+		msleep(ticks * OSI_TICK_PERIOD_MS);
+}
+
+/* IDF's wrapper is `return (int32_t)(ms / portTICK_PERIOD_MS)`, and   */
+/* portTICK_PERIOD_MS is 10 at CONFIG_FREERTOS_HZ 100. */
+static int32_t osi_task_ms_to_tick(uint32_t ms)
+{
+	return ms / OSI_TICK_PERIOD_MS;
+}
+
+/*
+ * FreeRTOS's xTaskGetCurrentTaskHandle returns the TaskHandle_t, and the
+ * blob compares that against what xTaskCreate stored -- see the comment
+ * on osi_task_trampoline. So this returns the osi_task the trampoline put
+ * in set_child_tid, not `current`.
+ *
+ * A thread that is not one of ours has no osi_task, and the honest answer
+ * for it is NULL: the blob only ever compares the result for equality, so
+ * NULL is a definite "not the Wi-Fi task", which is correct for every
+ * thread this port did not create. Returning `current` instead would make
+ * the comparison depend on whether some unrelated pointer happened to
+ * collide, which is the bug this replaces.
+ */
+static void *osi_task_get_current_task(void)
+{
+	return (void *)(uintptr_t)current->set_child_tid;
+}
+
+/* IDF returns configMAX_PRIORITIES, which is the COUNT (25 on Xtensa, */
+/* FreeRTOSConfig_arch.h:46), not the highest usable index (24). The   */
+/* blob derives its own task priorities from this, so a one-off count  */
+/* shifts every priority it computes.                                  */
+static int32_t osi_task_get_max_priority(void)
+{
+	return 25;
+}
+
+static void osi_task_yield_from_isr(void)
+{
+}
+
+/* ------------------------------------------------------------------ */
+/* Interrupts.                                                         */
+/*                                                                     */
+/* The blob installs its handler through _set_isr(n, f, arg) and turns */
+/* it on through _ints_on(mask), where n and the mask bit are both     */
+/* Xtensa core interrupt numbers. _set_intr(cpu, source, num, prio) is */
+/* the IDF call that connects a peripheral to one of those core        */
+/* interrupts: `source` is a row of the ESP32 interrupt matrix and     */
+/* `num` is the core interrupt it is routed to.                        */
+/*                                                                     */
+/* On this kernel the matrix is a Linux irqchip (drivers/irqchip/      */
+/* irq-esp32-intc.c, patch 0007). Its domain takes two cells -- the    */
+/* matrix row and the core interrupt -- which is exactly the pair      */
+/* _set_intr is handed. So the connection the blob asks for is one     */
+/* irq_create_fwspec_mapping() on (source, num), and the handler it    */
+/* installs is one request_irq() on the virtual IRQ that comes back.   */
+/*                                                                     */
+/* The two calls arrive in either order and both are needed before the */
+/* interrupt can fire, so each one is remembered and the pairing is    */
+/* made whenever the second of the pair shows up.                      */
+/* ------------------------------------------------------------------ */
+
+#define OSI_MAX_ISR	8
+
+/*
+ * The driver's own state, defined here rather than with the rest of the
+ * driver's data because the interrupt block below needs the complete type:
+ * _set_intr looks the interrupt matrix node up through it, and a forward
+ * declaration is not enough to dereference. The rest of the driver's data
+ * follows further down.
+ */
+struct esp_wifi_blob {
+	struct esp_adapter adapter;
+	struct sk_buff_head rx_q[MAX_PRIORITY_QUEUES];
+	struct sk_buff_head tx_q;
+	void __iomem *osi_slot;
+	void __iomem *xphy_slot;	/* ROM pointer slot 0x3fcef904 */
+	struct device_node *intc_np;
+	bool started;
+	bool blob_started;	/* the blob bring-up has run once */
+};
+
+static struct esp_wifi_blob *g_blob;
+
+/*
+ * Bits the blob has turned on through _ints_on. request_irq() leaves an
+ * IRQ enabled, so this is what keeps enable_irq()/disable_irq_nosync()
+ * balanced rather than called twice for one transition.
+ */
+static u32 osi_ints_enabled;
+
+struct osi_isr_slot {
+	void (*fn)(void *);
+	void *arg;
+	int virq;
+	bool mapped;
+};
+
+static struct osi_isr_slot osi_isrs[OSI_MAX_ISR];
+static DEFINE_SPINLOCK(osi_isr_lock);
+
+/*
+ * The matrix row a core interrupt is fed from, learned from _set_intr.
+ * The blob calls _set_intr before _set_isr in practice, but nothing
+ * promises that, so the table is indexed by core interrupt number and
+ * filled in from whichever call arrives first.
+ */
+static int osi_intr_source[OSI_MAX_ISR] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+static int osi_intr_prio[OSI_MAX_ISR];
+
+/*
+ * The blob's interrupt callback runs on a threaded IRQ, not in hardirq
+ * context.
+ *
+ * The reason is that the blob sleeps, and it sleeps unconditionally --
+ * not on a branch this layer controls. The clearest case is on the timer
+ * path: ieee80211_timer_process (libnet80211.a) opens with a call to
+ * wifi_api_lock, which calls _mutex_lock -- offset 84 of wifi_osi_funcs,
+ * the offset verified against the Xtensa compiler's own offsetof -- and
+ * _mutex_lock here is mutex_lock(), which sleeps. Nothing in the blob
+ * asks whether that is safe first.
+ *
+ * So this layer cannot make the blob's sleeping calls legal by answering
+ * a question -- it has to make the context legal. Running the callback in
+ * a hardirq is what produced the panic inside try_to_take_rt_mutex: a
+ * wild waiter pointer and a fault at 0x00710200, because mutex_lock() in
+ * interrupt context has no task to block and no valid waiter to enqueue.
+ *
+ * A threaded IRQ fixes that by giving the handler a kthread with a real
+ * task_struct, so blocking is permitted. The primary handler is NULL, so
+ * the whole callback -- including the hardware acknowledgement the blob
+ * does itself -- happens on the thread.
+ *
+ * Note on _is_from_isr: this layer implements it and returns false, but
+ * the Wi-Fi blob never calls it -- a scan of the members of
+ * libnet80211.a, plus libpp.a, libcore.a and libesp_wifi.a, finds no call
+ * through that pointer. An earlier version of this comment claimed the
+ * blob picked its path from that answer. It does not. The coexistence
+ * library is the one that branches on such a question (_is_in_isr, offset
+ * 32 of coex_adapter_funcs, in coex_core_lock/unlock), and that branch is
+ * real -- see osi_is_in_isr() below. Do not describe _is_from_isr as
+ * load-bearing again without evidence.
+ *
+ * The cost is latency: the callback now waits for the IRQ thread to be
+ * scheduled rather than running at interrupt level. For a Wi-Fi blob that
+ * takes mutexes on its timer path, that latency was never available to
+ * begin with -- the alternative was not "fast", it was "faults".
+ */
+static irqreturn_t osi_isr_thunk(int irq, void *dev_id)
+{
+	struct osi_isr_slot *s = dev_id;
+
+	if (s && s->fn)
+		s->fn(s->arg);
+	return IRQ_HANDLED;
+}
+
+/*
+ * Build the Linux IRQ for core interrupt `n` from matrix row `source`.
+ * The intc domain's alloc callback writes the row into the matrix and
+ * hands the parent PIC the core interrupt, so this single call is the
+ * whole connection.
+ */
+static int osi_map_irq(int n, int source)
+{
+	struct irq_fwspec fwspec;
+
+	if (!g_blob || !g_blob->intc_np)
+		return -ENODEV;
+
+	fwspec.fwnode = of_fwnode_handle(g_blob->intc_np);
+	fwspec.param_count = 2;
+	fwspec.param[0] = source;	/* matrix row */
+	fwspec.param[1] = n;		/* core interrupt */
+
+	return irq_create_fwspec_mapping(&fwspec);
+}
+
+/*
+ * Called once both halves of the pair are known. request_irq() is what
+ * actually installs the blob's function; the blob's own _set_isr is an
+ * IDF-level registry, and on this kernel the registry that matters is
+ * the Linux one.
+ */
+static void osi_try_connect(int n)
+{
+	struct osi_isr_slot *s = &osi_isrs[n];
+	unsigned long flags;
+	int virq, ret;
+
+	spin_lock_irqsave(&osi_isr_lock, flags);
+	if (!s->fn || s->mapped || osi_intr_source[n] < 0) {
+		spin_unlock_irqrestore(&osi_isr_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&osi_isr_lock, flags);
+
+	virq = osi_map_irq(n, osi_intr_source[n]);
+	if (virq < 0) {
+		pr_err("osi: no Linux IRQ for core int %d from matrix row %d: %d\n",
+		       n, osi_intr_source[n], virq);
+		return;
+	}
+
+	/*
+	 * IRQF_ONESHOT, because the primary handler is NULL. The kernel
+	 * substitutes irq_default_primary_handler for a NULL primary, and
+	 * that returns IRQ_WAKE_THREAD, which means the hardirq half does
+	 * nothing but wake the thread. Without IRQF_ONESHOT the core
+	 * unmasks the line on the way out of the hardirq, so the blob's
+	 * interrupt source stays live while osi_isr_thunk runs in process
+	 * context and can re-enter it. With it, the line stays masked until
+	 * the thread returns.
+	 */
+	ret = request_threaded_irq(virq, NULL, osi_isr_thunk, IRQF_ONESHOT,
+				   "esp32-wifi-blob", s);
+	if (ret) {
+		pr_err("osi: request_threaded_irq(%d) for core int %d: %d\n",
+		       virq, n, ret);
+		return;
+	}
+
+	spin_lock_irqsave(&osi_isr_lock, flags);
+	s->virq = virq;
+	s->mapped = true;
+	spin_unlock_irqrestore(&osi_isr_lock, flags);
+
+	pr_info("osi: core int %d <- matrix row %d, Linux IRQ %d, handler %ps\n",
+		n, osi_intr_source[n], virq, s->fn);
+}
+
+static void osi_set_intr(int32_t cpu_no, uint32_t intr_source,
+			 uint32_t intr_num, int32_t intr_prio)
+{
+	if (intr_num >= OSI_MAX_ISR) {
+		pr_warn("osi: _set_intr core int %u out of range\n", intr_num);
+		return;
+	}
+
+	pr_info("osi: _set_intr(cpu=%d, source=%u, num=%u, prio=%d)\n",
+		cpu_no, intr_source, intr_num, intr_prio);
+
+	osi_intr_source[intr_num] = intr_source;
+	osi_intr_prio[intr_num] = intr_prio;
+	osi_try_connect(intr_num);
+}
+
+static void osi_clear_intr(uint32_t intr_source, uint32_t intr_num)
+{
+	int i;
+
+	pr_info("osi: _clear_intr(source=%u, num=%u)\n", intr_source, intr_num);
+
+	for (i = 0; i < OSI_MAX_ISR; i++)
+		if (osi_intr_source[i] == (int)intr_source)
+			osi_intr_source[i] = -1;
+}
+
+static void osi_set_isr(int32_t n, void *f, void *arg)
+{
+	if (n < 0 || n >= OSI_MAX_ISR) {
+		pr_warn("osi: _set_isr core int %d out of range\n", n);
+		return;
+	}
+
+	pr_info("osi: _set_isr(n=%d, f=%ps, arg=%p)\n", n, f, arg);
+
+	osi_isrs[n].fn = f;
+	osi_isrs[n].arg = arg;
+	osi_try_connect(n);
+}
+
+/*
+ * _ints_on and _ints_off are handed a bitmask of core interrupts. The
+ * Linux IRQ that stands for each one is installed by the time either
+ * arrives, so these enable and disable it rather than logging.
+ *
+ * request_irq() leaves an IRQ enabled, so the state has to be tracked
+ * here: an enable_irq() on an IRQ that was never disabled is an
+ * unbalanced enable and the kernel complains about it loudly. The bit
+ * is therefore remembered and the call made only on a real transition.
+ * A bit with no mapping yet is not an error either -- the blob enables
+ * before it installs in some paths -- so it is only logged.
+ */
+static void osi_ints_on(uint32_t mask)
+
+{
+	int n;
+
+	pr_info("osi: _ints_on(0x%08x)\n", mask);
+
+	for (n = 0; n < OSI_MAX_ISR; n++) {
+		if (!(mask & BIT(n)))
+			continue;
+		if (!osi_isrs[n].mapped) {
+			pr_info("osi: _ints_on bit %d has no IRQ yet\n", n);
+			continue;
+		}
+		if (osi_ints_enabled & BIT(n))
+			continue;
+		enable_irq(osi_isrs[n].virq);
+		osi_ints_enabled |= BIT(n);
+	}
+}
+
+static void osi_ints_off(uint32_t mask)
+{
+	int n;
+
+	pr_info("osi: _ints_off(0x%08x)\n", mask);
+
+	for (n = 0; n < OSI_MAX_ISR; n++) {
+		if (!(mask & BIT(n)))
+			continue;
+		if (!(osi_ints_enabled & BIT(n)))
+			continue;
+		osi_ints_enabled &= ~BIT(n);
+		if (!osi_isrs[n].mapped)
+			continue;
+		disable_irq_nosync(osi_isrs[n].virq);
+	}
+}
+
+/*
+ * This is the Wi-Fi blob's own table (wifi_osi_funcs), not the coex
+ * table, and the two are not equivalent.
+ *
+ * The honest answer here is false: nothing enters this port from a
+ * hardirq. The blob's interrupt callbacks are delivered on threaded IRQs
+ * (see osi_isr_thunk), so the ISR path is a kthread with a real
+ * task_struct, and probe, the rx callback and the timer workqueue are
+ * ordinary process context.
+ *
+ * The blob does call it, but only once. A scan of the members of
+ * libnet80211.a, plus libpp.a, libcore.a and libesp_wifi.a, finds exactly
+ * one call through this pointer: in esp_wifi_get_tsf_time (ieee80211_api.o),
+ * which branches on the result. A non-zero return takes an inline path that
+ * reads the timestamp directly; a zero return takes a deferred path that
+ * allocates a 24-byte record with _wifi_zalloc, fills it and hands it to
+ * ieee80211_ioctl. False therefore selects the deferred path, which is the
+ * correct one here: the caller is always process context in this port, so
+ * it can sleep, and the deferred path is the one that does not require the
+ * caller to hold a lock the ISR would otherwise have to respect.
+ *
+ * It still has to stay in step with the context the blob actually runs in.
+ * If a handler is ever moved back to hardirq context, this must become a
+ * real in_interrupt() test in the same change, because that one call site
+ * does branch on it and would otherwise be told a lie.
+ */
+static bool osi_is_from_isr(void)
+{
+	return false;
+}
+
+/*
+ * The blob's critical-section mux. This must be a real object even
+ * though spinlock_t is empty on this build.
+ *
+ * CONFIG_SMP is off, so CONFIG_FORCE_NR_CPUS=y, NR_CPUS is 1, and
+ * arch_spinlock_t is an empty struct -- sizeof(spinlock_t) == 0.
+ * kzalloc(0, GFP_KERNEL) is legal and returns ZERO_SIZE_PTR (0x10) by
+ * design, so the old version of this function handed the blob 0x10 as
+ * a mutex handle. Every _wifi_int_disable and _wifi_int_restore then
+ * failed the handle check and fell back to local_irq_save, and every
+ * log line read "bad handle 00000010".
+ *
+ * An empty spinlock still gives correct mutual exclusion on one core
+ * (there is nothing to contend with), so the locking itself was never
+ * wrong. What was wrong is that the handle was indistinguishable from
+ * a bad pointer, which made the failure silent and the diagnostics
+ * useless. Allocating one byte gives a unique, in-range, non-NULL
+ * handle that the blob can store and hand back, and that the handle
+ * checks accept.
+ */
+static void *osi_spin_lock_create(void)
+{
+	spinlock_t *l = kzalloc(sizeof(*l) ? sizeof(*l) : 1, GFP_KERNEL);
+
+	if (l)
+		spin_lock_init(l);
+	pr_info("osi: _spin_lock_create -> %p (caller %pS)\n", l,
+		__builtin_return_address(0));
+	return l;
+}
+
+static void osi_spin_lock_delete(void *lock)
+{
+	kfree(lock);
+}
+
+/* IDF's pair is esp_coex_common_int_disable/restore_wrapper, which    */
+/* enter a critical section ON THE MUX the blob allocated with         */
+/* _spin_lock_create -- portENTER_CRITICAL(wifi_int_mux). An earlier   */
+/* version did local_irq_save and ignored the mux entirely, so two     */
+/* threads calling with different muxes got no mutual exclusion at     */
+/* all and every interrupt on the CPU was masked for the section. The  */
+/* mux is taken here, with the interrupt state returned in the value   */
+/* so the matching restore can put it back.                            */
+static uint32_t osi_wifi_int_disable(void *mux)
+{
+	unsigned long flags;
+
+	if (mux && osi_handle_bad(mux)) {
+		osi_handle_warn("_wifi_int_disable", mux);
+		mux = NULL;
+	}
+	if (mux)
+		spin_lock_irqsave((spinlock_t *)mux, flags);
+	else
+		local_irq_save(flags);
+	return (uint32_t)flags;
+}
+
+static void osi_wifi_int_restore(void *mux, uint32_t tmp)
+{
+	if (mux && osi_handle_bad(mux)) {
+		osi_handle_warn("_wifi_int_restore", mux);
+		mux = NULL;
+	}
+	if (mux)
+		spin_unlock_irqrestore((spinlock_t *)mux, (unsigned long)tmp);
+	else
+		local_irq_restore((unsigned long)tmp);
+}
+
+/* ------------------------------------------------------------------ */
+/* Timers. The blob's esp_timer subset: arm, disarm, done, setfn.      */
+/*                                                                     */
+/* The blob allocates the timer object itself -- an IDF `struct        */
+/* esp_timer`, which is 32 bytes and has nothing in common with a      */
+/* Linux `struct timer_list`. So this layer must never write into the  */
+/* pointer the blob passes: an earlier version of this file cast it to */
+/* its own much larger struct and called timer_setup() on it, which    */
+/* wrote a full timer_list past the end of the blob's allocation and   */
+/* corrupted the adjacent slab object. The symptom was a mutex whose   */
+/* waiter pointer had become 0xfc080410, faulting later inside         */
+/* try_to_take_rt_mutex with nothing pointing back at the timer.       */
+/*                                                                     */
+/* Instead each blob timer gets a side entry: our own kmalloc'd        */
+/* struct osi_timer, found by the blob's pointer. The blob's object is */
+/* treated as an opaque key and is never dereferenced or written.      */
+/* ------------------------------------------------------------------ */
+
+struct osi_timer {
+	struct list_head node;
+	void *key;		/* the blob's esp_timer pointer */
+	struct timer_list timer;
+	struct work_struct work;
+	void (*fn)(void *);
+	void *arg;
+	bool repeat;
+	u32 period_ms;
+};
+
+static LIST_HEAD(osi_timers);
+static DEFINE_SPINLOCK(osi_timers_lock);
+
+/* Callers are the blob's coex and Wi-Fi paths, which can arm a timer
+ * from a softirq or with interrupts off, so this is GFP_ATOMIC and the
+ * lookup is under a spinlock rather than a mutex. */
+static struct osi_timer *osi_timer_find(void *key)
+{
+	struct osi_timer *ot;
+
+	list_for_each_entry(ot, &osi_timers, node)
+		if (ot->key == key)
+			return ot;
+	return NULL;
+}
+
+/*
+ * The blob's timer callback runs on a workqueue, not in the timer softirq.
+ *
+ * osi_timer_cb() is invoked by the timer wheel, i.e. in softirq context,
+ * and the blob's callback is not written for that: it takes mutexes
+ * through osi_mutex_lock() and waits on queues through osi_queue_recv(),
+ * both of which sleep. Sleeping in a softirq is the same defect the
+ * threaded IRQ in osi_isr_thunk() fixes for the interrupt path, and it
+ * has the same symptom -- a wild rt_mutex waiter and a fault inside
+ * try_to_take_rt_mutex.
+ *
+ * So the timer only schedules work; the callback itself runs on a
+ * kworker, in process context, where every call the blob makes is legal.
+ * The timer stays armed for the repeat case, and re-arming happens from
+ * the callback's own context.
+ *
+ * The work item is embedded in the timer object and the object is only
+ * freed by osi_timer_done(), which cancels the timer first -- so the work
+ * cannot outlive the thing it points at.
+ */
+/* Runs on a kworker, in process context. This is where the blob's
+ * callback is actually invoked; osi_timer_cb() only schedules it. */
+static void osi_timer_work(struct work_struct *w)
+{
+	struct osi_timer *ot = container_of(w, struct osi_timer, work);
+
+	if (ot->fn)
+		ot->fn(ot->arg);
+	if (ot->repeat && ot->period_ms)
+		mod_timer(&ot->timer, jiffies + msecs_to_jiffies(ot->period_ms));
+}
+
+static void osi_timer_cb(struct timer_list *t)
+{
+	struct osi_timer *ot = container_of(t, struct osi_timer, timer);
+
+	schedule_work(&ot->work);
+}
+
+static void osi_timer_setfn(void *ptimer, void *pfunction, void *parg)
+{
+	struct osi_timer *ot;
+	unsigned long flags;
+
+	if (!ptimer)
+		return;
+
+	spin_lock_irqsave(&osi_timers_lock, flags);
+	ot = osi_timer_find(ptimer);
+	if (!ot) {
+		ot = kzalloc(sizeof(*ot), GFP_ATOMIC);
+		if (ot) {
+			ot->key = ptimer;
+			timer_setup(&ot->timer, osi_timer_cb, 0);
+			INIT_WORK(&ot->work, osi_timer_work);
+			list_add(&ot->node, &osi_timers);
+		}
+	}
+	if (ot) {
+		ot->fn = pfunction;
+		ot->arg = parg;
+	}
+	spin_unlock_irqrestore(&osi_timers_lock, flags);
+
+	if (!ot)
+		pr_err("osi: _timer_setfn: no memory for timer %p\n", ptimer);
+}
+
+static void osi_timer_arm(void *timer, uint32_t tmout, bool repeat)
+{
+	struct osi_timer *ot;
+	unsigned long flags;
+
+	if (!timer)
+		return;
+
+	spin_lock_irqsave(&osi_timers_lock, flags);
+	ot = osi_timer_find(timer);
+	if (ot && ot->fn) {
+		ot->repeat = repeat;
+		ot->period_ms = tmout;
+		mod_timer(&ot->timer, jiffies + msecs_to_jiffies(tmout));
+	}
+	spin_unlock_irqrestore(&osi_timers_lock, flags);
+}
+
+static void osi_timer_arm_us(void *ptimer, uint32_t us, bool repeat)
+{
+	osi_timer_arm(ptimer, DIV_ROUND_UP(us, 1000), repeat);
+}
+
+static void osi_timer_disarm(void *timer)
+{
+	struct osi_timer *ot;
+	unsigned long flags;
+
+	if (!timer)
+		return;
+
+	spin_lock_irqsave(&osi_timers_lock, flags);
+	ot = osi_timer_find(timer);
+	spin_unlock_irqrestore(&osi_timers_lock, flags);
+
+	if (ot) {
+		timer_delete_sync(&ot->timer);
+		cancel_work_sync(&ot->work);
+	}
+}
+
+/* The blob frees its own esp_timer after this returns, so the entry
+ * goes with it. Only our object is freed here; the blob's pointer is
+ * never kfree'd by this layer. */
+static void osi_timer_done(void *ptimer)
+{
+	struct osi_timer *ot;
+	unsigned long flags;
+
+	if (!ptimer)
+		return;
+
+	spin_lock_irqsave(&osi_timers_lock, flags);
+	ot = osi_timer_find(ptimer);
+	if (ot)
+		list_del(&ot->node);
+	spin_unlock_irqrestore(&osi_timers_lock, flags);
+
+	if (!ot)
+		return;
+	timer_delete_sync(&ot->timer);
+	cancel_work_sync(&ot->work);
+	kfree(ot);
+}
