+ *
+ * This is coex_adapter_funcs_t from IDF's
+ * components/esp_coex/include/esp_coexist_adapter.h, reproduced field for
+ * field for the ESP32-S3 (the ESP32 and ESP32-C2 blocks in that header are
+ * #if'd out on this target, so the struct is 72 bytes: 18 four-byte
+ * fields, _version first and _magic last).
+ *
+ * It is NOT a set of optional callbacks, which is what an earlier version
+ * of this file assumed. It is a versioned interface that the ROM
+ * validates before it will accept it, and an empty table is rejected.
+ * esp_coex_adapter_register() in libcoexist.a's coexist_api.o is the
+ * validator, and it reads three fields:
+ *
+ *   l32i.n a12, a2, 0      -> _version   must be 2  (COEX_ADAPTER_VERSION)
+ *   beqi   a12, 2, ...
+ *   l32i   a12, a2, 68     -> _magic     must be 0xDEADBEAF
+ *   bne    a12, a11, ...
+ *   s32i.n a2, a9, 0       -> g_coa_funcs_p = funcs   (only if both pass)
+ *
+ * Failing either check logs "coexist adapter function version error!
+ * Version 2 is expected, but it is 0" and returns 0x102 without storing
+ * anything. The board then printed exactly that, and the next call --
+ * coex_pre_init -> coex_core_pre_init, which reads g_coa_funcs_p->[8] and
+ * calls it -- faulted at excvaddr 00000008.
+ *
+ * g_coa_funcs_p is a ROM slot, not a variable here: vmlinux.lds.S binds it
+ * to 0x3fcef824, and coexist_param.o's coex_rom_data_init() is what hands
+ * the ROM the rest of the pointers. That is why the validator has to pass
+ * for anything downstream to work at all.
+ *
+ * The entries are this port's OS primitives, all of them already defined
+ * above for the blob's own struct wifi_osi_funcs. The offsets the ROM
+ * reads are the ones that matter, and they are checked against the
+ * disassembly: [8] is _semphr_create (coex_core_pre_init calls it with 1
+ * to make the coex semaphore), [36] is _malloc_internal
+ * (coex_rom_osi_funcs_init calls it with 48), [44] is _esp_timer_get_time
+ * (called on that malloc's failure path to timestamp the error), and [68]
+ * is _magic.
+ *
+ * _is_in_isr has no equivalent here and answers "no", which is true --
+ * this port runs the blob from process context. _env_is_chip is the
+ * osi_env_is_chip() defined above for the blob's own table, and it answers
+ * "yes": the question it answers is whether this is a real chip rather
+ * than a host-side simulation, and it is.
+ */
+struct coex_adapter_funcs {
+	int32_t _version;
+	void (*_task_yield_from_isr)(void);
+	void *(*_semphr_create)(uint32_t max, uint32_t init);
+	void (*_semphr_delete)(void *semphr);
+	int32_t (*_semphr_take_from_isr)(void *semphr, void *hptw);
+	int32_t (*_semphr_give_from_isr)(void *semphr, void *hptw);
+	int32_t (*_semphr_take)(void *semphr, uint32_t block_time_tick);
+	int32_t (*_semphr_give)(void *semphr);
+	int (*_is_in_isr)(void);
+	void *(*_malloc_internal)(size_t size);
+	void (*_free)(void *p);
+	int64_t (*_esp_timer_get_time)(void);
+	bool (*_env_is_chip)(void);
+	void (*_timer_disarm)(void *timer);
+	void (*_timer_done)(void *ptimer);
+	void (*_timer_setfn)(void *ptimer, void *pfunction, void *parg);
+	void (*_timer_arm_us)(void *ptimer, uint32_t us, bool repeat);
+	int32_t _magic;
+};
+
+/*
+ * The from-ISR pair.
+ *
+ * IDF's own pair is xSemaphoreTakeFromISR / xSemaphoreGiveFromISR, which
+ * touch the semaphore's counter and nothing else -- no wait queue, no
+ * scheduler. Linux's equivalents are down_trylock() and up(), and
+ * include/linux/semaphore.h says so outright:
+ *
+ *   "It is also safe to call down_trylock() and up() from interrupt
+ *    context."
+ *
+ * and kernel/locking/semaphore.c keeps that promise by construction:
+ * down_trylock() is a raw_spin_lock_irqsave around a single decrement of
+ * sem->count. There is no rt_mutex, no waiter, no schedule().
+ *
+ * So these are the same two calls osi_semphr_take(semphr, 0) and
+ * osi_semphr_give() already make, written out rather than delegated, so
+ * that the from-ISR pair is visibly the non-blocking one.
+ *
+ * BOTH MUST WRITE *hptw, and that is not optional. IDF's pair is
+ * xSemaphoreTakeFromISR / xSemaphoreGiveFromISR, whose second argument
+ * is pxHigherPriorityTaskWoken: "will set *pxHigherPriorityTaskWoken to
+ * pdTRUE if giving the semaphore caused a task to unblock, and the
+ * unblocked task has a priority higher than the currently running task"
+ * (semphr.h:604-608). The caller passes a stack slot and reads it back.
+ *
+ * coexist_core_lock and coex_core_unlock do exactly that -- they pass
+ * `mov.n a11, a1` (a stack slot) and then `l32i.n a4, a1, 0; beqz.n a4`
+ * before calling _task_yield_from_isr (offset 4). An earlier version of
+ * these two ignored hptw, so the slot held whatever the stack happened
+ * to contain and the blob took a yield branch on a garbage flag.
+ *
+ * The value written is always pdFALSE. That flag asks "should the ISR
+ * request a context switch before returning", and this port never runs
+ * the blob from an ISR: _is_in_isr above answers no, and the ISR path
+ * is a threaded IRQ (osi_isr_thunk) in process context. So no unblock
+ * can ever require a yield here, and pdFALSE is the true answer rather
+ * than a placeholder. If that ever changes, this becomes a real
+ * wakeup-pending test in the same change.
+ */
+static int32_t osi_semphr_take_from_isr(void *semphr, void *hptw)
+{
+	struct osi_sem *s = semphr;
+
+	if (hptw)
+		*(int32_t *)hptw = OSI_PD_FALSE;
+	if (!s)
+		return OSI_PD_FALSE;
+	return down_trylock(&s->sem) ? OSI_PD_FALSE : OSI_PD_TRUE;
+}
+
+static int32_t osi_semphr_give_from_isr(void *semphr, void *hptw)
+{
+	struct osi_sem *s = semphr;
+
+	if (hptw)
+		*(int32_t *)hptw = OSI_PD_FALSE;
+	if (!s)
+		return OSI_PD_FALSE;
+	up(&s->sem);
+	return OSI_PD_TRUE;
+}
+
+/*
+ * IDF's esp_coex_is_in_isr_wrapper is `return !xPortCanYield();`.
+ *
+ * xPortCanYield() asks whether the current context may yield to the
+ * scheduler -- true in a task, false in an ISR. So the wrapper answers
+ * "am I in an ISR", and in a task it answers no.
+ *
+ * in_interrupt() is not that question. It is true whenever preempt_count
+ * carries a hardirq or softirq count, which on this kernel includes
+ * contexts that are not ISRs, and it is the flag coex branches on to
+ * choose between its ISR and task paths. Reporting true from probe sent
+ * coex down the ISR path -- which is how the board reached
+ * _semphr_take_from_isr at all, and then the sleeping lock above.
+ *
+ * Unlike _is_from_isr on the Wi-Fi side, this one IS load-bearing. The
+ * coexistence library calls it through offset 32 of coex_adapter_funcs
+ * and branches on the result: coex_core_lock in coexist_core.o does
+ * `l32i.n a10, a2, 32; callx8 a10; beqz.n a10, <task arm>`, taking
+ * _semphr_take_from_isr (offset 16) when it is non-zero and _semphr_take
+ * (offset 24) with a11 = -1 -- OSI_FUNCS_TIME_BLOCKING -- when it is
+ * zero. coex_core_unlock has the same shape at offsets 20 and 28.
+ *
+ * The blob is driven from process context only: probe, the rx callback,
+ * the threaded IRQ handler, and the timer workqueue. Nothing calls into
+ * it from a hardirq or a softirq. So the honest answer is no, and it is
+ * now a constant rather than a kernel query that happens to be true for
+ * unrelated reasons.
+ *
+ * This must stay in step with osi_isr_thunk() (threaded IRQ) and
+ * osi_timer_cb() (workqueue). If either is ever moved back to interrupt
+ * level, this has to become a real in_interrupt() test in the same
+ * change, or coex will take its blocking arm from a context that cannot
+ * block.
+ */
+static int osi_is_in_isr(void) { return 0; }
+
+static const struct coex_adapter_funcs g_coex_adapter_funcs = {
+	._version		= 2,		/* COEX_ADAPTER_VERSION */
+	._task_yield_from_isr	= osi_task_yield_from_isr,
+	._semphr_create		= osi_semphr_create,
+	._semphr_delete		= osi_semphr_delete,
+	._semphr_take_from_isr	= osi_semphr_take_from_isr,
+	._semphr_give_from_isr	= osi_semphr_give_from_isr,
+	._semphr_take		= osi_semphr_take,
+	._semphr_give		= osi_semphr_give,
+	._is_in_isr		= osi_is_in_isr,
+	._malloc_internal	= osi_malloc,
+	._free			= osi_free,
+	._esp_timer_get_time	= osi_esp_timer_get_time,
+	._env_is_chip		= osi_env_is_chip,
+	._timer_disarm		= osi_timer_disarm,
+	._timer_done		= osi_timer_done,
+	._timer_setfn		= osi_timer_setfn,
+	._timer_arm_us		= osi_timer_arm_us,
+	._magic			= 0xDEADBEAF,	/* COEX_ADAPTER_MAGIC */
+};
