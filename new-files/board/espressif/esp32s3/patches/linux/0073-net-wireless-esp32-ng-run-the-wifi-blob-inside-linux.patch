+/* ------------------------------------------------------------------ */
+/* NVS. The blob keeps calibration and configuration in NVS. The       */
+/* board's flash is read-only in this design, and the nvs partition is */
+/* not mounted by Linux, so NVS lives in RAM: an in-memory key/value   */
+/* store with the same API. It does not survive a reboot, and for the  */
+/* first bring-up that is the point -- nothing is written to flash.    */
+/* ------------------------------------------------------------------ */
+
+#define OSI_NVS_MAX_ENTRIES	64
+#define OSI_NVS_MAX_KEY		16
+#define OSI_NVS_MAX_BLOB	256
+
+struct osi_nvs_entry {
+	bool used;
+	char name[OSI_NVS_MAX_KEY];
+	char key[OSI_NVS_MAX_KEY];
+	u8 *data;
+	size_t len;
+};
+
+struct osi_nvs_handle {
+	struct osi_nvs_entry *entries;
+	int n;
+};
+
+static LIST_HEAD(osi_nvs_stores);
+static DEFINE_MUTEX(osi_nvs_lock);
+
+static struct osi_nvs_entry *osi_nvs_find(struct osi_nvs_handle *h,
+					  const char *key)
+{
+	int i;
+
+	for (i = 0; i < h->n; i++)
+		if (h->entries[i].used &&
+		    !strncmp(h->entries[i].key, key, OSI_NVS_MAX_KEY))
+			return &h->entries[i];
+	return NULL;
+}
+
+static int osi_nvs_open(const char *name, unsigned int mode, uint32_t *out)
+{
+	struct osi_nvs_handle *h;
+
+	h = kzalloc(sizeof(*h), GFP_KERNEL);
+	if (!h)
+		return -1;
+	h->entries = kcalloc(OSI_NVS_MAX_ENTRIES, sizeof(*h->entries), GFP_KERNEL);
+	if (!h->entries) {
+		kfree(h);
+		return -1;
+	}
+	h->n = OSI_NVS_MAX_ENTRIES;
+	(void)name;
+	(void)mode;
+	*out = (uint32_t)(uintptr_t)h;
+	osi_note("nvs_open (RAM-backed)");
+	return 0;
+}
+
+static void osi_nvs_close(uint32_t handle)
+{
+	struct osi_nvs_handle *h = (void *)(uintptr_t)handle;
+	int i;
+
+	if (!h)
+		return;
+	for (i = 0; i < h->n; i++)
+		kfree(h->entries[i].data);
+	kfree(h->entries);
+	kfree(h);
+}
+
+static int osi_nvs_set_blob(uint32_t handle, const char *key,
+			    const void *value, size_t length)
+{
+	struct osi_nvs_handle *h = (void *)(uintptr_t)handle;
+	struct osi_nvs_entry *e;
+
+	if (!h || length > OSI_NVS_MAX_BLOB)
+		return -1;
+	mutex_lock(&osi_nvs_lock);
+	e = osi_nvs_find(h, key);
+	if (!e) {
+		int i;
+
+		for (i = 0; i < h->n; i++)
+			if (!h->entries[i].used) {
+				e = &h->entries[i];
+				break;
+			}
+		if (!e) {
+			mutex_unlock(&osi_nvs_lock);
+			return -1;
+		}
+		e->used = true;
+		strscpy(e->key, key, sizeof(e->key));
+	}
+	kfree(e->data);
+	e->data = kmemdup(value, length, GFP_KERNEL);
+	if (!e->data) {
+		e->used = false;
+		mutex_unlock(&osi_nvs_lock);
+		return -1;
+	}
+	e->len = length;
+	mutex_unlock(&osi_nvs_lock);
+	return 0;
+}
+
+static int osi_nvs_get_blob(uint32_t handle, const char *key,
+			    void *out, size_t *length)
+{
+	struct osi_nvs_handle *h = (void *)(uintptr_t)handle;
+	struct osi_nvs_entry *e;
+	int ret = -1;
+
+	if (!h || !length)
+		return -1;
+	mutex_lock(&osi_nvs_lock);
+	e = osi_nvs_find(h, key);
+	if (e && e->data) {
+		if (*length >= e->len) {
+			memcpy(out, e->data, e->len);
+			*length = e->len;
+			ret = 0;
+		}
+	}
+	mutex_unlock(&osi_nvs_lock);
+	return ret;
+}
+
+static int osi_nvs_erase_key(uint32_t handle, const char *key)
+{
+	struct osi_nvs_handle *h = (void *)(uintptr_t)handle;
+	struct osi_nvs_entry *e;
+
+	if (!h)
+		return -1;
+	mutex_lock(&osi_nvs_lock);
+	e = osi_nvs_find(h, key);
+	if (e) {
+		kfree(e->data);
+		e->data = NULL;
+		e->len = 0;
+		e->used = false;
+	}
+	mutex_unlock(&osi_nvs_lock);
+	return 0;
+}
+
+static int osi_nvs_commit(uint32_t handle)
+{
+	/* RAM-backed: nothing to flush. */
+	return 0;
+}
+
+/* The typed NVS calls the blob uses are blob-of-one-value wrappers. */
+static int osi_nvs_set_i8(uint32_t h, const char *k, int8_t v)
+{
+	return osi_nvs_set_blob(h, k, &v, sizeof(v));
+}
+
+static int osi_nvs_get_i8(uint32_t h, const char *k, int8_t *v)
+{
+	size_t n = sizeof(*v);
+
+	return osi_nvs_get_blob(h, k, v, &n);
+}
+
+static int osi_nvs_set_u8(uint32_t h, const char *k, uint8_t v)
+{
+	return osi_nvs_set_blob(h, k, &v, sizeof(v));
+}
+
+static int osi_nvs_get_u8(uint32_t h, const char *k, uint8_t *v)
+{
+	size_t n = sizeof(*v);
+
+	return osi_nvs_get_blob(h, k, v, &n);
+}
+
+static int osi_nvs_set_u16(uint32_t h, const char *k, uint16_t v)
+{
+	return osi_nvs_set_blob(h, k, &v, sizeof(v));
+}
+
+static int osi_nvs_get_u16(uint32_t h, const char *k, uint16_t *v)
