 void phy_exit_critical(uint32_t level)
 {
+	unsigned int cpu = raw_smp_processor_id();
+
+	if (--phy_critical_depth[cpu] == 0) {
+		WRITE_ONCE(phy_critical_owner, -1);
+		raw_spin_unlock(&phy_critical_lock);
+	}
 	local_irq_restore((unsigned long)level);
+	preempt_enable();
 }
 
