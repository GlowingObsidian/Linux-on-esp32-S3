diff --git a/arch/xtensa/kernel/esp32-atomic.c b/arch/xtensa/kernel/esp32-atomic.c
new file mode 100644
--- /dev/null
+++ b/arch/xtensa/kernel/esp32-atomic.c
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0
+/* S32C1I cannot serialize external PSRAM accesses. Keep its sole guard in
+ * the data-bus alias of the firmware-reserved vector SRAM, and serialize
+ * software read/modify/write operations with local IRQs masked.
+ * Do not use Linux atomics/spinlocks here: they call this implementation.
+ */
+#include <linux/compiler.h>
+#include <asm/irqflags.h>
+#include <asm/esp32-atomic.h>
+
+static u32 esp32_atomic_guard __section(".esp32.atomic.lock") = 0;
+
+unsigned long notrace esp32_atomic_update(volatile void *ptr, unsigned long arg,
+ unsigned long compare, enum esp32_atomic_op op, unsigned int size)
+{
+ unsigned long flags;
+ u32 previous, desired, old, next;
+ flags = arch_local_irq_save();
+ do {
+  previous = 0;
+  desired = 1;
+  asm volatile("wsr %2, scompare1\n\ts32c1i %0, %1\n"
+   : "+a"(desired), "+m"(esp32_atomic_guard) : "a"(previous) : "memory");
+ } while (desired != 0);
+ asm volatile("memw" ::: "memory");
+ if (size == 1) old = *(volatile u8 *)ptr;
+ else if (size == 2) old = *(volatile u16 *)ptr;
+ else old = *(volatile u32 *)ptr;
+ next = old;
+ switch (op) {
+ case ESP32_ATOMIC_xchg: next = arg; break;
+ case ESP32_ATOMIC_cmpxchg: if (old == compare) next = arg; break;
+ case ESP32_ATOMIC_add: next = old + arg; break;
+ case ESP32_ATOMIC_sub: next = old - arg; break;
+ case ESP32_ATOMIC_and: next = old & arg; break;
+ case ESP32_ATOMIC_or: next = old | arg; break;
+ case ESP32_ATOMIC_xor: next = old ^ arg; break;
+ }
+ if (size == 1) *(volatile u8 *)ptr = next;
+ else if (size == 2) *(volatile u16 *)ptr = next;
+ else *(volatile u32 *)ptr = next;
+ asm volatile("memw" ::: "memory");
+ esp32_atomic_guard = 0;
+ asm volatile("memw" ::: "memory");
+ arch_local_irq_restore(flags);
+ return old;
+}
