diff --git a/arch/xtensa/include/asm/qrwlock.h b/arch/xtensa/include/asm/qrwlock.h
new file mode 100644
--- /dev/null
+++ b/arch/xtensa/include/asm/qrwlock.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _XTENSA_QRWLOCK_H
+#define _XTENSA_QRWLOCK_H
+#include <asm-generic/qrwlock.h>
+#ifdef CONFIG_XTENSA_SMP_ESP32
+/* Readers occupy low bits. A serialized writer sets the sign bit to
+ * exclude new readers, then waits for existing readers to drain. */
+static inline int esp32_read_trylock(struct qrwlock *lock)
+{
+ int old = atomic_read(&lock->cnts);
+ return old >= 0 && atomic_cmpxchg_acquire(&lock->cnts, old, old + 1) == old;
+}
+static inline void esp32_read_lock(struct qrwlock *lock)
+{
+ while (!esp32_read_trylock(lock)) cpu_relax();
+}
+static inline void esp32_read_unlock(struct qrwlock *lock)
+{
+ atomic_dec_return_release(&lock->cnts);
+}
+static inline int esp32_write_trylock(struct qrwlock *lock)
+{
+ if (!arch_spin_trylock(&lock->wait_lock)) return 0;
+ if (atomic_cmpxchg_acquire(&lock->cnts, 0, (int)0x80000000U) == 0) return 1;
+ arch_spin_unlock(&lock->wait_lock);
+ return 0;
+}
+static inline void esp32_write_lock(struct qrwlock *lock)
+{
+ arch_spin_lock(&lock->wait_lock);
+ atomic_or((int)0x80000000U, &lock->cnts);
+ while (atomic_read_acquire(&lock->cnts) != (int)0x80000000U) cpu_relax();
+}
+static inline void esp32_write_unlock(struct qrwlock *lock)
+{
+ atomic_set_release(&lock->cnts, 0);
+ arch_spin_unlock(&lock->wait_lock);
+}
+#undef arch_read_lock
+#undef arch_read_trylock
+#undef arch_read_unlock
+#undef arch_write_lock
+#undef arch_write_trylock
+#undef arch_write_unlock
+#define arch_read_lock(l) esp32_read_lock(l)
+#define arch_read_trylock(l) esp32_read_trylock(l)
+#define arch_read_unlock(l) esp32_read_unlock(l)
+#define arch_write_lock(l) esp32_write_lock(l)
+#define arch_write_trylock(l) esp32_write_trylock(l)
+#define arch_write_unlock(l) esp32_write_unlock(l)
+#endif
+#endif
diff --git a/arch/xtensa/include/asm/qspinlock.h b/arch/xtensa/include/asm/qspinlock.h
new file mode 100644
--- /dev/null
+++ b/arch/xtensa/include/asm/qspinlock.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _XTENSA_QSPINLOCK_H
+#define _XTENSA_QSPINLOCK_H
+#ifdef CONFIG_XTENSA_SMP_ESP32
+#include <linux/atomic.h>
+#include <asm-generic/qspinlock_types.h>
+/* Queued locks modify byte/halfword aliases alongside 32-bit atomics.
+ * Use a full-word lock so software PSRAM atomics cannot overwrite an
+ * independently modified queue field. Keep the standard four-byte ABI.
+ */
+#define queued_spin_lock queued_spin_lock
+static __always_inline void queued_spin_lock(struct qspinlock *lock)
+{
+ while (atomic_cmpxchg_acquire(&lock->val, 0, _Q_LOCKED_VAL))
+  while (atomic_read(&lock->val))
+   cpu_relax();
+}
+#define queued_spin_unlock queued_spin_unlock
+static __always_inline void queued_spin_unlock(struct qspinlock *lock)
+{
+ atomic_set_release(&lock->val, 0);
+}
+#endif
+#include <asm-generic/qspinlock.h>
+#endif
