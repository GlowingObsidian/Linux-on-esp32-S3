+/* The upper half calls write with spin_lock_bh held for commands and
+ * from the network TX path for data. Vendor APIs submit ioctls and wait
+ * on the Wi-Fi task, even for a nonblocking scan. Keep write atomic and
+ * retain its transport ownership contract; only this worker calls them.
+ * Reuse the existing skb queue and system workqueue, not a new kthread.
+ */
+#define BLOB_TX_QUEUE_LIMIT 16
+
+static void blob_tx_work(struct work_struct *work)
+{
+	struct esp_wifi_blob *hw = container_of(work, struct esp_wifi_blob, tx_work);
+	struct sk_buff *skb;
+	int ret;
+
+	while ((skb = skb_dequeue(&hw->tx_q))) {
+		ret = blob_process_packet(&hw->adapter, skb);
+		if (ret)
+			pr_warn_ratelimited("radio TX/command failed: %d\n", ret);
+	}
+}
+
+static int blob_write_packet(struct esp_adapter *adapter, struct sk_buff *skb)
+{
+	struct esp_wifi_blob *hw = READ_ONCE(g_blob);
+	struct esp_payload_header *header;
+	unsigned long flags;
+	u16 offset, len;
+	int ret = 0;
+
+	if (!skb)
+		return -EINVAL;
+	if (!hw || adapter != &hw->adapter) {
+		ret = -ENODEV;
+		goto drop;
+	}
+	if (skb->len < sizeof(*header) || skb->len > 4096) {
+		ret = -EINVAL;
+		goto drop;
+	}
+	header = (void *)skb->data;
+	offset = le16_to_cpu(header->offset);
+	len = le16_to_cpu(header->len);
+	if (offset < sizeof(*header) || offset > skb->len ||
+	    len > skb->len - offset ||
+	    (header->packet_type == PACKET_TYPE_COMMAND_REQUEST &&
+	     len < sizeof(struct command_header))) {
+		ret = -EINVAL;
+		goto drop;
+	}
+	spin_lock_irqsave(&hw->tx_q.lock, flags);
+	if (hw->tx_stopping)
+		ret = -ESHUTDOWN;
+	else if (skb_queue_len(&hw->tx_q) >= BLOB_TX_QUEUE_LIMIT)
+		ret = -ENOBUFS;
+	else {
+		__skb_queue_tail(&hw->tx_q, skb);
+		/* Queue under the same lock as shutdown so flush cannot miss
+		 * a packet accepted immediately before stopping was set.
+		 */
+		queue_work_on(0, system_long_wq, &hw->tx_work);
+	}
+	spin_unlock_irqrestore(&hw->tx_q.lock, flags);
+	if (!ret)
+		return 0;
+ drop:
+	dev_kfree_skb_any(skb);
+	return ret;
+}
+
+static void blob_tx_shutdown(void *data)
+{
+	struct esp_wifi_blob *hw = data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&hw->tx_q.lock, flags);
+	hw->tx_stopping = true;
+	spin_unlock_irqrestore(&hw->tx_q.lock, flags);
+	flush_work(&hw->tx_work);
+	skb_queue_purge(&hw->tx_q);
+}
