-#define HSD20_IPS 1
+/*
+ * The HSD20 IPS glass this driver was written for wants colour inversion,
+ * and so do most ST7789 modules, so this stays the default. It is a
+ * variable rather than the original `#define HSD20_IPS 1` only so that
+ * the invert knob can turn it off without a rebuild -- an inverted panel
+ * is otherwise indistinguishable from a broken one.
+ */
+static bool hsd20_ips = true;
 
+/*
+ * The invert knob. init_display() sends MIPI_DCS_ENTER_INVERT_MODE when
+ * hsd20_ips is set, which is right for the HSD20 IPS glass the driver was
+ * written for and for most ST7789 modules -- but it is a one-line flip if
+ * this module disagrees, and an inverted panel is otherwise
+ * indistinguishable from a broken one. The next init_display() honours it.
+ *
+ * It is registered here rather than in fbtft-sysfs.c because hsd20_ips is
+ * this file's own variable: a generic hook would have to take its address
+ * in a static initialiser, and GCC folds that to a constant and warns
+ * under -Waddress, which this tree builds with -Werror.
+ */
+static ssize_t show_invert(struct device *device,
+			   struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", hsd20_ips ? 1 : 0);
+}
+
+static ssize_t store_invert(struct device *device,
+			    struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	hsd20_ips = val ? true : false;
+	return count;
+}
+
+static struct device_attribute invert_device_attr =
+	__ATTR(invert, 0660, show_invert, store_invert);
+
+static void st7789v_sysfs_init(struct device *dev)
+{
+	device_create_file(dev, &invert_device_attr);
+}
+
+static void st7789v_sysfs_exit(struct device *dev)
+{
+	device_remove_file(dev, &invert_device_attr);
+}
