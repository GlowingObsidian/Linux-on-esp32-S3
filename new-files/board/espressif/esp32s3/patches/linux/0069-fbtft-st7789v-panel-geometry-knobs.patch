+/*
+ * The geometry knobs. These exist because the panel's own wiring decides
+ * which 240 rows of the controller's 320 are on the glass, and nothing can
+ * read that out of the module -- it has to be tried. Writing one of these
+ * and redrawing is the whole experiment.
+ *
+ * A write schedules a full redraw so the effect is visible immediately at
+ * the console, rather than at the next thing that happens to dirty a line.
+ */
+static void fbtft_redraw(struct fbtft_par *par)
+{
+	par->fbtftops.mkdirty(par->info, 0, par->info->var.yres);
+}
+
+static ssize_t show_row_offset(struct device *device,
+			       struct device_attribute *attr, char *buf)
+{
+	struct fb_info *fb_info = dev_get_drvdata(device);
+	struct fbtft_par *par = fb_info->par;
+
+	return sysfs_emit(buf, "%u\n", par->row_offset);
+}
+
+static ssize_t store_row_offset(struct device *device,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct fb_info *fb_info = dev_get_drvdata(device);
+	struct fbtft_par *par = fb_info->par;
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	par->row_offset = val;
+	fbtft_redraw(par);
+	return count;
+}
+
+static struct device_attribute row_offset_device_attr =
+	__ATTR(row_offset, 0660, show_row_offset, store_row_offset);
+
+static ssize_t show_col_offset(struct device *device,
+			       struct device_attribute *attr, char *buf)
+{
+	struct fb_info *fb_info = dev_get_drvdata(device);
+	struct fbtft_par *par = fb_info->par;
+
+	return sysfs_emit(buf, "%u\n", par->col_offset);
+}
+
+static ssize_t store_col_offset(struct device *device,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct fb_info *fb_info = dev_get_drvdata(device);
+	struct fbtft_par *par = fb_info->par;
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	par->col_offset = val;
+	fbtft_redraw(par);
+	return count;
+}
+
+static struct device_attribute col_offset_device_attr =
+	__ATTR(col_offset, 0660, show_col_offset, store_col_offset);
+
+static ssize_t show_madctl(struct device *device,
+			   struct device_attribute *attr, char *buf)
+{
+	struct fb_info *fb_info = dev_get_drvdata(device);
+	struct fbtft_par *par = fb_info->par;
+
+	return sysfs_emit(buf, "%u\n", par->madctl_forced ? par->madctl : 0);
+}
+
+static ssize_t store_madctl(struct device *device,
+			    struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	struct fb_info *fb_info = dev_get_drvdata(device);
+	struct fbtft_par *par = fb_info->par;
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val > 0xff)
+		return -EINVAL;
+
+	par->madctl = val;
+	par->madctl_forced = true;
+	par->fbtftops.set_var(par);
+	return count;
+}
+
+static struct device_attribute madctl_device_attr =
+	__ATTR(madctl, 0660, show_madctl, store_madctl);
+
 static struct device_attribute debug_device_attr =
 	__ATTR(debug, 0660, show_debug, store_debug);
 
