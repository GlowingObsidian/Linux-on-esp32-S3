+/*
+ * set_addr_win() - the address window, shifted by the module's own offset
+ *
+ * The controller's GRAM is 240x320 and this module shows 240x240 of it.
+ * fbtft's own fbtft_set_addr_win() always starts the window at column 0,
+ * row 0, so a bottom-aligned module (visible rows 80..319) shows the top
+ * 80 rows of the frame off the glass and 80 rows of nothing at the
+ * bottom. Adding the offset here is the whole fix.
+ *
+ * The offset goes on at rotate 0 and 90 only, as in fb_ili9163.c: at 180
+ * and 270 the MADCTL bits flip the address counters, so the same physical
+ * rows are reached from the other end of the range and adding the offset
+ * again would put it on twice.
+ */
+static void set_addr_win(struct fbtft_par *par, int xs, int ys, int xe, int ye)
+{
+	switch (par->info->var.rotate) {
+	case 0:
+		ys += par->row_offset;
+		ye += par->row_offset;
+		break;
+	case 90:
+		xs += par->col_offset;
+		xe += par->col_offset;
+		break;
+	}
+
+	write_reg(par, MIPI_DCS_SET_COLUMN_ADDRESS,
+		  (xs >> 8) & 0xFF, xs & 0xFF, (xe >> 8) & 0xFF, xe & 0xFF);
+
+	write_reg(par, MIPI_DCS_SET_PAGE_ADDRESS,
+		  (ys >> 8) & 0xFF, ys & 0xFF, (ye >> 8) & 0xFF, ye & 0xFF);
+
+	write_reg(par, MIPI_DCS_WRITE_MEMORY_START);
 }
 
