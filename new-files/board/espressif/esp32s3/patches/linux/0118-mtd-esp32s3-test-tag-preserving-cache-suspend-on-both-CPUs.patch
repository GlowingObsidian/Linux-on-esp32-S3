+    and a7, a7, a8
+    FG_WRITE a7, \auto
+    FG_POLL \auto, 3, 1, 1, .Lfatal
+    FG_POLL \preload, 1, 1, 1, .Lfatal
+    FG_READ a7, \auto
+    movi a8, -513
+    and a7, a7, a8
+    FG_WRITE a7, \auto
+    l32i a7, a2, \saved
+    FG_WRITE a7, \ctrl
+    l32i a7, a2, (\saved + 4)
+    FG_WRITE a7, \bus
+    l32i a7, a2, (\saved + 8)
+    FG_WRITE a7, \auto
+    .endm
+    .macro FG_COMPARE saved, after, mask
+    l32i a7, a2, \saved
+    l32i a8, a2, \after
+    xor a7, a7, a8
+    movi a8, \mask
+    and a7, a7, a8
+    bnez a7, .Lfatal
+    .endm
+    .macro FG_ERRORS dest
+    FG_READ a7, 0xe4
+    s32i a7, a2, \dest
+    FG_READ a7, 0xf0
+    s32i a7, a2, (\dest + 4)
+    FG_READ a7, 0xfc
+    s32i a7, a2, (\dest + 8)
+    .endm
