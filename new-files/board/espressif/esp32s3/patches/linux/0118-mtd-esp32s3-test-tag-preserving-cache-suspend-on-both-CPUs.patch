+    FG_READ a7, \bus
+    s32i a7, a2, (\dest + 4)
+    FG_READ a7, \auto
+    s32i a7, a2, (\dest + 8)
+    FG_READ a7, \freeze
+    s32i a7, a2, (\dest + 12)
