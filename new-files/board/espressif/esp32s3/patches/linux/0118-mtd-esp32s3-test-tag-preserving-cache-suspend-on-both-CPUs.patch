+esp32_flash_cache_template_start:
+    entry a1, 32
+    mov a8, a1
+    mov a1, a3
+    addi a1, a1, -32
+    s32i a8, a1, 0
+    s32i a0, a1, 4
+    s32i a5, a1, 8
+    movi a6, 0
+    s32i a6, a1, 12
+    slli a9, a4, 2
+    add a14, a2, a9
+    s32i a1, a14, FGC_SP
+    call0 .Linternal_pc
+    .balign 4
+.Linternal_pc:
+    mov a7, a0
