+    FG_POLL 0x130, 0, 12, 1, .Lfatal
+    FG_POLL 0x130, 12, 12, 1, .Lfatal
+    FG_SNAPSHOT FGC_AFTER, 0x60, 0x64, 0xa0, 0x154
+    FG_SNAPSHOT (FGC_AFTER + 16), 0, 4, 0x4c, 0x150
