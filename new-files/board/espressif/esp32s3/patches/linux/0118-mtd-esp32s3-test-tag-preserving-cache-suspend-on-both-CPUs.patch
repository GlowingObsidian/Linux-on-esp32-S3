+    movi a8, 3
+    bne a7, a8, .Lpeer_timeout
+    movi a7, 1
+    s32i a7, a2, FGC_PEER_OFF
+    memw
+.Lpeer_timeout:
+    rsr a11, ccount
+    sub a11, a11, a12
+    bltu a11, a5, .Lpeer
+    movi a7, 1
+    s32i a7, a2, FGC_ABORT
+    memw
+    j .Lpeer
+.Lfinish:
