Subject: [PATCH] esp32: add opt-in packet-stage timing diagnostics

--- a/drivers/net/wireless/espressif/esp32-ng/esp_blob.c
+++ b/drivers/net/wireless/espressif/esp32-ng/esp_blob.c
@@ -684,6 +684,100 @@
 };
 module_param_cb(stats, &wifi_stats_ops, NULL, 0444);
 
+/* Opt-in packet-stage measurements. Snapshot under one IRQ-safe lock so
+ * 64-bit totals remain coherent on this 32-bit SMP target. No per-packet log.
+ */
+enum wifi_time_kind {
+	WIFI_TIME_TX_QUEUE, WIFI_TIME_TX_API, WIFI_TIME_TX_RETRY,
+	WIFI_TIME_RX_COPY, WIFI_TIME_COUNT
+};
+struct wifi_time_sample {
+	u64 count, total_us, max_us, ge_1ms, ge_10ms, ge_100ms;
+};
+static bool wifi_timing_enabled;
+static DEFINE_SPINLOCK(wifi_time_lock);
+static struct wifi_time_sample wifi_times[WIFI_TIME_COUNT];
+module_param_named(timing_enabled, wifi_timing_enabled, bool, 0644);
+
+static u64 wifi_time_start(void)
+{
+	return READ_ONCE(wifi_timing_enabled) ? ktime_get_ns() : 0;
+}
+
+static void wifi_time_record(enum wifi_time_kind kind, u64 start)
+{
+	struct wifi_time_sample *sample;
+	unsigned long flags;
+	u64 us;
+
+	if (!start)
+		return;
+	us = div_u64(ktime_get_ns() - start, 1000);
+	spin_lock_irqsave(&wifi_time_lock, flags);
+	sample = &wifi_times[kind];
+	sample->count++;
+	sample->total_us += us;
+	if (us > sample->max_us)
+		sample->max_us = us;
+	sample->ge_1ms += us >= 1000;
+	sample->ge_10ms += us >= 10000;
+	sample->ge_100ms += us >= 100000;
+	spin_unlock_irqrestore(&wifi_time_lock, flags);
+}
+
+/* Transport owns cb after successful admission. Preserve esp_skb_cb at its
+ * beginning; only the last eight bytes carry the optional queue timestamp.
+ * memcpy avoids imposing a new 64-bit alignment requirement on cb.
+ */
+static void wifi_time_enqueue(struct sk_buff *skb)
+{
+	u64 start = wifi_time_start();
+
+	BUILD_BUG_ON(sizeof(struct esp_skb_cb) + sizeof(start) > sizeof(skb->cb));
+	memcpy(skb->cb + sizeof(skb->cb) - sizeof(start), &start, sizeof(start));
+}
+
+static void wifi_time_dequeue(struct sk_buff *skb)
+{
+	u64 start;
+
+	memcpy(&start, skb->cb + sizeof(skb->cb) - sizeof(start), sizeof(start));
+	wifi_time_record(WIFI_TIME_TX_QUEUE, start);
+}
+
+static int wifi_timing_get(char *buffer, const struct kernel_param *kp)
+{
+	static const char * const names[] = {
+		"tx_queue", "tx_api", "tx_retry_wait", "rx_copy"
+	};
+	struct wifi_time_sample samples[WIFI_TIME_COUNT];
+	unsigned long flags;
+	int i, len;
+
+	(void)kp;
+	spin_lock_irqsave(&wifi_time_lock, flags);
+	memcpy(samples, wifi_times, sizeof(samples));
+	spin_unlock_irqrestore(&wifi_time_lock, flags);
+	len = scnprintf(buffer, PAGE_SIZE, "enabled=%u jiffy_us=%u\n",
+		READ_ONCE(wifi_timing_enabled), (unsigned int)(USEC_PER_SEC / HZ));
+	for (i = 0; i < WIFI_TIME_COUNT; i++) {
+		struct wifi_time_sample *v = &samples[i];
+
+		len += scnprintf(buffer + len, PAGE_SIZE - len,
+			"%s count=%llu total_us=%llu max_us=%llu ge_1ms=%llu ge_10ms=%llu ge_100ms=%llu\n",
+			names[i], (unsigned long long)v->count,
+			(unsigned long long)v->total_us, (unsigned long long)v->max_us,
+			(unsigned long long)v->ge_1ms, (unsigned long long)v->ge_10ms,
+			(unsigned long long)v->ge_100ms);
+	}
+	return len;
+}
+static const struct kernel_param_ops wifi_timing_ops = {
+	.get = wifi_timing_get,
+};
+module_param_cb(timing, &wifi_timing_ops, NULL, 0444);
+
+
