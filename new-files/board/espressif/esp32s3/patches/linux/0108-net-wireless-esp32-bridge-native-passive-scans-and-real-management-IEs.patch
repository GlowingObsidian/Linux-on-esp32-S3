+/* Calling a synchronous blob API from its own event callback deadlocks.
+ * Release its AP summaries on workqueue context; real IEs already reached
+ * cfg80211 via the management callback, so the summaries need not persist.
+ */
+static void blob_scan_cleanup_work(struct work_struct *work)
+{
+	esp_wifi_clear_ap_list();
+}
+static DECLARE_WORK(blob_scan_cleanup, blob_scan_cleanup_work);
+
+static void blob_schedule_scan_cleanup(void)
+{
+	schedule_work(&blob_scan_cleanup);
+}
