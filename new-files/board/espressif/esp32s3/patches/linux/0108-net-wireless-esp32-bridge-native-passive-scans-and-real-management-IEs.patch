+static struct blob_wpa_funcs blob_sta_callbacks = {
+	.wpa_sta_init = blob_sta_callback_ready,
+	.wpa_sta_deinit = blob_sta_callback_ready,
+	.wpa_sta_connect = blob_sta_connect_not_ready,
+	.wpa_sta_connected_cb = blob_sta_connected_notice,
+	.wpa_sta_disconnected_cb = blob_sta_disconnected_notice,
+	.wpa_sta_in_4way_handshake = blob_sta_handshake,
+	.wpa_parse_wpa_ie = blob_parse_security_ie,
+	.wpa_sta_rx_mgmt = blob_scan_rx_mgmt,
+	.wpa_config_done = blob_sta_config_done,
+};
