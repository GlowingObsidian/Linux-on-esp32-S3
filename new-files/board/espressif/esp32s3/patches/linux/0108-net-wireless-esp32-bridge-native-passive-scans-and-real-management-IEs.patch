+static bool blob_handle_command(struct esp_wifi_blob *hw,
+				const struct command_header *command, u16 len)
+{
+	const struct scan_request *request = (const void *)command;
+	blob_wifi_scan_config_t config = {0};
+	u8 ssid[33];
+	int ret;
+
+	if (blob_maybe_answer_cmd(hw, command->cmd_code))
+		return true;
+	if (command->cmd_code != CMD_SCAN_REQUEST)
+		return false;
+	if (len < sizeof(*request))
+		ret = -EINVAL;
+	else {
+		memcpy(ssid, request->ssid, 32);
+		ssid[32] = 0;
+		config.ssid = ssid[0] ? ssid : NULL;
+		config.channel = request->channel;
+		config.show_hidden = true;
+		/* Passive scan preserves each AP's real management IEs without
+		 * transmitting probes on channels not yet configured by Linux.
+		 */
+		config.scan_type = 1;
+		config.scan_time.passive = 120;
+		ret = esp_wifi_register_mgmt_frame_internal(BIT(5) | BIT(8), 0);
+		if (!ret)
+			ret = esp_wifi_scan_start(&config, false);
+	}
+	if (ret)
+		pr_err("native scan start failed: %d\n", ret);
+	blob_post_cmd_resp(hw, command->cmd_code, NULL, 0,
+			   ret ? CMD_RESPONSE_FAIL : CMD_RESPONSE_SUCCESS);
+	return true;
+}
