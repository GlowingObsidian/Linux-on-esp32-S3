+/* Constants are the pinned supplicant defs.h bitfields, not public
+ * wifi_cipher_type_t enum values. Reject unknown suites explicitly.
+ */
+static int blob_cipher_selector(const u8 *p, bool rsn)
+{
+	static const u8 rsn_oui[3] = {0, 15, 172};
+	static const u8 wpa_oui[3] = {0, 80, 242};
+
+	if (memcmp(p, rsn ? rsn_oui : wpa_oui, 3))
+		return 0;
+	switch (p[3]) {
+	case 0: return BIT(0); /* NONE */
+	case 1: return BIT(7); /* WEP40 */
+	case 2: return BIT(1); /* TKIP */
+	case 4: return BIT(3); /* CCMP */
+	case 5: return BIT(8); /* WEP104 */
+	case 6: return BIT(5); /* AES-CMAC */
+	case 8: return BIT(11); /* GCMP */
+	case 9: return BIT(12); /* GCMP256 */
+	case 11: return BIT(13); /* BIP-GMAC128 */
+	case 12: return BIT(14); /* BIP-GMAC256 */
+	default: return 0;
+	}
+}
+
+static int blob_akm_selector(const u8 *p, bool rsn)
+{
+	static const u8 rsn_oui[3] = {0, 15, 172};
+	static const u8 wpa_oui[3] = {0, 80, 242};
+
+	if (memcmp(p, rsn ? rsn_oui : wpa_oui, 3))
+		return 0;
+	switch (p[3]) {
+	case 1: return BIT(0); /* 802.1X */
+	case 2: return BIT(1); /* PSK */
+	case 3: return rsn ? BIT(5) : 0;
+	case 4: return rsn ? BIT(6) : 0;
+	case 5: return rsn ? BIT(7) : 0;
+	case 6: return rsn ? BIT(8) : 0;
+	case 8: return rsn ? BIT(10) : 0;
+	case 9: return rsn ? BIT(11) : 0;
+	case 11: return rsn ? BIT(16) : 0;
+	case 12: return rsn ? BIT(17) : 0;
+	case 18: return rsn ? BIT(22) : 0;
+	default: return 0;
+	}
+}
+
+static int blob_parse_security_ie(const u8 *ie, size_t len, blob_wifi_wpa_ie_t *out)
+{
+	const u8 *p, *end;
+	u16 n;
+	bool rsn;
+
+	if (!ie || !out || len < 4 || (size_t)ie[1] + 2 != len)
+		return -EINVAL;
+	rsn = ie[0] == 48;
+	if (!rsn && (ie[0] != 221 || len < 8 || memcmp(ie + 2, "\x00\x50\xf2\x01", 4)))
+		return -EINVAL;
+	p = ie + (rsn ? 2 : 6);
+	end = ie + len;
+	if (end - p < 2 || get_unaligned_le16(p) != 1)
+		return -EINVAL;
+	p += 2;
+	memset(out, 0, sizeof(*out));
+	out->proto = rsn ? BIT(1) : BIT(0);
+	out->group_cipher = out->pairwise_cipher = rsn ? BIT(3) : BIT(1);
+	out->key_mgmt = BIT(0);
+	out->mgmt_group_cipher = rsn ? BIT(5) : 0;
+	if (p == end)
+		return 0;
+	if (end - p < 4 || !(out->group_cipher = blob_cipher_selector(p, rsn)))
+		return -EINVAL;
+	p += 4;
+	if (end - p < 2)
+		return -EINVAL;
+	n = get_unaligned_le16(p); p += 2;
+	if (!n || n > (end - p) / 4)
+		return -EINVAL;
+	out->pairwise_cipher = 0;
+	while (n--) { out->pairwise_cipher |= blob_cipher_selector(p, rsn); p += 4; }
+	if (!out->pairwise_cipher || end - p < 2)
+		return -EINVAL;
+	n = get_unaligned_le16(p); p += 2;
+	if (!n || n > (end - p) / 4)
+		return -EINVAL;
+	out->key_mgmt = 0;
+	while (n--) { out->key_mgmt |= blob_akm_selector(p, rsn); p += 4; }
+	if (!out->key_mgmt)
+		return -EINVAL;
+	if (p == end)
+		return 0;
+	if (end - p < 2)
+		return -EINVAL;
+	out->capabilities = get_unaligned_le16(p); p += 2;
+	if (p == end)
+		return 0;
+	if (!rsn || end - p < 2)
+		return -EINVAL;
+	n = get_unaligned_le16(p); p += 2;
+	if (n > (end - p) / 16)
+		return -EINVAL;
+	out->num_pmkid = n;
+	out->pmkid = p;
+	p += 16 * n;
+	if (p == end)
+		return 0;
+	if (end - p != 4 || !(out->mgmt_group_cipher = blob_cipher_selector(p, true)))
+		return -EINVAL;
+	return 0;
+}
+
+static int blob_scan_rx_mgmt(u8 type, u8 *frame, size_t len, u8 *sender,
+			     u32 rssi, u8 channel, u64 tsf)
+{
+	struct scan_event *event;
+	int ret;
+
+	if (type != 5 && type != 8)
+		return 0;
+	if (!sender || !frame || len < 12 || len > 2304 || channel < 1 || channel > 14)
+		return -EINVAL;
+	event = kzalloc(sizeof(*event) + len, GFP_ATOMIC);
+	if (!event)
+		return -ENOMEM;
+	event->header.event_code = EVENT_SCAN_RESULT;
+	event->header.status = 1;
+	event->header.len = cpu_to_le16(sizeof(*event) + len - sizeof(event->header));
+	memcpy(event->bssid, sender, 6);
+	event->frame_type = type;
+	event->channel = channel;
+	event->rssi = cpu_to_le32(rssi);
+	event->tsf = cpu_to_le64(tsf);
+	event->frame_len = cpu_to_le16(len);
+	memcpy(event->frame, frame, len);
+	ret = blob_post_event(g_blob, event, sizeof(*event) + len);
+	kfree(event);
+	return ret;
+}
